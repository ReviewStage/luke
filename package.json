{
  "name": "luke",
  "private": true,
  "description": "Luke is a macOS app for planning a feature by voice before you hand it to a coding agent",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "node scripts/check.mjs",
    "check:affected": "./scripts/check.sh --affected",
    "db:generate": "pnpm --filter @luke/database db:generate",
    "discarded-effect": "node scripts/discarded-effect.mjs",
    "format": "biome format --write .",
    "knip": "knip --no-config-hints",
    "lint": "biome check . && pnpm oxlint",
    "lint:fix": "biome check --write .",
    "oxlint": "./scripts/oxlint.sh",
    "package": "pnpm --filter @luke/desktop package",
    "package:dir": "pnpm --filter @luke/desktop package:dir",
    "prepare": "husky",
    "release:macos": "./scripts/release-macos.sh",
    "start": "pnpm --filter @luke/desktop start",
    "test": "node scripts/turbo.mjs run test:vitest test:vitest:1 test:vitest:2 --concurrency=1",
    "trace:export": "tsx tools/trace-export/src/cli.ts",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,json,md,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "effect": "catalog:",
    "husky": "9.1.7",
    "knip": "6.35.1",
    "lint-staged": "17.3.0",
    "oxlint": "1.79.0",
    "tsx": "catalog:",
    "turbo": "2.11.8",
    "typescript": "catalog:web",
    "vitest": "catalog:"
  }
}
