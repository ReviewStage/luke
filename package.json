{
  "name": "luke",
  "version": "0.0.0",
  "private": true,
  "description": "A notch-attached desktop sidecar for coding-agent sessions",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "evidence:record": "node scripts/record-evidence.mjs",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "package": "pnpm --filter @luke/desktop package",
    "prepare": "husky",
    "start": "pnpm --filter @luke/desktop start",
    "test": "pnpm test:harness && pnpm --recursive --if-present run test",
    "test:harness": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,json,md,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0"
  }
}
