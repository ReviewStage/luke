+ * Throwaway: the 0.8.0 changelog shots, never committed. Called from `App`
+ * with the Plans tab and the sidebar once the state has arrived, which is
+ * when the sidebar's fold becomes the fixture run's own. The plan menu a shot
+ * holds open is opened by the sidebar row itself (`desktop/plan-actions.tsx`).
+ */
+
+import { useEffect, useRef } from "react";
+import type { SidebarCollapse } from "../desktop/sidebar-collapse";
+import { DOCUMENT_REGION } from "../planning/planning-model";
+import type { PlansControl } from "../planning/use-plans-tab";
+import { currentShot } from "./shot-profiles";
+
+interface ShotStageContext {
+  readonly plans: PlansControl;
+  readonly sidebar: SidebarCollapse;
+}
+
+/** One staging step, run once, the first render it is ready on. */
+interface ShotStep {
+  readonly key: string;
+  readonly ready: (context: ShotStageContext) => boolean;
+  readonly run: (context: ShotStageContext) => void;
+}
+
+/** The steps the shot's layout asks for, in the order they run. */
+function layoutSteps(): ShotStep[] {
+  const layout = currentShot()?.layout ?? {};
+  const steps: ShotStep[] = [];
+  if (layout.boardRefit === true) {
+    steps.push({
+      key: "board-refit",
+      ready: () => true,
+      run: () => {
+        document.documentElement.dataset.shotBoardRefit = "true";
+      },
+    });
+  }
+  if (layout.sidebarCollapsed !== undefined) {
+    const collapsed = layout.sidebarCollapsed;
+    steps.push({
+      key: "sidebar",
+      ready: () => true,
+      run: ({ sidebar }) => {
+        if (sidebar.collapsed !== collapsed) sidebar.onToggle();
+      },
+    });
+  }
+  if (layout.sidePanelFullScreen === true) {
+    steps.push({
+      key: "full-screen",
+      ready: ({ plans }) => plans.region.kind === DOCUMENT_REGION.READY && plans.sidePanel.open,
+      run: ({ plans }) => {
+        if (!plans.sidePanel.fullScreen) plans.sidePanel.onToggleFullScreen();
+      },
+    });
+  }
+  return steps;
+}
+
+/** Stages the shot this run is for, if any; `known` once the state has arrived. */
+export function useShotStaging(context: ShotStageContext, known: boolean): void {
+  const done = useRef(new Set<string>());
+  const latest = useRef(context);
+  latest.current = context;
+  useEffect(() => {
+    if (!known || currentShot() === undefined) return;
+    for (const step of layoutSteps()) {
+      if (done.current.has(step.key) || !step.ready(latest.current)) continue;
+      done.current.add(step.key);
+      step.run(latest.current);
+    }
+  });
+}
