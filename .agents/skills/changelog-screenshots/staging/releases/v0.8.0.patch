+/**
+ * shot-spec.ts -- what one 0.8.0 changelog shot stages: the plans it draws, the side panel and call it opens on, and its layout.
+ *
+ * Throwaway: the 0.8.0 changelog screenshots' staging, applied on a Mac to
+ * the release commit and never committed. Types only, so every shot module
+ * and every hook into the app can import it without an evaluation-order cycle.
+ */
+
+import type { PlanningView } from "@sidecar/hosted/planning-view";
+import type { VoiceView } from "#shared/messages/voice-view";
+import type { SidePanelState } from "../planning/use-side-panel";
+
+/** The window's layout as the shot opens on it, each part staged once what it needs is drawn. */
+export interface ShotLayout {
+  /** Folds the sidebar away. */
+  readonly sidebarCollapsed?: boolean;
+  /** The side panel fills the window over the plan's document. */
+  readonly sidePanelFullScreen?: boolean;
+  /** The sidebar plan whose right-click menu stands open. */
+  readonly planMenuFor?: string;
+  /** Fits the board to the canvas again once the window has taken its capture size. */
+  readonly boardRefit?: boolean;
+}
+
+/** One shot: everything it draws in place of the fixture's, and how it is laid out. */
+export interface ShotSpec {
+  /** The plans the Plans tab draws, its open one included. */
+  readonly planning: PlanningView;
+  /** The side panel the open plan starts with; referentially stable, as the spec is built once. */
+  readonly sidePanel: SidePanelState;
+  /** The call standing on the open plan, as the voice window would report it; none where the shot is not about a call. */
+  readonly call?: Pick<VoiceView, "voiceStatus" | "callPlanId" | "callTranscript">;
+  readonly layout?: ShotLayout;
+}
