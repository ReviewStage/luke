+/**
+ * world.ts -- the 0.8.0 shots' shared world: acme's plans in their folders, the "Teammate invitations" plan as the notetaker has written it, and yesterday's call about it.
+ *
+ * Throwaway: the 0.8.0 changelog shots, never committed. 0.8.0 plans against
+ * a folder on this Mac rather than a GitHub repository, so each plan points
+ * at acme's checkout in `~/code`. Every time is counted back from launch
+ * (`clock.ts`), so nothing draws a 1969 date.
+ */
+
+import { EMPTY_PLAN_FIELDS, type PlanFields, planBody } from "@sidecar/hosted/plan-template";
+import type { Plan, PlanSummary } from "@sidecar/hosted/plan-wire";
+import { PLANNING_READ, type PlanningView } from "@sidecar/hosted/planning-view";
+import {
+  type PlanTranscript,
+  TRANSCRIPT_PART_TYPE,
+  type TranscriptMessage,
+} from "@sidecar/hosted/transcript-wire";
+import { TRANSCRIPT_SPEAKER } from "@sidecar/live";
+import { ago, daysAgo, hoursAgo, LAUNCHED_AT } from "./clock";
+
+/** The ids every shot agrees on. */
+export const SHOT_ID = {
+  PLAN: "0f6a2c4e-8b1d-4e3f-9a57-1c2b3d4e5f60",
+  WEBHOOKS: "1a7b3d5f-9c2e-4f40-8b68-2d3e4f5a6b71",
+  BILLING: "2b8c4e6a-0d3f-4a51-9c79-3e4f5a6b7c82",
+  ONBOARDING: "3c9d5f7b-1e4a-4b62-8d8a-4f5a6b7c8d93",
+  AUDIT: "4d0e6a8c-2f5b-4c73-9e9b-5a6b7c8d9ea4",
+  INVOICE: "5e1f7b9d-3a6c-4d84-8fac-6b7c8d9eafb5",
+  DARK_MODE: "6f2a8c0e-4b7d-4e95-9abd-7c8d9eafb0c6",
+  YESTERDAY_CALL: "7a3b9d1f-5c8e-4fa6-8bce-8d9eafb0c1d7",
+  TODAY_CALL: "8b4c0e2a-6d9f-4ab7-9cdf-9eafb0c1d2e8",
+} as const;
+
+/** acme's checkouts on Dean's Mac. */
+const FOLDER = {
+  RELAY: "/Users/dean/code/relay",
+  LEDGER: "/Users/dean/code/ledger",
+  WEB: "/Users/dean/code/web",
+} as const;
+
+/** The plans, newest edited first, as the sidebar lists them. */
+function planRows(): readonly (PlanSummary & { readonly folder: string })[] {
+  return [
+    {
+      id: SHOT_ID.PLAN,
+      name: "Teammate invitations",
+      createdAt: daysAgo(1),
+      updatedAt: ago(4),
+      folder: FOLDER.RELAY,
+    },
+    {
+      id: SHOT_ID.WEBHOOKS,
+      name: "Webhook retries",
+      createdAt: daysAgo(2),
+      updatedAt: ago(26),
+      folder: FOLDER.RELAY,
+    },
+    {
+      id: SHOT_ID.BILLING,
+      name: "Usage-based billing",
+      createdAt: daysAgo(4),
+      updatedAt: hoursAgo(3),
+      folder: FOLDER.LEDGER,
+    },
+    {
+      id: SHOT_ID.ONBOARDING,
+      name: "Onboarding checklist",
+      createdAt: daysAgo(3),
+      updatedAt: hoursAgo(20),
+      folder: FOLDER.WEB,
+    },
+    {
+      id: SHOT_ID.AUDIT,
+      name: "Audit log export",
+      createdAt: daysAgo(5),
+      updatedAt: daysAgo(2),
+      folder: FOLDER.RELAY,
+    },
+    {
+      id: SHOT_ID.INVOICE,
+      name: "Invoice PDF redesign",
+      createdAt: daysAgo(6),
+      updatedAt: daysAgo(3),
+      folder: FOLDER.LEDGER,
+    },
+    {
+      id: SHOT_ID.DARK_MODE,
+      name: "Dark mode for the dashboard",
+      createdAt: daysAgo(8),
+      updatedAt: daysAgo(4),
+      folder: FOLDER.WEB,
+    },
+  ];
+}
+
+/**
+ * The plan as the notetaker has it after today's call settled the link's
+ * life: the goal, three rules with their examples, the change map, and the
+ * decisions, with one question still open.
+ */
+const PLAN_FIELDS: PlanFields = {
+  ...EMPTY_PLAN_FIELDS,
+  goal: {
+    problem:
+      "Only an admin can add someone to a workspace, by creating their account by hand, so " +
+      "members wait days on an admin to bring a teammate in.",
+    outcome: "A member invites a teammate by email; the teammate joins by opening the link.",
+  },
+  scope: {
+    included: "Inviting by email, accepting the link, and withdrawing an invite.",
+    excluded: "Bulk invites and invite links shared without an email.",
+    constraints: null,
+  },
+  rules: [
+    {
+      statement: "Any member may invite by email.",
+      examples: [
+        {
+          given: "Jordan, a member, invites sam@acme.dev",
+          when: "Sam opens the link",
+          // biome-ignore lint/suspicious/noThenProperty: `then` is the example's key in the fixed template's contract.
+          then: "Sam joins the workspace as a member", // oxlint-disable-line unicorn/no-thenable
+        },
+      ],
+    },
+    {
+      statement: "An invite link lasts 14 days.",
+      examples: [
+        {
+          given: "An invite sent 15 days ago",
+          when: "Sam opens its link",
+          // biome-ignore lint/suspicious/noThenProperty: `then` is the example's key in the fixed template's contract.
+          then: 'the page reads "This invite is no longer valid"', // oxlint-disable-line unicorn/no-thenable
+        },
+      ],
+    },
+    {
+      statement: "The sender or any admin may withdraw an invite.",
+      examples: [
+        {
+          given: "Dana, an admin, withdraws Jordan's invite",
+          when: "Sam opens its link",
+          // biome-ignore lint/suspicious/noThenProperty: `then` is the example's key in the fixed template's contract.
+          then: 'the page reads "This invite is no longer valid"', // oxlint-disable-line unicorn/no-thenable
+        },
+      ],
+    },
+  ],
+  implementation: {
+    ...EMPTY_PLAN_FIELDS.implementation,
+    changeMap:
+      "- `src/db/schema/memberships.ts`: a `pending` state and an `expiresAt`.\n" +
+      "- `src/routes/invites.ts`: new, `POST /invites` and `GET /invites/:token`.\n" +
+      "- `src/members/access.ts`: count only `state = active` memberships.\n" +
+      "- `src/mail/templates/invite.tsx`: new, the invite email, sent through Postmark.",
+  },
+  decisions:
+    "Model an invite as a `memberships` row with `state = pending`. Why: removal covers " +
+    "invites and members alike. Rejected: a separate `invitations` table.",
+  openQuestions: ["Should an admin see invites a member sent before they are accepted?"],
+};
+
+/** The "Teammate invitations" plan, open. */
+export function shotPlan(): Plan {
+  return {
+    id: SHOT_ID.PLAN,
+    name: "Teammate invitations",
+    createdAt: daysAgo(1),
+    updatedAt: ago(4),
+    document: {
+      body: planBody({ name: "Teammate invitations" }, PLAN_FIELDS),
+      assumptions: [
+        { text: "Invites reuse memberships with a pending state." },
+        { text: "Postmark already sends relay's mail." },
+      ],
+    },
+  };
+}
+
+/** The plans and their folders, none open: the window's home. */
+export function shotPlanList(): PlanningView {
+  const rows = planRows();
+  return {
+    plans: rows.map(({ folder: _folder, ...plan }) => plan),
+    listStatus: PLANNING_READ.READY,
+    document: { status: PLANNING_READ.IDLE },
+    folders: Object.fromEntries(rows.map((row) => [row.id, row.folder])),
+  };
+}
+
+const { USER, ASSISTANT } = TRANSCRIPT_SPEAKER;
+
+/** Lines as the record answers them: each a message named by its place on its call. */
+function messages(
+  lines: readonly (readonly [typeof USER | typeof ASSISTANT, string])[],
+): TranscriptMessage[] {
+  return lines.map(([role, text], index) => ({
+    id: String(index),
+    role,
+    parts: [{ type: TRANSCRIPT_PART_TYPE.TEXT, text }],
+  }));
+}
+
+/** Yesterday at 4:20 PM, local time, whenever the capture runs: the call reads "Yesterday, 4:20 PM". */
+function yesterdayAfternoon(): number {
+  const day = new Date(LAUNCHED_AT);
+  day.setDate(day.getDate() - 1);
+  day.setHours(16, 20, 0, 0);
+  return day.getTime();
+}
+
+/** What was said on yesterday's call about the plan, as the record answers it. */
+export function yesterdayTranscript(): PlanTranscript {
+  return {
+    calls: [
+      {
+        id: SHOT_ID.YESTERDAY_CALL,
+        startedAt: yesterdayAfternoon(),
+        messages: messages([
+          [USER, "Any member should be able to invite a teammate by email, not just admins."],
+          [
+            ASSISTANT,
+            "So today an admin creates the account by hand? I'd make an invite a pending " +
+              "membership, so withdrawing one works like removing a member.",
+          ],
+          [USER, "Yes. And the link should expire. Seven days, maybe fourteen."],
+          [ASSISTANT, "Let's leave that open for now. I've written it down as a question."],
+        ]),
+      },
+    ],
+    earlierOmitted: false,
+  };
+}
+
+/** The plan open, with its transcript read and the plans listed beside it. */
+export function shotOpenPlan(extra: Partial<PlanningView> = {}): PlanningView {
+  return {
+    ...shotPlanList(),
+    activePlanId: SHOT_ID.PLAN,
+    document: { status: PLANNING_READ.READY, plan: shotPlan() },
+    transcript: { status: PLANNING_READ.READY, transcript: yesterdayTranscript() },
+    ...extra,
+  };
+}
