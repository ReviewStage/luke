+/**
+ * teammate.ts -- shot "Luke as a planning teammate": the side panel's Transcript tab, yesterday's call above today's live one, which Luke opens on what yesterday left open and where he reports a background worker's result at a pause.
+ *
+ * Throwaway: the 0.8.0 changelog shots, never committed. Yesterday's call is
+ * on record (`world.ts`); today's is the standing call as the voice window
+ * reports it, so the tab draws it live under "Today". The panel is at its
+ * widest beside the plan's document, which the notetaker is writing as the
+ * call goes. Captured at zoom 2 and cropped to the panel.
+ */
+
+import { LIVE_STATUS, TRANSCRIPT_SPEAKER } from "@sidecar/live";
+import { SIDE_PANEL_TAB, SIDE_PANEL_WIDTH } from "../planning/use-side-panel";
+import type { ShotSpec } from "./shot-spec";
+import { SHOT_ID, shotOpenPlan } from "./world";
+
+const { USER, ASSISTANT } = TRANSCRIPT_SPEAKER;
+
+/** Today's call so far, as the voice window reports it. */
+const TODAY: readonly (readonly [typeof USER | typeof ASSISTANT, string])[] = [
+  [
+    ASSISTANT,
+    "Last time we settled that an invite is a pending membership any member can send. " +
+      "Where did you land on expiry?",
+  ],
+  [USER, "Fourteen days. People go on holiday."],
+  [
+    ASSISTANT,
+    "Fourteen it is. I've asked a worker to check how relay decides who's a member while " +
+      "we talk. Who can withdraw an invite?",
+  ],
+  [USER, "Whoever sent it, or any admin."],
+  [
+    ASSISTANT,
+    "Got it, the sender or any admin. And the check came back: access counts every " +
+      "membership row, so a pending invite would already let someone in. I've added " +
+      "counting only active memberships to the plan.",
+  ],
+];
+
+export function teammateShot(): ShotSpec {
+  return {
+    planning: shotOpenPlan({ activity: { notes: true } }),
+    sidePanel: { open: true, tab: SIDE_PANEL_TAB.TRANSCRIPT, width: SIDE_PANEL_WIDTH.MAX },
+    call: {
+      voiceStatus: LIVE_STATUS.LISTENING,
+      callPlanId: SHOT_ID.PLAN,
+      callTranscript: {
+        voiceSessionId: SHOT_ID.TODAY_CALL,
+        lines: TODAY.map(([speaker, words], index) => ({
+          rowId: `today-${index}`,
+          speaker,
+          words,
+        })),
+      },
+    },
+  };
+}
