@@ -0,0 +1,61 @@
+/**
+ * subagents-shot.ts -- "Subagents": the whole window, the plan narrow at the left, and the side panel wide on the finished agent, whose transcript shows its two workers' rows with the model and effort each ran on, the first worker's own tab open beside it.
+ *
+ * Throwaway (`shot-spec.ts`). Whole window, `LUKE_SHOT_ZOOM=1`. The sidebar
+ * is folded and the panel staged 900 points wide on "Add teammate
+ * invitations", finished, its #214 open with checks passing. A finished
+ * turn folds everything ahead of its last words under one line, so the
+ * staging opens that line as a developer would; then it presses the first
+ * worker's "Open in tab", which opens "Find every place a membership is
+ * created" in a tab of its own (its glyph quiet, as the row said it
+ * finished), goes back to the agent's tab, and opens its lead again, since
+ * the tab drew afresh. The strip ends: the two agents, then the worker.
+ */
+
+import { SIDE_PANEL_TABS, isSubagentTab } from "../planning/use-side-panel";
+import { WORKER, codingAgentAnswers } from "./coding-agent";
+import { leadFold, openFold, openInTabButton } from "./dom";
+import { AGENT_TITLE, SHOT_ID, shotPlanningView } from "./plan-document";
+import type { ShotSpec } from "./shot-spec";
+
+/** The side panel's width, in points: wide, leaving the plan's column 700 beside it. */
+const PANEL_WIDTH = 900;
+
+export function subagentsShot(): ShotSpec {
+  return {
+    planning: shotPlanningView(),
+    sidePanel: {
+      open: true,
+      tabs: SIDE_PANEL_TABS,
+      tab: { agent: SHOT_ID.AGENT },
+      width: PANEL_WIDTH,
+    },
+    answers: codingAgentAnswers(),
+    layout: { sidebarCollapsed: true },
+    steps: [
+      {
+        key: "open-lead",
+        ready: () => leadFold(AGENT_TITLE) !== null,
+        run: () => openFold(leadFold(AGENT_TITLE)),
+      },
+      {
+        key: "open-worker",
+        ready: () => openInTabButton(AGENT_TITLE, WORKER.MEMBERSHIPS.callId) !== null,
+        run: () => openInTabButton(AGENT_TITLE, WORKER.MEMBERSHIPS.callId)?.click(),
+      },
+      {
+        key: "back-to-agent",
+        ready: ({ plans }) => {
+          const { tab } = plans.sidePanel;
+          return tab !== undefined && isSubagentTab(tab);
+        },
+        run: ({ plans }) => plans.sidePanel.onChoose({ agent: SHOT_ID.AGENT }),
+      },
+      {
+        key: "open-lead-again",
+        ready: () => leadFold(AGENT_TITLE) !== null,
+        run: () => openFold(leadFold(AGENT_TITLE)),
+      },
+    ],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/use-shot-staging.ts b/apps/desktop/src/renderer/shots/use-shot-staging.ts
new file mode 100644
index 000000000..0e8ae3976
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/use-shot-staging.ts
@@ -0,0 +1,61 @@
+/**
+ * use-shot-staging.ts -- the one fixture-only hook that lays a shot's window out: the sidebar fold, then the shot's own steps, each the first tick it can run.
+ *
+ * Throwaway (`shot-spec.ts`). Called from `App` with the Plans tab and the
+ * sidebar. Note that the steps are ticked on a timer as well as on every
+ * render of `App`, because most of what a shot waits on (an agent's
+ * transcript landing, a fold opening) is state inside the side panel that
+ * never redraws `App`. Each step runs once, in order: a step waits for the
+ * one before it, unless marked `again`, which runs whenever it is ready.
+ */
+
+import { useEffect, useRef } from "react";
+import { currentShot } from "./shot-profiles";
+import type { ShotSpec, ShotStageContext, ShotStep } from "./shot-spec";
+
+/** How often the steps are ticked while the window stands. */
+const TICK_MS = 150;
+
+/** The steps a shot's layout asks for, ahead of its own. */
+function layoutSteps(shot: ShotSpec): ShotStep[] {
+  const collapsed = shot.layout?.sidebarCollapsed;
+  if (collapsed === undefined) return [];
+  return [
+    {
+      key: "sidebar",
+      ready: () => true,
+      run: ({ sidebar }) => {
+        if (sidebar.collapsed !== collapsed) sidebar.onToggle();
+      },
+    },
+  ];
+}
+
+/** Stages the shot this run is for, if any; `known` once the state has arrived and the window is past its gate. */
+export function useShotStaging(context: ShotStageContext, known: boolean): void {
+  const done = useRef(new Set<string>());
+  const latest = useRef(context);
+  latest.current = context;
+  const tick = useRef<() => void>(() => undefined);
+  tick.current = () => {
+    if (!known) return;
+    const shot = currentShot();
+    if (shot === undefined) return;
+    for (const step of [...layoutSteps(shot), ...(shot.steps ?? [])]) {
+      const ran = done.current.has(step.key);
+      if (ran && step.again !== true) continue;
+      if (!step.ready(latest.current)) {
+        // A step not yet ready holds back every one-off step after it.
+        if (step.again === true) continue;
+        return;
+      }
+      done.current.add(step.key);
+      step.run(latest.current);
+    }
+  };
+  useEffect(() => tick.current());
+  useEffect(() => {
+    const timer = window.setInterval(() => tick.current(), TICK_MS);
+    return () => window.clearInterval(timer);
+  }, []);
+}
