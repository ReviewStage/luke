+/** When the finished agent last saved on the plan, in minutes before launch: the end of its run. */
+export const AGENT_EDIT_MINUTES = 12;
+
+/**
+ * The plan written through the template: the goal, scope, and rules from
+ * the call, and the implementation and decisions as the finished agent
+ * brought them up to date with what it built.
+ */
+const SHOT_FIELDS: PlanFields = {
+  ...EMPTY_PLAN_FIELDS,
+  goal: {
+    problem:
+      "Only an admin can add someone to a workspace, by creating their account by hand. " +
+      "Members wait on an admin to bring a teammate in, and support gets a ticket a day asking for it.",
+    outcome:
+      "A member invites a teammate by email from **Settings › Members**, and the teammate joins " +
+      "the workspace by opening the link.",
+  },
+  scope: {
+    included:
+      "- Inviting by email, accepting by link, and withdrawing a pending invite.\n" +
+      "- Pending invites listed beside members in **Settings › Members**.",
+    excluded: "- Bulk invites from a CSV.\n- Invite-only roles: an invitee joins as a member.",
+    constraints: "An invite link works once, and never after it is withdrawn or accepted.",
+  },
+  rules: [
+    {
+      statement: "Any member may invite by email.",
+      examples: [
+        {
+          given: "A member of acme invites sam@acme.dev",
+          when: "Sam opens the link and signs in",
+          // biome-ignore lint/suspicious/noThenProperty: `then` is the template's own key.
+          then: "Sam is an active member of acme", // oxlint-disable-line unicorn/no-thenable
+        },
