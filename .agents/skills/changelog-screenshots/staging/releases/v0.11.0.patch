diff --git a/apps/desktop/src/renderer/shots/dom.ts b/apps/desktop/src/renderer/shots/dom.ts
new file mode 100644
index 000000000..e098aa2c1
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/dom.ts
@@ -0,0 +1,59 @@
+/**
+ * dom.ts -- the few presses a shot makes on the window as drawn, where no control the shot holds reaches: a fold opened, a row's button, a tab's right-click.
+ *
+ * Throwaway (`shot-spec.ts`). Each is the press a developer would make, made
+ * on the element the release draws, so what it opens is the release's own.
+ */
+
+import { LAUNCHED_AT } from "./clock";
+
+/** One agent's tab body, by the title its section is labelled with; none while another tab is shown. */
+export function agentSection(title: string): HTMLElement | null {
+  return document.querySelector<HTMLElement>(`section.agent-tab[aria-label="${title}"]`);
+}
+
+/** The agent's finished turn's folded lead, the first fold of its transcript; none before the transcript lands. */
+export function leadFold(title: string): HTMLDetailsElement | null {
+  return agentSection(title)?.querySelector<HTMLDetailsElement>("details[data-turn-fold]") ?? null;
+}
+
+/** Opens a fold by its summary, as a click on its line does. */
+export function openFold(fold: HTMLDetailsElement | null): void {
+  if (fold === null || fold.open) return;
+  fold.querySelector<HTMLElement>(":scope > summary")?.click();
+}
+
+/** A subagent row's "Open in tab" button, by the delegation call it draws; none while the row is folded away. */
+export function openInTabButton(title: string, callId: string): HTMLButtonElement | null {
+  return (
+    agentSection(title)?.querySelector<HTMLButtonElement>(
+      `details[data-call-id="${callId}"] button[aria-label="Open in tab"]`,
+    ) ?? null
+  );
+}
+
+/** The side panel's tab labelled `label`; none before the agents are read. */
+export function panelTab(label: string): HTMLElement | null {
+  const tabs = document.querySelectorAll<HTMLElement>(".side-panel-tabs .tab");
+  return [...tabs].find((tab) => tab.querySelector(".tab-label")?.textContent === label) ?? null;
+}
+
+/** Right-clicks a tab where a pointer resting on its label would, which opens its actions where the pointer is. */
+export function rightClick(tab: HTMLElement): void {
+  const button = tab.querySelector<HTMLElement>(".tab-button") ?? tab;
+  const box = button.getBoundingClientRect();
+  button.dispatchEvent(
+    new MouseEvent("contextmenu", {
+      bubbles: true,
+      cancelable: true,
+      button: 2,
+      clientX: Math.round(box.left + box.width * 0.45),
+      clientY: Math.round(box.bottom - 6),
+    }),
+  );
+}
+
+/** Whether `ms` have passed since launch, so the window has settled at its size before a menu that a resize closes is opened. */
+export function settled(ms: number): boolean {
+  return Date.now() - LAUNCHED_AT >= ms;
+}
