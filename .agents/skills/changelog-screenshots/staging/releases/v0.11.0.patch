+/**
+ * plan-document.ts -- the shots' plans: "Teammate invitations" written through 0.11.0's fixed template, its siblings across three repositories, and the planning view built from them.
+ *
+ * Throwaway (`shot-spec.ts`). Every name, repository, and line is the
+ * screenshot world's (`.agents/skills/changelog-screenshots/WORLD.md`) and
+ * invented; nothing is read from an account. The body is formatted by the
+ * release's own `planBody`, so its headings are exactly what 0.11.0's
+ * notetaker writes. Every timestamp is counted back from launch
+ * (`clock.ts`), so nothing reads "Dec 31, 1969".
+ */
+
+import { EMPTY_PLAN_FIELDS, type PlanFields, planBody } from "@sidecar/features/plan-template";
+import type { Plan, PlanSummary } from "@sidecar/features/plan-wire";
+import { PLANNING_READ, type PlanningView } from "@sidecar/features/planning-view";
+import { ago, daysAgo, hoursAgo } from "./clock";
+
+/** The ids the shots share, so the plan, its agents, and their edits agree with one another. */
+export const SHOT_ID = {
+  PLAN: "0f6a2c4e-8b1d-4e3f-9a57-1c2b3d4e5f60",
+  BILLING: "1a7b3d5f-9c2e-4f40-8b68-2d3e4f5a6b71",
+  WEBHOOKS: "2b8c4e6a-0d3f-4a51-9c79-3e4f5a6b7c82",
+  AUDIT: "3c9d5f7b-1e4a-4b62-8d8a-4f5a6b7c8d93",
+  ONBOARDING: "4dae6a8c-2f5b-4c73-9e9b-5a6b7c8d9ea4",
+  DARK_MODE: "5ebf7b9d-3a6c-4d84-8fac-6b7c8d9eafb5",
+  INVOICES: "6fc08cae-4b7d-4e95-9abd-7c8d9eafb0c6",
+  /** The finished coding agent of the plan (`coding-agent.ts`). */
+  AGENT: "8b2a0ec1-6d9f-4ab7-9cdf-9eafb0c1d2e8",
+  /** A second agent, still at work. */
+  AGENT_2: "9c3b1fd2-7eaf-4bc8-8de0-afb0c1d2e3f9",
+} as const;
+
+/** The plan everything is about. */
+export const PLAN_NAME = "Teammate invitations";
+export const PLAN_REPOSITORY = "acme/relay";
+
+/** The coding agents' generated titles, as their tabs and the plan's edit line name them. */
+export const AGENT_TITLE = "Add teammate invitations";
