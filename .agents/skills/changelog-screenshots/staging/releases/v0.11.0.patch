+          // biome-ignore lint/suspicious/noThenProperty: `then` is the template's own key.
+          then: 'the page reads "This invite is no longer valid"', // oxlint-disable-line unicorn/no-thenable
+        },
+      ],
+    },
+  ],
+  implementation: {
+    changeMap:
+      "- `src/db/migrations/20261013_memberships_state.sql`: `state`, `invite_token`, `invited_by`.\n" +
+      "- `src/members/invite.ts`: new; `inviteMember`, `acceptInvite`, `withdrawInvite`.\n" +
+      "- `src/routes/invites.ts`: `POST /invites` and `GET /invites/:token`.\n" +
+      "- `src/members/list.ts`, `src/billing/seats.ts`, `src/auth/workspace-access.ts`: skip pending rows.",
+    contracts:
+      "`inviteMember(workspaceId, email)` answers the pending membership and mails one link; " +
+      "`acceptInvite(token, userId)` answers the active membership or `InviteError('no-longer-valid')`.",
+    patterns:
+      "Follow `src/members/remove.ts` for the admin check, and `src/mail/templates/` for the invite email.",
+    order: null,
+  },
+  decisions:
+    "Model an invite as a `memberships` row with `state = pending`. Why: removal covers invites " +
+    "and members alike. Rejected: a separate `invitations` table.",
+  verification:
+    "`pnpm test src/members`, then invite a second account on a preview deploy.",
+  leftToAgent: "The invite email's copy, within the existing template's layout.",
+  openQuestions: ["Should an invite expire after 7 days or 14?"],
+};
+
+/** The finished document's body, as the template formats it. */
+export const SHOT_DOCUMENT_BODY = planBody({ name: PLAN_NAME }, SHOT_FIELDS);
+
+/** The open plan, with the finished agent's save on it. */
+export function shotPlan(): Plan {
+  return {
+    id: SHOT_ID.PLAN,
+    name: PLAN_NAME,
+    createdAt: daysAgo(2),
+    updatedAt: ago(AGENT_EDIT_MINUTES),
+    repository: PLAN_REPOSITORY,
+    document: {
+      body: SHOT_DOCUMENT_BODY,
+      assumptions: [
+        { text: "Invites reuse memberships with a pending state." },
+        { text: "Members and admins can both invite." },
+        { text: "An invite expires after 7 days." },
+      ],
+    },
+    agentEdits: [
+      { agentId: SHOT_ID.AGENT, label: AGENT_TITLE, at: ago(24) },
+      { agentId: SHOT_ID.AGENT, label: AGENT_TITLE, at: ago(AGENT_EDIT_MINUTES) },
+    ],
+  };
+}
+
+/** The open plan as its list row. */
+function shotPlanSummary(): PlanSummary {
+  const { document: _document, agentEdits: _agentEdits, ...row } = shotPlan();
+  return row;
+}
+
+/** The plan's siblings, across three repositories, updated minutes to days ago. */
+function shotOtherPlans(): PlanSummary[] {
+  return [
+    {
+      id: SHOT_ID.WEBHOOKS,
+      name: "Webhook retries",
+      createdAt: daysAgo(3),
+      updatedAt: hoursAgo(2),
+      repository: "acme/relay",
+    },
+    {
+      id: SHOT_ID.AUDIT,
+      name: "Audit log export",
+      createdAt: daysAgo(6),
+      updatedAt: daysAgo(1.1),
+      repository: "acme/relay",
+    },
+    {
+      id: SHOT_ID.BILLING,
+      name: "Usage-based billing",
+      createdAt: daysAgo(4),
+      updatedAt: ago(26),
+      repository: "acme/ledger",
+    },
+    {
+      id: SHOT_ID.INVOICES,
+      name: "Invoice PDF redesign",
+      createdAt: daysAgo(9),
+      updatedAt: daysAgo(3),
+      repository: "acme/ledger",
+    },
+    {
+      id: SHOT_ID.ONBOARDING,
+      name: "Onboarding checklist",
+      createdAt: daysAgo(2),
+      updatedAt: hoursAgo(5),
+      repository: "acme/web",
+    },
+    {
+      id: SHOT_ID.DARK_MODE,
+      name: "Dark mode for the dashboard",
+      createdAt: daysAgo(12),
+      updatedAt: daysAgo(4),
+      repository: "acme/web",
+    },
+  ];
+}
+
+/**
+ * The planning view with the plan open on its document and no call: the
+ * list, the plan, an empty transcript, and no work or code, so the side
+ * panel holds the plan's agents alone and no tab waits on a read.
+ */
+export function shotPlanningView(): PlanningView {
+  const plan = shotPlan();
+  return {
+    plans: [shotPlanSummary(), ...shotOtherPlans()],
+    listStatus: PLANNING_READ.READY,
+    activePlanId: plan.id,
+    document: { status: PLANNING_READ.READY, plan },
+    transcript: { status: PLANNING_READ.READY, transcript: { calls: [], earlierOmitted: false } },
+    work: [],
+    shownCode: [],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/shot-profiles.ts b/apps/desktop/src/renderer/shots/shot-profiles.ts
