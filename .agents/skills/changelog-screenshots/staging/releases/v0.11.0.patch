+/** The cursor a reader starts from. */
+const START = "0:0";
+
+/** The two delegation calls the finished agent made, by eve's id for each, and the task each was handed. */
+export const WORKER = {
+  MEMBERSHIPS: {
+    callId: "call_7mQ2rWd9",
