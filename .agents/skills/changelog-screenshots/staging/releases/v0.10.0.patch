@@ -0,0 +1,43 @@
+/**
+ * shot-profiles.ts -- the registry: which shot each `--profile shot-*` launch stages, built once on first use.
+ *
+ * Throwaway: the 0.10.0 changelog screenshots' staging, never committed.
+ * Only a fixture run stages a shot. Each shot's builder lives in a file of
+ * its own and is called lazily, the first time the shot is asked for, so no
+ * shot module reads another module's values at load; the spec built is
+ * kept, so every reader is handed the same objects render after render.
+ */
+
+import { RUN_PROFILE } from "#shared/messages/app-state";
+import { appStateNow } from "../use-app-state";
+import { codingAgentsShot } from "./coding-agents";
+import { githubRepositoryShot } from "./github-repository";
+import type { ShotSpec } from "./shot-spec";
+
+/** Each shot's builder, by its profile. */
+const BUILDERS: ReadonlyMap<string, () => ShotSpec> = new Map([
+  [RUN_PROFILE.SHOT_CODING_AGENTS, codingAgentsShot],
+  [RUN_PROFILE.SHOT_GITHUB_REPOSITORY, githubRepositoryShot],
+]);
+
+/** Each shot as built, by its profile. */
+const built = new Map<string, ShotSpec>();
+
+/** The shot a run stages: one of the shot profiles in a fixture run, else none. */
+export function shotSpec(
+  run: { readonly fixtureMode: boolean; readonly profile: string } | undefined,
+): ShotSpec | undefined {
+  if (run === undefined || !run.fixtureMode) return undefined;
+  const build = BUILDERS.get(run.profile);
+  if (build === undefined) return undefined;
+  const held = built.get(run.profile);
+  if (held !== undefined) return held;
+  const spec = build();
+  built.set(run.profile, spec);
+  return spec;
+}
+
+/** The shot this window stages, read from the state as it stands; none before the state has arrived. */
+export function currentShot(): ShotSpec | undefined {
+  return shotSpec(appStateNow()?.run);
+}
diff --git a/apps/desktop/src/renderer/shots/shot-spec.ts b/apps/desktop/src/renderer/shots/shot-spec.ts
new file mode 100644
index 00000000..586c706d
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/shot-spec.ts
@@ -0,0 +1,65 @@
+/**
+ * shot-spec.ts -- what one changelog shot stages: the plans and canned answers it draws, and the layout it opens on.
+ *
+ * Throwaway: the 0.10.0 changelog screenshots' staging, applied on a Mac to
+ * the release commit and never committed. Only types and one marker live
+ * here, so every shot module and every hook into the app can import it
+ * without an evaluation-order cycle.
+ */
+
+import type { PlanningRepositoriesAnswer, PlanningView } from "@sidecar/hosted/planning-view";
+import type { ActKind, ActPayload, ActResultFor } from "#shared/messages/acts";
+import type { SidebarCollapse } from "../desktop/sidebar-collapse";
+import type { PlansControl } from "../planning/use-plans-tab";
+import type { SidePanelState } from "../planning/use-side-panel";
+
+/** An answer that never settles: what a long-poll loop is handed once it has read what it will read. */
+export const NEVER: unique symbol = Symbol("shot-never");
+
+/**
+ * One kind's canned answer, from its payload: a value its own guard admits,
+ * {@link NEVER} for a read held open forever, or nothing to let the act go
+ * to main as it would.
+ */
+export type ShotAnswer<Kind extends ActKind> = (
+  payload: ActPayload<Kind>,
+) => ActResultFor<Kind> | typeof NEVER | undefined;
+
+/** Every kind a shot answers itself, each by its own answer. */
+export type ShotAnswers = { readonly [Kind in ActKind]?: ShotAnswer<Kind> };
+
+/** What the staging effect hands each step: the Plans tab and the sidebar. */
+export interface ShotStageContext {
+  readonly plans: PlansControl;
+  readonly sidebar: SidebarCollapse;
+}
+
+/** One staging step, run once, the first render it is ready on. */
+export interface ShotStep {
+  readonly key: string;
+  readonly ready: (context: ShotStageContext) => boolean;
+  readonly run: (context: ShotStageContext) => void;
+}
+
+/** The window's layout as the shot opens on it; anything left out stays as the fixture run opens it. */
+export interface ShotLayout {
+  /** Folds the sidebar away. */
+  readonly sidebarCollapsed?: boolean;
+  /** The side panel fills the window over the plan's document. */
+  readonly sidePanelFullScreen?: boolean;
+}
+
+/** One shot: everything it draws in place of the fixture's, and how it is laid out. */
+export interface ShotSpec {
+  /** The plans the Plans tab draws, its open one included. */
+  readonly planning: PlanningView;
+  /** The side panel the open plan starts with; referentially stable, as the spec is built once. */
+  readonly sidePanel?: SidePanelState;
+  /** The repositories the chip lists, read from nowhere as a fixture's are. */
+  readonly repositories?: PlanningRepositoriesAnswer;
+  /** The acts the shot answers itself (`canned-acts.ts`). */
+  readonly answers?: ShotAnswers;
+  readonly layout?: ShotLayout;
+  /** Staging the layout cannot say, run after it (`use-shot-staging.ts`). */
+  readonly steps?: readonly ShotStep[];
+}
diff --git a/apps/desktop/src/renderer/shots/use-shot-staging.ts b/apps/desktop/src/renderer/shots/use-shot-staging.ts
new file mode 100644
index 00000000..eb6534e8
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/use-shot-staging.ts
@@ -0,0 +1,62 @@
+/**
+ * use-shot-staging.ts -- the one fixture-only effect that lays a shot's window out: the sidebar's fold and the side panel's full screen, then the shot's own steps, each once, the first render it can be.
+ *
+ * Throwaway: the 0.10.0 changelog screenshots' staging, never committed.
+ * Called from `App` with the Plans tab and the sidebar. Each step runs once,
+ * the first render on which what it needs is drawn: a full-screen panel
+ * once the plan is drawn and its panel open, a step of the shot's own once
+ * its element is in the page.
+ */
+
+import { useEffect, useRef } from "react";
+import { DOCUMENT_REGION } from "../planning/planning-model";
+import { currentShot } from "./shot-profiles";
+import type { ShotSpec, ShotStageContext, ShotStep } from "./shot-spec";
+
+/** Whether the open plan is drawn. */
+function planDrawn(context: ShotStageContext): boolean {
+  return context.plans.region.kind === DOCUMENT_REGION.READY;
+}
+
+/** The steps a shot's layout asks for, in the order they run. */
+function layoutSteps(shot: ShotSpec): ShotStep[] {
+  const layout = shot.layout ?? {};
+  const steps: ShotStep[] = [];
+  const { sidebarCollapsed } = layout;
+  if (sidebarCollapsed !== undefined) {
+    steps.push({
+      key: "sidebar",
+      ready: () => true,
+      run: ({ sidebar }) => {
+        if (sidebar.collapsed !== sidebarCollapsed) sidebar.onToggle();
+      },
+    });
+  }
+  if (layout.sidePanelFullScreen === true) {
+    steps.push({
+      key: "full-screen",
+      ready: (context) => planDrawn(context) && context.plans.sidePanel.open,
+      run: ({ plans }) => {
+        if (!plans.sidePanel.fullScreen) plans.sidePanel.onToggleFullScreen();
+      },
+    });
+  }
+  return steps;
+}
+
+/** Stages the shot this run is for, if any; `known` once the state has arrived and the window is past its gate. */
+export function useShotStaging(context: ShotStageContext, known: boolean): void {
+  const done = useRef(new Set<string>());
+  const latest = useRef(context);
+  latest.current = context;
+  useEffect(() => {
+    if (!known) return;
+    const shot = currentShot();
+    if (shot === undefined) return;
+    for (const step of [...layoutSteps(shot), ...(shot.steps ?? [])]) {
+      if (done.current.has(step.key) || !step.ready(latest.current)) continue;
+      done.current.add(step.key);
+      step.run(latest.current);
+    }
+  });
+}
