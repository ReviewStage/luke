+import { PLAN_BODY, PLAN_REPOSITORY, SHOT_ID, shotOpenPlanView } from "./plan-world";
+import { NEVER, type ShotAnswers, type ShotSpec } from "./shot-spec";
+
+/** The catalog ids the agents run on, as AI Gateway's catalog spells them. */
+const MODEL = {
+  OPUS: "anthropic/claude-opus-5.5",
+  OPUS_FAST: "anthropic/claude-opus-5.5-fast",
+  SONNET: "anthropic/claude-sonnet-5.5",
+  FABLE: "anthropic/claude-fable-5",
+  SOL: "openai/gpt-6.1-sol",
+  ASTRA: "openai/gpt-6-astra",
+} as const;
