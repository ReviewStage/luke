+
+/** One tool call as the SDK stores its part: answered, or still running with no output. */
+function toolPart(tool: string, toolCallId: string, input: WireRecord, output?: WireValue): WireRecord {
+  return output === undefined
+    ? { type: `tool-${tool}`, toolCallId, state: "input-available", input }
+    : { type: `tool-${tool}`, toolCallId, state: "output-available", input, output };
+}
+
+/** A command the sandbox ran, answered as eve's bash tool answers. */
+function bash(toolCallId: string, command: string, stdout?: string): WireRecord {
+  return toolPart(
+    "bash",
+    toolCallId,
+    { command },
+    stdout === undefined
+      ? undefined
+      : { exitCode: 0, stdout, stderr: "", truncated: false },
+  );
+}
+
+/** A file read whole, answered with its words. */
+function readFile(toolCallId: string, path: string, content: string): WireRecord {
+  return toolPart("read_file", toolCallId, { filePath: `${ROOT}/${path}` }, { content });
+}
+
+/** A patch applied, answered with the files it changed. */
+function applyPatch(
+  toolCallId: string,
+  patch: readonly string[],
+  files: readonly { operation: string; path: string }[],
+): WireRecord {
+  return toolPart(
+    "apply_patch",
+    toolCallId,
+    { root: ROOT, patchText: ["*** Begin Patch", ...patch, "*** End Patch"].join("\n") },
+    { files: files.map((file) => ({ ...file })) },
+  );
