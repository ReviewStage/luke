+          type: "text",
+          text:
+            "Opened [#214](https://github.com/acme/relay/pull/214). An invite is a `memberships` row with `state = pending`: " +
+            "`POST /invites` creates it and mails a one-time link, and `/invites/:token` turns it active once the visitor signs in. " +
+            "The members list now skips pending rows. Next, pending invites in **Settings › Members**.",
+        },
+        readFile(
+          "call_9i",
+          "src/web/settings/members-page.tsx",
+          "export function MembersPage({ members }: { members: Member[] }) {\n  return <MemberTable rows={members} />;\n}\n",
+        ),
+      ],
+    },
+    { id: "m-steer", role: "user", parts: [{ type: "text", text: STEER }] },
+    {
+      id: "m-turn-2",
+      role: "assistant",
+      parts: [
+        { type: "step-start" },
+        {
+          type: "reasoning",
+          text: "Two changes: the link's lifetime, and who may withdraw. Removal already asserts an admin, so withdrawing can reuse that check for anyone but the sender.",
+        },
+        toolPart(
+          "grep",
+          "call_10j",
+          { pattern: "INVITE_TTL_DAYS", path: "src" },
+          { content: "src/members/invite.ts:1:const INVITE_TTL_DAYS = 7;" },
+        ),
+        applyPatch("call_11k", STEER_PATCH, [
+          { operation: "update", path: "src/members/invite.ts" },
+          { operation: "add", path: "src/members/withdraw.ts" },
+        ]),
+        { type: "step-start" },
+        {
+          type: "text",
+          text: "Invite links now last 14 days, and any admin can withdraw an invite as well as its sender. Running the members tests again before I push to #214.",
+        },
+        bash("call_12l", "pnpm test src/members"),
+      ],
+    },
+  ];
+}
+
+/** One page of a transcript read past `after`: the agent's whole transcript at the start, then a hold that never lets go. */
+function transcriptPage(
+  agentId: string,
+  after: string,
+): CodingAgentMessagesAnswerView | typeof NEVER | undefined {
+  if (agentId !== SHOT_ID.AGENT && agentId !== SHOT_ID.AGENT_2) return undefined;
+  if (after !== START) return NEVER;
+  return {
+    messages: agentId === SHOT_ID.AGENT ? shotAgentMessages() : [],
+    cursor: READ_THROUGH,
+    status: "running",
+  };
+}
+
+/** What each agent published: the first its branch and #214, open, its checks passing; the second nothing yet. */
+function shotPullRequest(agentId: string): CodingAgentPullRequestAnswerView {
+  if (agentId !== SHOT_ID.AGENT) return { repository: PLAN_REPOSITORY, branch: null, pullRequest: null };
+  return {
+    repository: PLAN_REPOSITORY,
+    branch: "luke/teammate-invitations",
+    pullRequest: {
+      number: 214,
+      title: "Add teammate invitations",
+      url: "https://github.com/acme/relay/pull/214",
+      state: "open",
+      checks: "passing",
+      additions: 412,
+      deletions: 38,
+      changedFiles: 9,
+    },
+  };
+}
+
+/** The plan's agents as the acts answer them: list, transcripts, pull requests, models, and the default. */
+function codingAgentAnswers(): ShotAnswers {
+  const list: CodingAgentListAnswer = { agents: shotAgents() };
+  const models = shotModels();
+  const defaultChoice: CodingAgentDefaultAnswer = { choice: { model: MODEL.OPUS, effort: "high" } };
+  return {
+    [ACT_KIND.CODING_AGENTS_LIST]: (payload) =>
+      payload.planId === SHOT_ID.PLAN ? list : { agents: [] },
+    [ACT_KIND.CODING_AGENTS_MESSAGES]: (payload) => transcriptPage(payload.agentId, payload.after),
+    [ACT_KIND.CODING_AGENTS_PULL_REQUEST]: (payload) => shotPullRequest(payload.agentId),
+    [ACT_KIND.CODING_AGENTS_MODELS]: () => models,
+    [ACT_KIND.CODING_AGENTS_DEFAULT_READ]: () => defaultChoice,
+  };
+}
+
+export function codingAgentsShot(): ShotSpec {
+  return {
+    planning: shotOpenPlanView(),
+    sidePanel: {
+      open: true,
+      tabs: SIDE_PANEL_TABS,
+      tab: { agent: SHOT_ID.AGENT },
+      width: SIDE_PANEL_WIDTH.DEFAULT,
+    },
+    answers: codingAgentAnswers(),
+    layout: { sidebarCollapsed: true, sidePanelFullScreen: true },
+    steps: [
+      {
+        // The tabs name their models by the catalog's own names once it is read, as a Start menu opening reads it.
+        key: "models",
+        ready: ({ plans }) => plans.agents.agentIds !== undefined,
+        run: ({ plans }) => plans.agents.readModels(),
+      },
+    ],
+  };
+}
