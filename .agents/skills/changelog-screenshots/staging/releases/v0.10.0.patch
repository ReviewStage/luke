+/**
+ * github-repository.ts -- the "Planning on a GitHub repository" shot: the new-plan composer with its repository chip's menu held open over acme's repositories.
+ *
+ * Throwaway: the 0.10.0 changelog screenshots' staging, never committed.
+ * The sidebar folds away so the composer stands alone in the window's
+ * middle, a name is typed into it ("Invite link expiry", the follow-up the
+ * Teammate invitations plan left open), and the chip's menu is opened as a
+ * press would open it: the search field, the recent repositories the plans
+ * were about (acme/relay, chosen, then acme/ledger and acme/web), the rest
+ * the Luke GitHub App reaches, and the GitHub row pinned under the list.
+ * The menu closes when focus leaves it, which a window losing focus does,
+ * so it is opened again whenever the window takes focus back; the capture
+ * is of the focused window.
+ */
+
+import type { PlanningRepositoriesAnswer } from "@sidecar/hosted/planning-view";
+import { daysAgo, hoursAgo } from "./clock";
+import { shotHomeView } from "./plan-world";
+import type { ShotSpec } from "./shot-spec";
+
+/** The name typed into the composer. */
+const PLAN_NAME_TYPED = "Invite link expiry";
+
+/** The composer's name field and the chip, as the page draws them. */
+const NAME_FIELD = 'textarea[aria-label="Plan name"]';
+const CHIP = ".plan-compose .plan-compose-chip";
+
+/** One acme repository, as GitHub lists it. */
+function repository(name: string, updatedAt: number, isPrivate = true) {
+  return {
+    owner: "acme",
+    name,
+    fullName: `acme/${name}`,
+    defaultBranch: "main",
+    private: isPrivate,
+    updatedAt,
+  };
+}
+
+/** Every repository the App reaches on acme, most recently updated first. */
+function shotRepositories(): PlanningRepositoriesAnswer {
+  return {
+    repositories: {
+      installed: true,
+      repositories: [
+        repository("relay", hoursAgo(1)),
+        repository("web", hoursAgo(3)),
+        repository("ledger", hoursAgo(6)),
+        repository("relay-mobile", daysAgo(1)),
+        repository("design-system", daysAgo(2), false),
+        repository("infra", daysAgo(3)),
+        repository("docs", daysAgo(5), false),
+        repository("status-page", daysAgo(9), false),
+      ],
+      installationUrl: "https://github.com/apps/luke/installations/new",
+    },
+  };
+}
+
+/** Types the name into the composer's field the way a keystroke reaches React: the native setter, then an input event. */
+function typeName(field: HTMLTextAreaElement): void {
+  const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, "value")?.set;
+  setter?.call(field, PLAN_NAME_TYPED);
+  field.dispatchEvent(new Event("input", { bubbles: true }));
+}
+
+/** Presses the chip where its menu is not open. */
+function openMenu(): void {
+  const chip = document.querySelector<HTMLButtonElement>(CHIP);
+  if (chip !== null && chip.getAttribute("aria-expanded") !== "true") chip.click();
+}
+
+export function githubRepositoryShot(): ShotSpec {
+  return {
+    planning: shotHomeView(),
+    repositories: shotRepositories(),
+    layout: { sidebarCollapsed: true },
+    steps: [
+      {
+        key: "name",
+        ready: () => document.querySelector(NAME_FIELD) !== null,
+        run: () => {
+          const field = document.querySelector<HTMLTextAreaElement>(NAME_FIELD);
+          if (field !== null) typeName(field);
+        },
+      },
+      {
+        key: "menu",
+        ready: () => document.querySelector(CHIP) !== null,
+        run: () => {
+          window.addEventListener("focus", () => window.setTimeout(openMenu, 50));
+          window.setTimeout(openMenu, 300);
+        },
+      },
+    ],
+  };
+}
+
