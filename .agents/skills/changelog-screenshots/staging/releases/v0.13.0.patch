+/**
+ * integrations.ts -- shot "Eight more integrations": Settings › Integrations, all twelve rows connected.
+ *
+ * Throwaway (`README.md`). See `.context/shots/SPEC.md` for what it must show.
+ * Every provider this release offers stands connected, GitHub's among them:
+ * its row reads the account's own GitHub grant (`integration-grant.ts`), but
+ * where it stands still comes from the one statuses read, which the service
+ * answers connected whenever that grant stands. Each row's "Connected · N
+ * tools" counts its server's tools list (`integrations-tools.ts`), so every
+ * provider answers the tools read with a list as long as its real server's
+ * is believable. Both reads are asked again only on the window's focus, never
+ * in a loop, so each is answered every time. No row is left disconnected,
+ * pending, or broken, so none draws Connect, Reconnect, a reason, or a ring.
+ */
+
+import type {
+  IntegrationStatusesView,
+  IntegrationToolsView,
+} from "@sidecar/hosted/integration-view";
+import {
+  INTEGRATION_PROVIDER_LIST,
+  INTEGRATION_STATUS,
+  type IntegrationProvider,
+  type IntegrationStatus,
+} from "@sidecar/hosted/integration-wire";
+import { ACT_KIND } from "#shared/messages/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { SETTINGS_VIEW } from "../settings-views";
+import { SHOT_INTEGRATION_TOOLS } from "./integrations-tools";
+import { shotPlanningView } from "./plan-document";
+import type { ShotSpec } from "./shot-spec";
+
+/** Every provider connected, as the service answers the statuses read. */
+function everyProviderConnected(): IntegrationStatusesView {
+  // SAFETY: the entries are built from INTEGRATION_PROVIDER_LIST, so every provider is a key.
+  const integrations = Object.fromEntries(
+    INTEGRATION_PROVIDER_LIST.map((provider) => [provider, INTEGRATION_STATUS.CONNECTED]),
+  ) as Record<IntegrationProvider, IntegrationStatus>;
+  return { integrations };
+}
+
+export function integrationsShot(): ShotSpec {
+  const statuses = everyProviderConnected();
+  return {
+    planning: shotPlanningView({}),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: {
+      [ACT_KIND.INTEGRATIONS_STATUS]: () => statuses,
+      [ACT_KIND.INTEGRATIONS_TOOLS]: (payload): IntegrationToolsView => ({
+        tools: SHOT_INTEGRATION_TOOLS[payload.provider].map((tool) => ({ ...tool })),
+      }),
+    },
+    layout: { settingsView: SETTINGS_VIEW.INTEGRATIONS },
+  };
+}
