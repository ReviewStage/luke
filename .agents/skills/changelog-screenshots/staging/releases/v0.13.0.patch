+    " ",
+    run("function", KEYWORD),
+    " ",
+    run("inviteMember", FUNCTION),
+    "(workspaceId: ",
+    run("string", CONSTANT),
+    ", email: ",
+    run("string", CONSTANT),
+    ") {",
+  ),
+  line("  ", run("const", KEYWORD), " token = ", run("randomToken", FUNCTION), "();"),
+  line(
+    "  ",
+    run("const", KEYWORD),
+    " expiresAt = ",
+    run("new", KEYWORD),
+    " ",
+    run("Date", FUNCTION),
+    "(Date.",
+    run("now", FUNCTION),
+    "() + ",
+    run("INVITE_TTL_MS", CONSTANT),
+    ");",
+  ),
+  line(
+    "  ",
+    run("const", KEYWORD),
+    " membership = ",
+    run("await", KEYWORD),
+    " db.memberships.",
+    run("insert", FUNCTION),
+    "({ workspaceId, email, state: ",
+    run('"pending"', STRING),
+    ", inviteToken: token, expiresAt });",
+  ),
+  line(
