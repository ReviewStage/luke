+
+/** The plans the window lists, each other plan holding items naming its one finished agent, so its rows lead with the agent's mark. */
+function inboxPlans(): PlanSummary[] {
+  const agentOf = new Map<string, (typeof OTHER_AGENT)[keyof typeof OTHER_AGENT]>(
+    Object.values(OTHER_AGENT).map((agent) => [agent.planId, agent]),
+  );
+  return [
+    shotPlanSummary(),
+    ...shotOtherPlans().map((plan): PlanSummary => {
+      const agent = agentOf.get(plan.id);
+      if (agent === undefined) return plan;
+      return {
+        ...plan,
+        agents: {
+          total: 1,
+          working: 0,
+          agents: [
+            {
+              id: agent.id,
+              title: agent.title,
+              model: agent.model,
+              effort: agent.effort,
+              status: "completed",
+              at: agent.finishedAt,
+            },
+          ],
+          pullRequestTotal: 0,
+          pullRequests: [],
+        },
+      };
+    }),
+  ];
+}
+
+/** Each plan's items, by plan. */
+function planItems(planId: string): InboxItem[] {
+  switch (planId) {
+    case SHOT_ID.PLAN:
+      return invitationItems();
+    case SHOT_ID.BILLING:
+      return billingItems();
+    case SHOT_ID.WEBHOOKS:
+      return webhookItems();
+    case SHOT_ID.ONBOARDING:
+      return onboardingItems();
+    default:
+      return [];
+  }
+}
+
+/** A plan's inbox read past `after`: every item from the start, then held, since nothing changes. */
+function inboxPage(planId: string, after: string): InboxAnswer | typeof NEVER {
+  if (after !== INBOX_CURSOR_START) return NEVER;
+  return { items: planItems(planId), cursor: READ_THROUGH };
+}
+
+/** What main says of each plan holding items: how many, and when the latest changed. */
+function holdings(): AppInboxPlanHolding[] {
+  return [SHOT_ID.PLAN, SHOT_ID.BILLING, SHOT_ID.WEBHOOKS, SHOT_ID.ONBOARDING].map((planId) => {
+    const items = planItems(planId);
+    return { planId, items: items.length, updatedAt: Math.max(...items.map((item) => item.updatedAt)) };
+  });
+}
+
+export function inboxShot(): ShotSpec {
+  return {
+    planning: shotPlanningView({ plans: inboxPlans() }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.CODING_AGENTS_INBOX]: (payload) => inboxPage(payload.planId, payload.after),
+      [ACT_KIND.CODING_AGENTS_INBOX_ATTACHMENT]: (payload) =>
+        payload.attachmentId === ATTACHMENT_ID
+          ? { contentType: INBOX_IMAGE_TYPE.PNG, base64: EXPIRED_INVITE_PNG_BASE64 }
+          : undefined,
+      // Note that the window is answered as the agent's commit held it, the block's lines lit in it.
+      [ACT_KIND.PLANNING_FILE]: (payload) => {
+        if (payload.path !== INVITE_PATH) return undefined;
+        const firstLine = Math.max(1, payload.firstLine);
+        const lastLine = Math.min(INVITE_FILE.length, payload.lastLine);
+        return {
+          file: {
+            path: INVITE_PATH,
+            repository: PLAN_REPOSITORY,
+            branch: "luke/teammate-invitations",
+            firstLine,
+            lineCount: INVITE_FILE.length,
+            lines: INVITE_FILE.slice(firstLine - 1, lastLine),
+          },
+        };
+      },
+    },
+    inbox: {
+      waiting: [
+        { planId: SHOT_ID.PLAN, items: [ITEM_ID.POSTMARK, ITEM_ID.EXPIRED] },
+        { planId: SHOT_ID.ONBOARDING, items: [ITEM_ID.FIRST_STEP] },
+      ],
+      plans: holdings(),
+    },
+    layout: { sidebarCollapsed: true },
+    steps: [
+      {
+        // The Inbox stands on the first item waiting where none is chosen, so the settled decision is chosen as the home page's row chooses one.
+        key: "inbox-ttl",
+        ready: ({ plans }) => plans.plans.some((plan) => plan.id === SHOT_ID.PLAN),
+        run: ({ plans }) => {
+          plans.inboxView.onOpen();
+          plans.inboxView.onChoose({ planId: SHOT_ID.PLAN, itemId: ITEM_ID.TTL });
+        },
+      },
+    ],
+  };
+}
