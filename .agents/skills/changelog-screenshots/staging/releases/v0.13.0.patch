+/**
+ * integrations-tools.ts -- every integration's tools as its hosted MCP server lists them, for the shots that draw a count or a list of them.
+ *
+ * Throwaway (`README.md`). Names and descriptions follow each provider's real
+ * server (the addresses in `apps/web/server/hosted/integrations.ts`), cut to a
+ * believable set: GitHub's `x/all` toolsets are many, Granola's few. A row's
+ * "Connected · N tools" is the length of its list here, so the lengths are
+ * the counts the picture shows. Reads carry `readOnlyHint`, deletes
+ * `destructiveHint`, as their servers annotate them.
+ */
+
+import { INTEGRATION_PROVIDER, type IntegrationProvider } from "@sidecar/hosted/integration-wire";
+import type { IntegrationTool } from "../integration-health";
+
+/** A tool that only reads. */
+function r(name: string, description: string): IntegrationTool {
+  return { name, description, annotations: { readOnlyHint: true } };
+}
+
+/** A tool that writes, and takes nothing away. */
+function w(name: string, description: string): IntegrationTool {
+  return { name, description, annotations: { readOnlyHint: false, destructiveHint: false } };
+}
+
+/** A tool whose write destroys. */
+function d(name: string, description: string): IntegrationTool {
+  return { name, description, annotations: { readOnlyHint: false, destructiveHint: true } };
+}
