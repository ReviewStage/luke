+/** The service the accept link points at, as production writes it. */
+const SERVICE_ORIGIN = "https://tryluke.dev";
+
+/** How long Better Auth keeps an invitation open by default: 48 hours. */
+const INVITATION_OPEN_HOURS = 48;
+
+/** acme's members, as the service orders them: owners, then admins, then members, each by name. */
+function acmeMembers(): WorkspaceMember[] {
+  return [
+    {
+      userId: "usr_dean8Kf3Qz1",
+      name: "Dean Stratakos",
+      email: "dean@example.com",
+      role: WORKSPACE_ROLE.OWNER,
+    },
+    {
+      userId: "usr_dana2Wm7Hx4",
+      name: "Dana Moreno",
+      email: "dana@acme.dev",
+      role: WORKSPACE_ROLE.ADMIN,
+    },
+    {
+      userId: "usr_jord5Np2Lc8",
+      name: "Jordan Lee",
+      email: "jordan@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+    {
+      userId: "usr_priy9Tb6Rv3",
+      name: "Priya Raman",
+      email: "priya@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+    {
+      userId: "usr_theo3Gs1Yk7",
+      name: "Theo Walsh",
+      email: "theo@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+  ];
+}
+
+/** acme's one pending invitation: sam@acme.dev as a member, sent two hours ago. */
+function acmeInvitations(): WorkspaceInvitation[] {
+  const id = "Wq3nX8vB2kLp9RtY4zHc6mJd";
+  const email = "sam@acme.dev";
+  const sentAt = hoursAgo(2);
+  return [
+    {
+      id,
+      email,
+      role: INVITATION_ROLE.MEMBER,
+      expiresAt: new Date(sentAt + INVITATION_OPEN_HOURS * 3_600_000).toISOString(),
+      acceptUrl: invitationAcceptUrl(SERVICE_ORIGIN, id, email),
+    },
+  ];
+}
+
+export function workspacesShot(): ShotSpec {
+  const members = acmeMembers();
+  const invitations = acmeInvitations();
+  return {
+    planning: shotPlanningView({}),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: {
+      ...codingAgentAnswers(),
+      // Note that each read is asked once per drawing of the page, never in a loop, so it is answered every time.
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.WORKSPACE_INVITATIONS_READ]: () => invitations,
+    },
+    layout: { settingsView: SETTINGS_VIEW.WORKSPACE },
+  };
+}
