@@ -0,0 +1,173 @@
+/**
+ * mcp.ts -- shot "The MCP popover": the MCP popover open over a coding agent's composer.
+ *
+ * Throwaway (`README.md`). See `.context/shots/SPEC.md` for what it must show.
+ * The plan "Teammate invitations" opens on its finished agent "Add teammate
+ * invitations" in the plan's column, the sidebar folded and the side panel
+ * closed, its transcript the shared one (`coding-agent.ts`) above its box.
+ * The popover is the release's own (`planning/agent-servers.tsx`): eight
+ * servers stand Connected, each with its count of tools (the Integrations
+ * shot's lists, `integrations-tools.ts`, so the two agree) and this agent's
+ * switch, PostHog's switched off for this agent and the rest on; Mercury and
+ * Y Combinator stand Not connected with Connect; Granola and Supabase are not
+ * offered by this deployment, so the list holds ten rows and fits the
+ * popover's 400px list without a scrollbar. The statuses and each server's
+ * tools are read once per focus of the window, never in a loop, so they are
+ * answered every time. The finished agent's pages carry its context, so the
+ * ring draws beside the MCP button. A step presses the MCP button once the
+ * transcript, the box's editor, and its foot are drawn; the popover closes
+ * only on Escape, a second press, or focus moving elsewhere in a focused
+ * window, none of which the staging does, and it stays open while the
+ * window is away.
+ */
+
+import type {
+  CodingAgentListAnswer,
+  CodingAgentMessagesAnswerView,
+} from "@luke/features/coding-agent-view";
+import type { CodingAgentContext } from "@luke/features/coding-agent-wire";
+import type { IntegrationToolsView } from "@luke/features/integration-view";
+import {
+  INTEGRATION_PROVIDER,
+  INTEGRATION_STATUS,
+  type IntegrationProvider,
+  type IntegrationStatus,
+} from "@luke/features/integration-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago } from "./clock";
+import { codingAgentAnswers, shotAgents } from "./coding-agent";
+import { SHOT_INTEGRATION_TOOLS } from "./integrations-tools";
+import { SHOT_ID, shotPlanningView } from "./plan-document";
+import { NEVER, type ShotAnswers, type ShotSpec, type ShotStep } from "./shot-spec";
+
+/** Where each provider stands: eight connected, two to connect, two this deployment does not offer. */
+const STANDING: Readonly<Record<IntegrationProvider, IntegrationStatus>> = {
+  [INTEGRATION_PROVIDER.GITHUB]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.GRANOLA]: INTEGRATION_STATUS.UNAVAILABLE,
+  [INTEGRATION_PROVIDER.LINEAR]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.MERCURY]: INTEGRATION_STATUS.DISCONNECTED,
+  [INTEGRATION_PROVIDER.NEON]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.NOTION]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.POSTHOG]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.SENTRY]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.SLACK]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.SUPABASE]: INTEGRATION_STATUS.UNAVAILABLE,
+  [INTEGRATION_PROVIDER.VERCEL]: INTEGRATION_STATUS.CONNECTED,
+  [INTEGRATION_PROVIDER.YCOMBINATOR]: INTEGRATION_STATUS.DISCONNECTED,
+  [INTEGRATION_PROVIDER.EXECUTOR]: INTEGRATION_STATUS.CONNECTED,
+};
+
+/** The servers this agent has switched off: PostHog, which an invite flow has no use for. */
+const AGENT_OFF: readonly IntegrationProvider[] = [INTEGRATION_PROVIDER.POSTHOG];
+
+/** One connected server's tools, the same lists the Integrations shot counts; nothing for a server not connected. */
+function toolsOf(provider: IntegrationProvider): IntegrationToolsView | undefined {
+  if (STANDING[provider] !== INTEGRATION_STATUS.CONNECTED) return undefined;
+  return { tools: [...SHOT_INTEGRATION_TOOLS[provider]] };
+}
+
+/** What the finished agent's context held as its last step ended: a fifth of Opus's window. */
+function agentContext(): CodingAgentContext {
+  return {
+    windowTokens: 1_000_000,
+    compactionThresholdTokens: 800_000,
+    inputTokens: 208_640,
+    outputTokens: 1_920,
+    cachedInputTokens: 196_480,
+    estimated: { systemPromptTokens: 9_840, toolDefinitionTokens: 21_300, briefTokens: 6_120 },
+    measuredAt: ago(12),
+  };
+}
+
+/** The plan's agents, the finished one with PostHog switched off. */
+function agentList(): CodingAgentListAnswer {
+  return {
+    agents: shotAgents().map((agent) =>
+      agent.id === SHOT_ID.AGENT ? { ...agent, disabledServers: AGENT_OFF } : agent,
+    ),
+  };
+}
+
+/** The shared answers, the list carrying this agent's switches and the finished agent's pages its context. */
+function mcpAnswers(): ShotAnswers {
+  const shared = codingAgentAnswers();
+  const list = agentList();
+  const context = agentContext();
+  return {
+    ...shared,
+    [ACT_KIND.CODING_AGENTS_LIST]: (payload) =>
+      payload.planId === SHOT_ID.PLAN ? list : { agents: [] },
+    [ACT_KIND.CODING_AGENTS_MESSAGES]: (payload) => {
+      const page = shared[ACT_KIND.CODING_AGENTS_MESSAGES]?.(payload);
+      if (page === undefined || page === NEVER || "failure" in page) return page;
+      if (payload.agentId !== SHOT_ID.AGENT || payload.callId !== undefined) return page;
+      const withContext: CodingAgentMessagesAnswerView = { ...page, context };
+      return withContext;
+    },
+    // Note that both reads are asked once per focus of the window, never in a loop, so each is answered every time.
+    [ACT_KIND.INTEGRATIONS_STATUS]: () => ({ integrations: { ...STANDING } }),
+    [ACT_KIND.INTEGRATIONS_TOOLS]: (payload) => toolsOf(payload.provider),
+  };
+}
+
+/** The MCP button at the finished agent's box, once the tab is drawn: a line of its transcript, its editor, and its foot. */
+function mcpButton(): HTMLButtonElement | undefined {
+  const tab = document.querySelector(".agent-tab");
+  const log = tab?.querySelector('[role="log"]');
+  if (tab === null || tab === undefined || log === null || log === undefined) return undefined;
+  if (log.childElementCount === 0) return undefined;
+  if (tab.querySelector('.agent-composer [contenteditable="true"]') === null) return undefined;
+  return tab.querySelector<HTMLButtonElement>(".agent-composer .agent-servers-button") ?? undefined;
+}
+
+/** How long the tab is left to settle once drawn before the press, so the popover is placed against the box as it stands. */
+const SETTLE_MS = 1_200;
+
+/** How many times the press is made at most, should a redraw of the tab ever take the popover with it. */
+const MOST_PRESSES = 3;
+
+/**
+ * Presses the MCP button once the agent's tab is drawn whole, and again
+ * should a redraw take the popover away, up to {@link MOST_PRESSES} times.
+ * Note that the press is a click and never a pointer's hover, so the
+ * button's tooltip never shows over the popover.
+ */
+const OPEN_POPOVER: ShotStep = {
+  key: "mcp-open-popover",
+  ready: () => true,
+  run: () => {
+    let presses = 0;
+    let waiting = false;
+    const check = () => {
+      if (waiting || presses >= MOST_PRESSES) return;
+      const button = mcpButton();
+      if (button === undefined || button.getAttribute("aria-expanded") === "true") return;
+      waiting = true;
+      window.setTimeout(() => {
+        waiting = false;
+        const settled = mcpButton();
+        if (settled === undefined || settled.getAttribute("aria-expanded") === "true") return;
+        presses += 1;
+        settled.click();
+      }, SETTLE_MS);
+    };
+    new MutationObserver(check).observe(document.body, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ["aria-expanded"],
+    });
+    check();
+  },
+};
+
+export function mcpShot(): ShotSpec {
+  return {
+    planning: shotPlanningView({}),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: mcpAnswers(),
+    layout: { sidebarCollapsed: true, mainTab: { agent: SHOT_ID.AGENT } },
+    steps: [OPEN_POPOVER],
+  };
+}
