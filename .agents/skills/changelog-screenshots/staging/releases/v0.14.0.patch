@@ -0,0 +1,101 @@
+/**
+ * mentions-world.ts -- acme/relay as the @-mentions shot reads it: its tree at main and the skills it keeps under `.agents/skills/`.
+ *
+ * Throwaway (`README.md`). The repository WORLD.md describes: TypeScript on
+ * Postgres with Drizzle (`src/db/schema/`), Hono routes (`src/routes/`),
+ * React Email templates sent through Postmark (`src/mail/templates/`), and
+ * vitest beside the code it tests. Every path and line is invented.
+ */
+
+import {
+  PLAN_TREE_ENTRY,
+  type PlanTreeEntry,
+  type planSkillSchema,
+} from "@luke/features/plan-wire";
+
+/** One skill as the service reads it. */
+type PlanSkill = typeof planSkillSchema.Type;
+
+/**
+ * The repository's files at main, by path from its root; every folder they
+ * stand in is listed from them. Note that `.agents/skills/` is left out,
+ * since the list's Skills group already offers each skill and its folder
+ * would only offer it twice, and that #214's own files are listed though
+ * unmerged, as the box's chip names one, all but its migration, so a
+ * migration's word finds the one migration main holds.
+ */
+const RELAY_FILES = [
+  ".github/workflows/ci.yml",
+  ".github/workflows/deploy.yml",
+  "AGENTS.md",
+  "README.md",
+  "drizzle.config.ts",
+  "package.json",
+  "pnpm-lock.yaml",
+  "tsconfig.json",
+  "vitest.config.ts",
+  "src/app.ts",
+  "src/index.ts",
+  "src/auth/session.ts",
+  "src/auth/workspace-access.ts",
+  "src/billing/seats.ts",
+  "src/db/client.ts",
+  "src/db/migrations/20260921_webhook_deliveries.sql",
+  "src/db/schema/index.ts",
+  "src/db/schema/memberships.ts",
+  "src/db/schema/users.ts",
+  "src/db/schema/webhooks.ts",
+  "src/db/schema/workspaces.ts",
+  "src/lib/config.ts",
+  "src/lib/tokens.ts",
+  "src/mail/client.ts",
+  "src/mail/templates/invite.tsx",
+  "src/mail/templates/password-reset.tsx",
+  "src/mail/templates/welcome.tsx",
+  "src/members/accept.test.ts",
+  "src/members/accept.ts",
+  "src/members/invite.test.ts",
+  "src/members/invite.ts",
+  "src/members/list.ts",
+  "src/members/remove.test.ts",
+  "src/members/remove.ts",
+  "src/routes/index.ts",
+  "src/routes/invites.ts",
+  "src/routes/members.ts",
+  "src/routes/webhooks.ts",
+  "src/routes/workspaces.ts",
+  "src/webhooks/deliver.ts",
+  "src/webhooks/retry.ts",
+] as const;
+
+/** The repository's whole tree as one recursive listing answers it: each folder, then each file, by path. */
+export function relayTree(): PlanTreeEntry[] {
+  const folders = new Set<string>();
+  for (const file of RELAY_FILES) {
+    const steps = file.split("/");
+    for (let depth = 1; depth < steps.length; depth += 1) {
+      folders.add(steps.slice(0, depth).join("/"));
+    }
+  }
+  return [
+    ...[...folders].sort().map((name) => ({ name, kind: PLAN_TREE_ENTRY.FOLDER })),
+    ...RELAY_FILES.map((name) => ({ name, kind: PLAN_TREE_ENTRY.FILE })),
+  ];
+}
+
+/** One skill as its `SKILL.md` front matter names it. */
+function skill(name: string, description: string): PlanSkill {
+  return { name, description, path: `.agents/skills/${name}/SKILL.md` };
+}
+
+/** The skills acme/relay keeps, as the service reads their front matter. */
+export function relaySkills(): PlanSkill[] {
+  return [
+    skill("api-routes", "Add or change a Hono route under src/routes, with its schema and tests."),
+    skill("db-migrations", "Write a Drizzle migration for a schema change, and backfill old rows."),
+    skill("drizzle", "Drizzle tables, queries, and relations under src/db/schema."),
+    skill("email-templates", "Write a React Email template and send it through Postmark."),
+    skill("release", "Cut a release: the changelog, the version, and the deploy."),
+    skill("testing", "Write vitest tests beside the code and run them with pnpm test."),
+  ];
+}
