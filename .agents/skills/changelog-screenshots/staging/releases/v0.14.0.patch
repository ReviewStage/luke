+].join("\n");
+
+const TEST_OUTPUT = [
+  " RUN  v3.2.4 /workspace/repository",
+  "",
+  " ✓ src/members/invite.test.ts (6 tests) 412ms",
+  " ✓ src/members/accept.test.ts (4 tests) 298ms",
