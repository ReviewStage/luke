+].join("\n");
+
+/** The finished agent's transcript: its brief, then the one turn that did the work. */
+export function shotAgentMessages(): CodingAgentMessage[] {
+  return [
+    {
+      id: "m-plan",
+      role: "user",
+      parts: [{ type: "text", text: `# ${PLAN_NAME}\n\n${SHOT_DOCUMENT_TEXT}` }],
+    },
+    {
