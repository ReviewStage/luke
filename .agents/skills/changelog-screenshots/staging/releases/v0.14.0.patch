@@ -0,0 +1,283 @@
+/**
+ * mentions.ts -- shot "@-mentions": the finished agent's message box with the @ list held open over it, offering a folder and a file, a section of the plan, a skill, and an MCP server's tools.
+ *
+ * Throwaway (`README.md`). See `.context/shots/SPEC.md` for what it must show.
+ * The plan "Teammate invitations" opens on its finished agent "Add teammate
+ * invitations" in the plan's column (in this release an agent's tab is the
+ * plan's column's, never the side panel's), the sidebar open on acme's plans
+ * and the side panel closed, its
+ * transcript the shared one (`coding-agent.ts`) above the box. A step lays
+ * the words into the box through its own editor once the tab is drawn:
+ * "Add an expires_at column to", a chip of `src/db/schema/memberships.ts`,
+ * then "and write its @migr" with the caret at its end, which is how the
+ * editor reports the `@` word and how the release's own list
+ * (`planning/mention-picker.tsx`) opens over it.
+ *
+ * The query is chosen so every group the list has stands whole inside its
+ * 320px list, six rows under four headings, its foot below: "migr" finds, in
+ * the list's own scoring (cmdk's filter, the best four of each kind),
+ * `src/db/migrations/` and the one migration main holds under Files and
+ * folders, the plan's Migration section under Plan, the `db-migrations`
+ * skill under Skills, and Neon's `prepare_database_migration` and
+ * `complete_database_migration` under MCP servers. The shot's plan is the
+ * shared one with a Migration section after its Plan of attack, which the
+ * document never shows here, since the column draws the agent. Granola and
+ * Supabase stand as this deployment not offering them, as in the MCP
+ * popover's shot, so Supabase's two migration tools and Granola's meetings
+ * (which "migr" reaches loosely) do not push Neon's below the fold; the
+ * other ten servers stand connected. The list's reads are answered here: the
+ * repository's tree and skills (`mentions-world.ts`), the servers' statuses,
+ * and each server's tools (`integrations-tools.ts`); none is asked in a
+ * loop, so each is answered every time.
+ */
+
+import type { CodingAgentMessagesAnswerView } from "@luke/features/coding-agent-view";
+import type { CodingAgentContext } from "@luke/features/coding-agent-wire";
+import type {
+  IntegrationStatusesView,
+  IntegrationToolsView,
+} from "@luke/features/integration-view";
+import {
+  INTEGRATION_PROVIDER,
+  INTEGRATION_PROVIDER_LIST,
+  INTEGRATION_STATUS,
+  type IntegrationProvider,
+  type IntegrationStatus,
+} from "@luke/features/integration-wire";
+import { encodeMention, MENTION_KIND } from "@luke/features/mention-link";
+import type { Plan } from "@luke/features/plan-wire";
+import type { PlanningSkillsAnswer, PlanningTreeAnswer } from "@luke/features/planning-view";
+import { ACT_KIND } from "@luke/host/acts";
+import type { TiptapEditorHTMLElement } from "@tiptap/core";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago } from "./clock";
+import { codingAgentAnswers } from "./coding-agent";
+import { SHOT_INTEGRATION_TOOLS } from "./integrations-tools";
+import { relaySkills, relayTree } from "./mentions-world";
+import {
+  documentText,
+  PLAN_REPOSITORY,
+  SHOT_HEADINGS,
+  SHOT_ID,
+  SHOT_SECTIONS,
+  type ShotHeading,
+  type ShotSections,
+  shotPlan,
+  shotPlanningView,
+} from "./plan-document";
+import { NEVER, type ShotAnswers, type ShotSpec, type ShotStep } from "./shot-spec";
+
+/** The branch the repository's tree and skills are read at. */
+const BRANCH = "main";
+
+/** The file the box's chip names: the memberships table's schema. */
+const CHIP_PATH = "src/db/schema/memberships.ts";
+
+/** The box's words: before the chip, the chip's name, and after it up to the caret, the `@` word last. */
+export const SHOT_WORDS = {
+  BEFORE: "Add an expires_at column to ",
+  CHIP: "memberships.ts",
+  AFTER: " and write its @migr",
+} as const;
+
+/** How long the tab is left to settle once drawn before the words go in, so the list is placed against the box as it stands. */
+const SETTLE_MS = 1_200;
+
+/** When the `@` word is found again after the words went in, so a layout that moved since places the list anew. */
+const REPORT_AGAIN_MS = [800, 2_000, 4_000] as const;
+
+/** How many times the words are laid in at most, should a redraw of the tab ever take the box with them. */
+const MOST_TYPINGS = 3;
+
+/** The servers this deployment does not offer: Granola and Supabase, as in the MCP popover's shot, and Executor, which is no integration of the twelve. */
+const NOT_OFFERED: ReadonlySet<IntegrationProvider> = new Set([
+  INTEGRATION_PROVIDER.EXECUTOR,
+  INTEGRATION_PROVIDER.GRANOLA,
+  INTEGRATION_PROVIDER.SUPABASE,
+]);
+
+/** The heading the shot's plan adds after its Plan of attack, and what it says. */
+const MIGRATION_SECTION = {
+  HEADING: "Migration",
+  TEXT:
+    "- One migration, `src/db/migrations/20261013_memberships_state.sql`: `state` defaults to " +
+    "`active`, so every existing row reads as a member, and `invite_token` is unique.\n" +
+    "- Prepared on a Neon branch first, then completed on main once `pnpm test src/members` passes.",
+} as const;
+
+/** The shared plan with a Migration section after its Plan of attack, which the `@` list offers as a section. */
+function migrationPlan(): Plan {
+  const after = SHOT_HEADINGS.indexOf("Plan of attack") + 1;
+  const pick = (headings: readonly ShotHeading[]): ShotSections =>
+    Object.fromEntries(headings.map((heading) => [heading, SHOT_SECTIONS[heading]]));
+  const body = [
+    documentText(pick(SHOT_HEADINGS.slice(0, after))),
+    `## ${MIGRATION_SECTION.HEADING}`,
+    MIGRATION_SECTION.TEXT,
+    documentText(pick(SHOT_HEADINGS.slice(after))),
+  ].join("\n\n");
+  return shotPlan({ document: { body: `${body}\n`, assumptions: [] } });
+}
+
+/** Every server this release offers connected, but those this deployment does not offer. */
+function statuses(): IntegrationStatusesView {
+  // SAFETY: the entries are built from INTEGRATION_PROVIDER_LIST, so every provider is a key.
+  const integrations = Object.fromEntries(
+    INTEGRATION_PROVIDER_LIST.map((provider) => [
+      provider,
+      NOT_OFFERED.has(provider) ? INTEGRATION_STATUS.UNAVAILABLE : INTEGRATION_STATUS.CONNECTED,
+    ]),
+  ) as Record<IntegrationProvider, IntegrationStatus>;
+  return { integrations };
+}
+
+/** One server's tools, the lists the Integrations shot counts. */
+function toolsOf(provider: IntegrationProvider): IntegrationToolsView {
+  return { tools: [...SHOT_INTEGRATION_TOOLS[provider]] };
+}
+
+/** What the finished agent's context held as its last step ended, so the ring draws in the box's foot. */
+function agentContext(): CodingAgentContext {
+  return {
+    windowTokens: 1_000_000,
+    compactionThresholdTokens: 800_000,
+    inputTokens: 208_640,
+    outputTokens: 1_920,
+    cachedInputTokens: 196_480,
+    estimated: { systemPromptTokens: 9_840, toolDefinitionTokens: 21_300, briefTokens: 6_120 },
+    measuredAt: ago(12),
+  };
+}
+
+/** The repository's whole tree, as the `@` list reads it once for the plan; nothing for another folder. */
+function treeAnswer(path: string, recursive: boolean | undefined): PlanningTreeAnswer | undefined {
+  if (path !== "" || recursive !== true) return undefined;
+  return {
+    folder: {
+      path: "",
+      repository: PLAN_REPOSITORY,
+      branch: BRANCH,
+      entries: relayTree(),
+      truncated: false,
+    },
+  };
+}
+
+/** The shared answers, the list's four reads, and the finished agent's pages carrying its context. */
+function mentionsAnswers(): ShotAnswers {
+  const shared = codingAgentAnswers();
+  const context = agentContext();
+  const skills: PlanningSkillsAnswer = {
+    skills: { repository: PLAN_REPOSITORY, branch: BRANCH, skills: relaySkills() },
+  };
+  const standing = statuses();
+  return {
+    ...shared,
+    [ACT_KIND.CODING_AGENTS_MESSAGES]: (payload) => {
+      const page = shared[ACT_KIND.CODING_AGENTS_MESSAGES]?.(payload);
+      if (page === undefined || page === NEVER || "failure" in page) return page;
+      if (payload.agentId !== SHOT_ID.AGENT || payload.callId !== undefined) return page;
+      const withContext: CodingAgentMessagesAnswerView = { ...page, context };
+      return withContext;
+    },
+    [ACT_KIND.PLANNING_TREE]: (payload) =>
+      payload.planId === SHOT_ID.PLAN ? treeAnswer(payload.path, payload.recursive) : undefined,
+    [ACT_KIND.PLANNING_SKILLS]: (payload) => (payload.planId === SHOT_ID.PLAN ? skills : undefined),
+    // Note that both reads are asked once per focus of the window or opening of the list, never in a loop.
+    [ACT_KIND.INTEGRATIONS_STATUS]: () => standing,
+    [ACT_KIND.INTEGRATIONS_TOOLS]: (payload) => toolsOf(payload.provider),
+  };
+}
+
+/** The finished agent's box's editor, once the tab is drawn: a line of its transcript, and the editor running. */
+function boxEditor(): TiptapEditorHTMLElement | undefined {
+  const tab = document.querySelector(".agent-tab");
+  const log = tab?.querySelector('[role="log"]');
+  if (tab === null || tab === undefined || log === null || log === undefined) return undefined;
+  if (log.childElementCount === 0) return undefined;
+  const element = tab.querySelector<TiptapEditorHTMLElement>(".agent-composer .composer-editor");
+  return element?.editor === undefined ? undefined : element;
+}
+
+/**
+ * The box's words laid in through its own editor, the chip a mention node
+ * as a pick writes it, the caret at the end of the `@` word and the editor
+ * focused, which is what reports the word to the box and opens its list.
+ */
+export function layInWords(element: TiptapEditorHTMLElement): void {
+  const editor = element.editor;
+  if (editor === undefined) return;
+  const target = encodeMention(
+    { kind: MENTION_KIND.FILE, path: CHIP_PATH },
+    { workspace: "acme", repository: PLAN_REPOSITORY },
+  );
+  editor.commands.setContent({
+    type: "doc",
+    content: [
+      {
+        type: "paragraph",
+        content: [
+          { type: "text", text: SHOT_WORDS.BEFORE },
+          { type: "mention", attrs: { name: SHOT_WORDS.CHIP, target } },
+          { type: "text", text: SHOT_WORDS.AFTER },
+        ],
+      },
+    ],
+  });
+  editor.commands.setTextSelection(editor.state.doc.content.size - 1);
+  editor.view.focus();
+}
+
+/**
+ * The `@` word found again where it stands now: a transaction that changes
+ * nothing, which the editor reports on, or, should something have taken the
+ * caret meanwhile, the box focused again, which reports it as well.
+ */
+function reportAgain(): void {
+  const editor = boxEditor()?.editor;
+  if (editor === undefined) return;
+  if (editor.view.hasFocus()) editor.view.dispatch(editor.state.tr);
+  else editor.view.focus();
+}
+
+/**
+ * Lays the words in once the agent's tab is drawn whole, and again should
+ * a redraw take the box with them, up to {@link MOST_TYPINGS} times. Note
+ * that the words are laid in through the editor rather than typed as keys,
+ * so no key reaches the window's own shortcuts.
+ */
+const TYPE_MENTION: ShotStep = {
+  key: "mentions-type",
+  ready: () => true,
+  run: () => {
+    let typings = 0;
+    let waiting = false;
+    const check = () => {
+      if (waiting || typings >= MOST_TYPINGS) return;
+      const element = boxEditor();
+      if (element === undefined || element.editor?.getText().includes(SHOT_WORDS.BEFORE.trim()))
+        return;
+      waiting = true;
+      window.setTimeout(() => {
+        waiting = false;
+        const settled = boxEditor();
+        if (settled === undefined) return;
+        typings += 1;
+        layInWords(settled);
+        for (const after of REPORT_AGAIN_MS) window.setTimeout(reportAgain, after);
+      }, SETTLE_MS);
+    };
+    new MutationObserver(check).observe(document.body, { childList: true, subtree: true });
+    check();
+  },
+};
+
+export function mentionsShot(): ShotSpec {
+  return {
+    planning: shotPlanningView({ plan: migrationPlan() }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: mentionsAnswers(),
+    layout: { sidebarCollapsed: false, mainTab: { agent: SHOT_ID.AGENT } },
+    steps: [TYPE_MENTION],
+  };
+}
