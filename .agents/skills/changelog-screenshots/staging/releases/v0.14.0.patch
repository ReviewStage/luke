+  ];
+}
+
+/** The plan's two agents, in the order started: the finished one, then the one at work. */
+export function shotAgents(): CodingAgentSummary[] {
+  return [
+    {
+      id: SHOT_ID.AGENT,
+      planId: SHOT_ID.PLAN,
+      model: MODEL.OPUS,
