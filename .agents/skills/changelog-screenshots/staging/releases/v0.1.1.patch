+};
+
+/**
+ * Dean's Google calendars as Google lists them, in Google's own colours. His
+ * own and acme engineering's meetings count; the holidays calendar holds no
+ * meetings, so it is left out.
+ */
+const CALENDAR = {
+  DEAN: { id: DEAN_EMAIL, label: "Dean Stratakos", color: "#039be5" },
+  ENGINEERING: {
+    id: "c_acme-engineering@group.calendar.google.com",
+    label: "acme engineering",
+    color: "#33b679",
+  },
+  HOLIDAYS: {
+    id: "en.usa#holiday@group.v.calendar.google.com",
+    label: "Holidays in United States",
+    color: "#0b8043",
+  },
+} as const;
+
+const shotCalendarList: readonly ObservedAccountCalendars[] = [
+  {
+    accountId: DEAN_EMAIL,
+    calendars: [CALENDAR.DEAN, CALENDAR.ENGINEERING, CALENDAR.HOLIDAYS],
+  },
+];
+
+/** Whether this run stages a shot: fixture mode and one of the shot profiles. */
+export function isShotRun(fixtureMode: boolean, profile: string | undefined): boolean {
+  return fixtureMode && profile !== undefined && SHOT_PROFILE_LIST.includes(profile);
+}
+
+/** The roster a shot run draws in place of the smoke fixture's. */
+export function shotFixture(): FixtureSnapshot {
+  return acmeFixture;
+}
+
+/** The signed-in account a shot run bootstraps with. */
+export function shotAccountSnapshot(): AccountSnapshot {
+  return shotAccount;
+}
+
+/** A shot's Mac has granted the microphone, so the Voice row wears no mark. */
+export const SHOT_MICROPHONE_STATUS: MicrophoneStatus = "granted";
+
+/** A shot's build has checked and is current, so the Updates row says so. */
+export function shotUpdate(update: UpdateSnapshot): UpdateSnapshot {
+  return { status: UPDATE_STATUS.UP_TO_DATE, currentVersion: update.currentVersion };
+}
+
+/** The calendars Dean's Google account offered on the latest pass. */
+export function shotCalendars(profile: string): readonly ObservedAccountCalendars[] {
+  return profile === SHOT_PROFILE.CALENDAR ? shotCalendarList : [];
+}
+
+/**
+ * The settings a signed-in Mac with its keys stored would resolve to: every
+ * provider's key kept in the Keychain (agents, Linear, and OpenAI alike, so
+ * every row on Connections reads connected), voice available, and the account's
+ * allowance the chosen source over the stored key. `shot-calendar` adds the
+ * calendar sign-in this build would carry, Dean's account with its counted
+ * calendars, and the quiet switch on.
+ */
+export function shotSettings(settings: AppSettings, profile: string): AppSettings {
+  const stored = Object.fromEntries(
+    Object.keys(settings.credentialSources).map((id) => [id, CREDENTIAL_SOURCE.ENCRYPTED_FILE]),
+  ) as Record<CredentialProviderId, CredentialSource>;
+  const staged: AppSettings = {
+    ...settings,
+    credentialSources: stored,
+    secretStorage: SECRET_STORAGE.AVAILABLE,
+    voiceAvailable: true,
+    voiceSource: VOICE_SOURCE.ACCOUNT,
+  };
+  if (profile !== SHOT_PROFILE.CALENDAR) return staged;
+  return {
+    ...staged,
+    calendarSignInAvailable: true,
+    calendarAccounts: [
+      { id: DEAN_EMAIL, selectedCalendarIds: [CALENDAR.DEAN.id, CALENDAR.ENGINEERING.id] },
+    ],
+    quietDuringMeetings: true,
+  };
+}
+
+/**
+ * Today's allowance, partly spent with plenty left on both meters, resetting
+ * where the service resets it: the end of the UTC day in hand.
+ */
+export function shotHostedUsage(now: number): HostedUsageAnswer {
+  const day = new Date(now);
+  const resetsAt = Date.UTC(day.getUTCFullYear(), day.getUTCMonth(), day.getUTCDate() + 1);
+  return {
+    voice: { used: 13, limit: 50, remaining: 37, resetsAt },
+    attention: { used: 178, limit: 500, remaining: 322, resetsAt },
+  };
+}
+
+/**
+ * Scrolls the open Settings page so the shot's card leads it. The allowance
+ * already leads the front page; the calendar's Integrations section is found
+ * by its Google row and brought to the top of the page's scroll.
+ */
+export function scrollShotCard(profile: string): void {
+  if (profile !== SHOT_PROFILE.CALENDAR) return;
+  const page = document.querySelector<HTMLElement>(".settings");
+  const card = page
+    ?.querySelector('[aria-label="Add another Google account"]')
+    ?.closest<HTMLElement>(".settings-section");
+  if (!page || !card) return;
+  page.scrollTop += card.getBoundingClientRect().top - page.getBoundingClientRect().top;
+}
