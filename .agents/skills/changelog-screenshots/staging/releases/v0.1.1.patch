+// shots.ts -- Throwaway: the changelog screenshots staged for 0.1.1, never committed.
+//
+// Two profiles, each run as
+// `--fixture smoke --expanded --profile shot-<name> --capture-evidence <png>`
+// and each opening the expanded panel on Settings, signed in as Dean Stratakos:
+//
+// - `shot-allowance`: the front page, led by "What Luke runs on" with the
+//   included daily allowance chosen over a stored OpenAI key and both of the
+//   day's meters partly spent.
+// - `shot-calendar`: the Connections page scrolled to Integrations, Google
+//   Calendar connected as dean@example.com with two of its calendars counted
+//   and "Quiet during meetings" on.
+//
+// A fixture run is signed out, refuses every credential, carries no calendar
+// sign-in, and reads no allowance, so the shot stages the account, the settings
+// snapshot, the usage read, and the calendar list itself. Every hook is gated
+// on `isShotRun` (fixture mode and one of these profiles) at its call site.
+
+import {
+  FIXTURE_EPOCH_MS,
+  type FixtureSnapshot,
+  type HostedUsageAnswer,
+  PROVIDER_ID,
+  SESSION_CONTROL_KIND,
+  SESSION_LOCATION,
+  SESSION_URGENCY,
+} from "@sidecar/core";
+import {
+  ACCOUNT_PROVIDER,
+  ACCOUNT_STATUS,
+  type AccountSnapshot,
+  type AppSettings,
+  CREDENTIAL_SOURCE,
+  type CredentialSource,
+  type MicrophoneStatus,
+  type ObservedAccountCalendars,
+  SECRET_STORAGE,
+  UPDATE_STATUS,
+  type UpdateSnapshot,
+  VOICE_SOURCE,
+} from "./contracts";
+import { type CredentialProviderId } from "./credential-providers";
+import { DEAN_AVATAR_DATA_URL } from "./dean-avatar";
+
+export const SHOT_PROFILE = {
+  ALLOWANCE: "shot-allowance",
+  CALENDAR: "shot-calendar",
+} as const;
+
+export type ShotProfile = (typeof SHOT_PROFILE)[keyof typeof SHOT_PROFILE];
+
+const SHOT_PROFILE_LIST: readonly string[] = Object.values(SHOT_PROFILE);
+
+/** How long a shot's capture waits after the window reports ready. */
+export const SHOT_CAPTURE_SETTLE_MS = 3_000;
+
+/** How long after the bootstrap the renderer scrolls the page to its card. */
+export const SHOT_SCROLL_DELAY_MS = 800;
+
+/** The address Dean signs in with, and the Google account his calendar is on. */
+const DEAN_EMAIL = "dean@example.com";
+
+/** The account the shots are signed in as: Dean, with his GitHub photo. */
+const shotAccount: AccountSnapshot = {
+  status: ACCOUNT_STATUS.SIGNED_IN,
+  email: DEAN_EMAIL,
+  name: "Dean Stratakos",
+  pictureUrl: DEAN_AVATAR_DATA_URL,
+  provider: ACCOUNT_PROVIDER.GITHUB,
+};
+
+const CLAUDE_MODEL = "claude-opus-5";
+const CODEX_MODEL = "gpt-5.6-luna";
+
+function minutesAgo(minutes: number): number {
+  return FIXTURE_EPOCH_MS - minutes * 60_000;
+}
+
+/**
+ * 0.1.0's acme roster (its `shot-one-panel`), carried over so the wings across
+ * the panel's top count acme's agents rather than the smoke fixture's. Nine
+ * sessions on acme's work, each worded the way its provider reports it at
+ * 0.1.0: Claude Code and Codex name the tool they run or their parting words,
+ * Cursor its run's result, while Jules and Copilot title a row by its
+ * repository and say nothing (the row states its own state), and the cloud
+ * titles a lone chat by its workspace. Controls are the ones each adapter
+ * advertises in that state. Ages are minutes before the fixture's own epoch,
+ * which is the clock fixture rows are read against.
+ */
+const acmeFixture: FixtureSnapshot = {
