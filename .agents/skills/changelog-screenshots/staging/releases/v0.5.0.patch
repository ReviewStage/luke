diff --git a/apps/desktop/src/shared/shots.ts b/apps/desktop/src/shared/shots.ts
new file mode 100644
index 000000000..b88965eaf
--- /dev/null
+++ b/apps/desktop/src/shared/shots.ts
@@ -0,0 +1,69 @@
+/**
+ * shots.ts -- Throwaway: the changelog screenshot staging for 0.5.0, never
+ * committed. One profile, `shot-calendar-gate`, staged only in fixture mode:
+ * the expanded panel standing on onboarding's calendar gate (this Mac's
+ * Calendar or Google), Luke speaking the gate's own beat with its caption at
+ * the panel's foot, captured by `--capture-evidence`.
+ */
+
+export const SHOT_PROFILE = {
+  CALENDAR_GATE: "shot-calendar-gate",
+} as const;
+
+export type ShotProfile = (typeof SHOT_PROFILE)[keyof typeof SHOT_PROFILE];
+
+/**
+ * How long a shot's capture waits after its window reports ready, so the
+ * panel's measured height and every async draw have landed (the tag waits
+ * 350 ms).
+ */
+export const SHOT_CAPTURE_SETTLE_MS = 3_000;
+
+/**
+ * The caption the calendar onboarding beat draws: its script is fixed by the
+ * build (`CALENDAR_ONBOARDING_SPEECH_HEAD`: one short sentence "to the effect
+ * of: 'Connect your calendar so I don't talk during your meetings.'"), and
+ * the caption is that reply's transcript, one segment.
+ */
+export const SHOT_CALENDAR_GATE_CAPTIONS: readonly string[] = [
+  "Connect your calendar so I don't talk during your meetings.",
+];
+
+/** Whether this run stages the calendar gate shot: its profile, in fixture mode only. */
+export function stagesCalendarGateShot(input: { fixtureMode: boolean; profile: string }): boolean {
+  return input.fixtureMode && input.profile === SHOT_PROFILE.CALENDAR_GATE;
+}
+
+/** Whether this run stages any shot, for the capture's longer settle. */
+export function stagesShot(input: { fixtureMode: boolean; profile: string }): boolean {
+  return input.fixtureMode && input.profile.startsWith("shot-");
+}
+
+/**
+ * The settings the gate is drawn from, with both sources offered for the
+ * shot. A fixture run refuses credentials, so the store reports neither the
+ * Apple Calendar connection nor the Google sign-in as available, and a gate
+ * offered no source is never drawn; a signed-in 0.5.0 on a Mac with the
+ * release's OAuth client offers both.
+ */
+export function stagedCalendarGateSettings<
+  T extends { appleCalendarAvailable: boolean; calendarSignInAvailable: boolean },
+>(settings: T, staged: boolean): T {
+  if (!staged) return settings;
+  return { ...settings, appleCalendarAvailable: true, calendarSignInAvailable: true };
+}
+
+/**
+ * The state directory a shot run asked for with Chromium's `--user-data-dir`
+ * (either `--user-data-dir=<dir>` or `--user-data-dir <dir>`): 0.5.0 points
+ * `userData` at appData/<appName> by hand, which would share a running
+ * Luke's state and single-instance lock.
+ */
+export function requestedUserDataDirectory(argv: readonly string[]): string | undefined {
+  const flag = "--user-data-dir";
+  for (const [index, argument] of argv.entries()) {
+    if (argument.startsWith(`${flag}=`)) return argument.slice(flag.length + 1) || undefined;
+    if (argument === flag) return argv[index + 1];
+  }
+  return undefined;
+}
