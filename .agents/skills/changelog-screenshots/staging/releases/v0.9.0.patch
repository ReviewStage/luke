@@ -0,0 +1,29 @@
+/**
+ * account.ts -- the account the shot is signed in as: Dean Stratakos, with his GitHub photo.
+ *
+ * Throwaway: the 0.9.0 changelog screenshot's staging, applied on a Mac to
+ * the release commit and never committed. A fixture run signs in to
+ * nothing, so the sidebar's foot would read "Settings" under a blank face;
+ * the shot draws this account in its place.
+ */
+
+import { ACCOUNT_PROVIDER, ACCOUNT_STATUS, type AccountSnapshot } from "@sidecar/credentials/snapshot";
+import { DEAN_AVATAR_DATA_URL } from "./dean-avatar";
+import { isShotRun } from "./work";
+
+/** The account, built once, so a render reads the same object each time. */
+const SHOT_ACCOUNT: AccountSnapshot = {
+  status: ACCOUNT_STATUS.SIGNED_IN,
+  name: "Dean Stratakos",
+  email: "dean@example.com",
+  provider: ACCOUNT_PROVIDER.GITHUB,
+  pictureUrl: DEAN_AVATAR_DATA_URL,
+};
+
+/** The account the window draws: Dean's under the shot profile, else the one main holds. */
+export function shotAccount(
+  run: { readonly fixtureMode: boolean; readonly profile: string },
+  account: AccountSnapshot,
+): AccountSnapshot {
+  return isShotRun(run) ? SHOT_ACCOUNT : account;
+}
