@@ -0,0 +1,228 @@
+/**
+ * work.ts -- the "A Work tab for what Luke thought and ran" shot: the open plan's Work tab, wide, on two planning turns.
+ *
+ * Throwaway: the 0.9.0 changelog screenshot's staging, applied on a Mac to
+ * the release commit and never committed. Run as
+ * `electron . --user-data-dir=<tmp> --fixture smoke --profile shot-work`.
+ *
+ * It builds on the planning-work profile: the same plan, mid-call, opened on
+ * the Work tab, with the call's status row at the foot of the document
+ * column, outside the close-up. What it changes is the work and the times.
+ * An earlier turn, finished minutes ago, folds to its answer; the turn
+ * standing now, started seconds before launch, shows its thought (opened by
+ * the hook in plan-work.tsx), the worker it handed a library comparison to,
+ * what it said, and the two reads it is making, the last still running. The
+ * plan list is acme's (WORLD.md), every folder one of Dean's.
+ */
+
+import {
+  PLAN_WORK_PART,
+  PLAN_WORK_STATE,
+  PLAN_WORK_TOOL,
+  type PlanningView,
+  type PlanWorkTurn,
+} from "@sidecar/hosted/planning-view";
+import { RUN_PROFILE } from "#shared/messages/app-state";
+import { FIXTURE_OPEN_PLAN, FIXTURE_PLAN } from "../planning/planning-fixture";
+import {
+  SIDE_PANEL_TAB,
+  SIDE_PANEL_TABS,
+  type SidePanelState,
+} from "../planning/use-side-panel";
+import { ago, secondsAgo } from "./clock";
+
+type ShotRun = { readonly fixtureMode: boolean; readonly profile: string };
+
+/** The panel's width: wide enough that the thought and the calls read on one or two lines each. */
+const PANEL_WIDTH = 640;
+
+/** The command the standing turn is running, which the call's status row names too. */
+const RUNNING_COMMAND = `rg -n "state = 'pending'" src`;
+
+/** The invite module as `cat` printed it: the part the planning model reads for how an invite is stored and withdrawn. */
+const INVITE_SOURCE = [
+  'import { and, eq } from "drizzle-orm";',
+  'import { db } from "../db";',
+  'import { memberships } from "../db/schema/memberships";',
+  "",
+  "export async function createInvite(workspaceId: string, email: string, by: Member) {",
+  "  return db.insert(memberships).values({ workspaceId, email, invitedBy: by.id, state: \"pending\" });",
+  "}",
+  "",
+  "export async function withdrawInvite(invite: Membership, by: Member) {",
+  "  if (invite.invitedBy !== by.id) throw new InviteError(\"not-sender\");",
+  "  await db.delete(memberships).where(eq(memberships.id, invite.id));",
+  "}",
+].join("\n");
+
+/** A repository command of the shot's turns. */
+function command(id: string, line: string, output: string | undefined) {
+  return {
+    type: PLAN_WORK_PART.TOOL,
+    id,
+    tool: PLAN_WORK_TOOL.REPOSITORY,
+    name: "run_in_repository",
+    state: output === undefined ? PLAN_WORK_STATE.RUNNING : PLAN_WORK_STATE.DONE,
+    subject: line,
+    input: JSON.stringify({ command: line }, null, 2),
+    ...(output === undefined ? undefined : { output }),
+  } as const;
+}
+
+/**
+ * The two turns: one that read the members code and answered who may
+ * withdraw an invite today, and the one standing now on letting any admin.
+ * Synthetic throughout: no real repository, command output, or page.
+ */
+function shotTurns(): readonly PlanWorkTurn[] {
+  return [
+    {
+      turnId: "shot-turn-1",
+      startedAt: ago(9),
+      state: PLAN_WORK_STATE.DONE,
+      earlierOmitted: false,
+      parts: [
+        command("shot-call-1", "ls src/members", "invite.ts\nmembership.ts\nroles.ts"),
+        command(
+          "shot-call-2",
+          "rg -n withdraw src/members",
+          "src/members/invite.ts:9:export async function withdrawInvite(invite: Membership, by: Member) {",
+        ),
+        {
+          type: PLAN_WORK_PART.TEXT,
+          text: "Today only the member who sent an invite can withdraw it: `withdrawInvite` checks the sender and nothing else.",
+        },
+      ],
+    },
+    {
+      turnId: "shot-turn-2",
+      startedAt: secondsAgo(40),
+      state: PLAN_WORK_STATE.RUNNING,
+      earlierOmitted: false,
+      parts: [
+        {
+          type: PLAN_WORK_PART.REASONING,
+          text:
+            "Any admin should be able to withdraw a pending invite, not only the member who sent it. " +
+            "Before suggesting a library, check how an invite is stored and whether removing a member " +
+            "already has an admin check worth reusing. The library comparison can go to the worker, so " +
+            "the answer is not held up while it reads.",
+        },
+        {
+          type: PLAN_WORK_PART.TOOL,
+          id: "shot-call-3",
+          tool: PLAN_WORK_TOOL.WORKER,
+          name: "worker",
+          state: PLAN_WORK_STATE.DONE,
+          subject: "Compare how two invite libraries let an admin revoke a pending invite",
+          input: JSON.stringify(
+            { task: "Compare how two invite libraries let an admin revoke a pending invite" },
+            null,
+            2,
+          ),
+          output: "invite-kit lets any admin revoke a pending invite; invitely lets only its sender.",
+          session: {
+            earlierOmitted: false,
+            parts: [
+              {
+                type: PLAN_WORK_PART.TOOL,
+                id: "shot-worker-1",
+                tool: PLAN_WORK_TOOL.SEARCH_WEB,
+                name: "search_web",
+                state: PLAN_WORK_STATE.DONE,
+                subject: "invite library admin revoke pending invite",
+                input: JSON.stringify({ query: "invite library admin revoke pending invite" }, null, 2),
+                output: "invite-kit docs: Revoking invites\ninvitely API reference: Withdrawing an invite",
+              },
+              {
+                type: PLAN_WORK_PART.TOOL,
+                id: "shot-worker-2",
+                tool: PLAN_WORK_TOOL.READ_WEB_PAGE,
+                name: "read_web_page",
+                state: PLAN_WORK_STATE.DONE,
+                subject: "https://invite-kit.dev/docs/revoking",
+                input: JSON.stringify({ url: "https://invite-kit.dev/docs/revoking" }, null, 2),
+                output: "Any admin of the workspace may revoke a pending invite with revoke(invite).",
+              },
+              {
+                type: PLAN_WORK_PART.TOOL,
+                id: "shot-worker-3",
+                tool: PLAN_WORK_TOOL.READ_WEB_PAGE,
+                name: "read_web_page",
+                state: PLAN_WORK_STATE.DONE,
+                subject: "https://invitely.io/docs/api/withdraw",
+                input: JSON.stringify({ url: "https://invitely.io/docs/api/withdraw" }, null, 2),
+                output: "Only the user who sent an invite may withdraw it.",
+              },
+              {
+                type: PLAN_WORK_PART.TEXT,
+                text: "invite-kit lets any admin revoke a pending invite with `revoke(invite)`; invitely lets only the member who sent it withdraw it.",
+              },
+            ],
+          },
+        },
+        {
+          type: PLAN_WORK_PART.TEXT,
+          text: "I've asked the worker to compare two invite libraries. Meanwhile I'm reading how an invite is stored today.",
+        },
+        command("shot-call-4", "cat src/members/invite.ts", INVITE_SOURCE),
+        command("shot-call-5", RUNNING_COMMAND, undefined),
+      ],
+    },
+  ];
+}
+
+/** Whether this run stages the shot. */
+export function isShotRun(run: ShotRun): boolean {
+  return run.fixtureMode && run.profile === RUN_PROFILE.SHOT_WORK;
+}
+
+/** The view, built once, so every render reads the same objects; built only under the shot, so it also says the shot is staged. */
+let heldView: PlanningView | undefined;
+
+/** The plans the shot draws: the fixture's plan mid-call with the shot's work, among acme's plans. */
+export function shotWorkView(run: ShotRun): PlanningView | undefined {
+  if (!isShotRun(run)) return undefined;
+  heldView ??= {
+    ...FIXTURE_OPEN_PLAN,
+    plans: [
+      ...FIXTURE_OPEN_PLAN.plans.filter((plan) => plan.id === FIXTURE_PLAN.id),
+      { id: "6c1e9a40-2b7d-4f3e-8a15-0d2c4b6e8f91", name: "Webhook retries", createdAt: ago(60 * 26), updatedAt: ago(26) },
+      { id: "7d2f0b51-3c8e-4a4f-9b26-1e3d5c7f9a02", name: "Usage-based billing", createdAt: ago(60 * 50), updatedAt: ago(60 * 3) },
+      { id: "8e3a1c62-4d9f-4b50-8c37-2f4e6d8a0b13", name: "Onboarding checklist", createdAt: ago(60 * 24 * 6), updatedAt: ago(60 * 24 * 2) },
+      { id: "9f4b2d73-5e0a-4c61-9d48-3a5f7e9b1c24", name: "Audit log export", createdAt: ago(60 * 24 * 9), updatedAt: ago(60 * 24 * 4) },
+    ],
+    folders: {
+      [FIXTURE_PLAN.id]: "/Users/dean/code/relay",
+      "6c1e9a40-2b7d-4f3e-8a15-0d2c4b6e8f91": "/Users/dean/code/relay",
+      "7d2f0b51-3c8e-4a4f-9b26-1e3d5c7f9a02": "/Users/dean/code/ledger",
+      "8e3a1c62-4d9f-4b50-8c37-2f4e6d8a0b13": "/Users/dean/code/web",
+      "9f4b2d73-5e0a-4c61-9d48-3a5f7e9b1c24": "/Users/dean/code/relay",
+    },
+    activity: { planner: { action: RUNNING_COMMAND }, notes: true },
+    work: shotTurns(),
+  };
+  return heldView;
+}
+
+/** The side panel the shot opens its plan with: every tab, on Work, wide. */
+const SHOT_PANEL: SidePanelState = {
+  open: true,
+  tabs: SIDE_PANEL_TABS,
+  tab: SIDE_PANEL_TAB.WORK,
+  width: PANEL_WIDTH,
+};
+
+export function shotWorkPanel(run: ShotRun): SidePanelState | undefined {
+  return isShotRun(run) ? SHOT_PANEL : undefined;
+}
+
+/**
+ * Whether a thought draws open: under the shot, so the standing turn's
+ * thought reads. Note that it reads whether the shot's view was built,
+ * because the Plans tab builds it before the Work tab draws, and the tab
+ * knows nothing of the run.
+ */
+export function shotThoughtOpen(): boolean {
+  return heldView !== undefined;
+}
