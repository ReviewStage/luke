+++ b/apps/desktop/src/renderer/shots/plan-a-feature.ts
@@ -0,0 +1,298 @@
+import { ACCOUNT_PROVIDER, ACCOUNT_STATUS } from "@sidecar/credentials/snapshot";
+import { EMPTY_PLAN_UPDATE, type FullPlanUpdate, planBody } from "@sidecar/hosted/plan-template";
+import type { Plan, PlanSummary } from "@sidecar/hosted/plan-wire";
+import { PLANNING_READ, type PlanningView } from "@sidecar/hosted/planning-view";
+import { LIVE_STATUS } from "@sidecar/live";
+import { type AppStateSnapshot, RUN_PROFILE } from "#shared/messages/app-state";
+import { MICROPHONE_STATUS } from "#shared/messages/audio";
+import type { VoiceView } from "#shared/messages/voice-view";
+import { planUnits, type UnitView } from "../planning/plan-reveal";
+
+/**
+ * plan-a-feature.ts -- Throwaway: the 0.7.0 changelog's "Plan a feature with Luke" shot, never committed.
+ *
+ * Run as `electron . --fixture smoke --profile shot-plan-a-feature`. The whole
+ * window: the Plans tab's list of acme's plans, each pointing at a folder on
+ * the Mac, "Teammate invitations" open on the fixed template filled in well
+ * past halfway, and its planning call live at the foot: Luke speaking his one
+ * question (the caption), the planning model reading `~/code/relay`, and the
+ * notetaker writing the change map, its caret held partway through a line.
+ * Signed in as Dean Stratakos; 0.7.0's account row draws an initial, not a
+ * photo, so none is staged. Nothing here draws a time, but every timestamp is
+ * still counted back from launch.
+ */
+
+const MINUTE_MS = 60_000;
+const HOUR_MS = 60 * MINUTE_MS;
+const DAY_MS = 24 * HOUR_MS;
+
+/** The launch every time is counted back from. */
+const LAUNCHED_AT = Date.now();
+
+function ago(ms: number): number {
+  return LAUNCHED_AT - ms;
+}
+
+const HOME = "/Users/dean";
+
+const PLAN_ID = "0f6a2c4e-8b1d-4e3f-9a57-1c2b3d4e5f60";
+
+/** The Change map's own words, which the notetaker is partway through typing. */
+const CHANGE_MAP =
+  "- `src/db/schema/memberships.ts`: a `pending` state, and `invitedBy`, `tokenHash`, `expiresAt` columns.\n" +
+  "- `src/members/invite.ts`: new, creating, withdrawing, and accepting an invite.\n" +
+  "- `src/routes/invites.ts`: new, `POST /invites`, `DELETE /invites/:id`, `GET /invites/:token`.\n" +
+  "- `src/mail/templates/invite.tsx`: new, the invite email with its one-time link.";
+
+/** Where in the Change map's unit the caret stands: just into the template's line. */
+const CARET_AFTER = "`src/mail/templates/invite.tsx`: new, the inv";
+
+const PLAN_UPDATE: FullPlanUpdate = {
+  ...EMPTY_PLAN_UPDATE,
+  goal: {
+    problem:
+      "Only an admin can add someone to a workspace, by creating their account by hand, so " +
+      "members wait on an admin every time they want to bring a teammate in.",
+    outcome:
+      "A member invites a teammate by email from Members, and the teammate joins the " +
+      "workspace by opening the link.",
+  },
+  scope: {
+    included:
+      "Inviting by email from Members, the invite email, accepting the link, and withdrawing " +
+      "a pending invite.",
+    excluded: "Bulk invites from a CSV, invite links without an email, and SSO provisioning.",
+    constraints:
+      "An invite link is single use and grants only the role it was sent with. Tokens are " +
+      "stored hashed, never in plain text.",
+  },
+  rules: [
+    {
+      statement: "Any member may invite a teammate by email.",
+      examples: [
+        {
+          given: "Jordan, a member of the acme workspace",
+          when: "Jordan invites sam@acme.dev",
+          // biome-ignore lint/suspicious/noThenProperty: the fixed template's own key.
+          then: "Sam gets an email with a one-time link, and Members lists Sam as Pending", // oxlint-disable-line unicorn/no-thenable -- the same key.
+        },
+      ],
+    },
+    {
+      statement: "A withdrawn or accepted invite link never grants access again.",
+      examples: [
+        {
+          given: "An invite Sam already accepted",
+          when: "anyone opens its link again",
+          // biome-ignore lint/suspicious/noThenProperty: the fixed template's own key.
+          then: 'the page reads "This invite is no longer valid"', // oxlint-disable-line unicorn/no-thenable -- the same key.
+        },
+        {
+          given: "Dana withdrew Sam's pending invite",
+          when: "Sam opens the link",
+          // biome-ignore lint/suspicious/noThenProperty: the fixed template's own key.
+          then: 'the page reads "This invite is no longer valid"', // oxlint-disable-line unicorn/no-thenable -- the same key.
+        },
+      ],
+    },
+    {
+      statement: "Only the member who sent an invite, or an admin, may withdraw it.",
+      examples: [
+        {
+          given: "Jordan invited sam@acme.dev",
+          when: "Dana, an admin, withdraws the invite",
+          // biome-ignore lint/suspicious/noThenProperty: the fixed template's own key.
+          then: "the invite leaves Members and its link stops working", // oxlint-disable-line unicorn/no-thenable -- the same key.
+        },
+      ],
+    },
+    {
+      statement: "An invite link expires a fixed time after it is sent.",
+      examples: [
+        {
+          given: "Sam's invite was sent ten days ago",
+          when: "Sam opens the link",
+          // biome-ignore lint/suspicious/noThenProperty: the fixed template's own key.
+          then: null, // oxlint-disable-line unicorn/no-thenable -- the same key.
+        },
+      ],
+    },
+  ],
+  implementation: {
+    changeMap: CHANGE_MAP,
+    contracts:
+      "```ts\n" +
+      "// src/members/invite.ts\n" +
+      "export function createInvite(input: {\n" +
+      "  workspaceId: string;\n" +
+      "  email: string;\n" +
+      "  invitedBy: string;\n" +
+      "}): Promise<Membership>;\n" +
+      "export function withdrawInvite(id: string, by: string): Promise<void>;\n" +
+      "export function acceptInvite(token: string, userId: string): Promise<Accepted>;\n" +
+      "```",
+    patterns:
+      "- `src/members/remove.ts`: the role check before a membership changes.\n" +
+      "- `src/mail/templates/reset-password.tsx`: the React Email layout and the Postmark send.",
+    order: null,
+  },
+  decisions:
+    "Model an invite as a `memberships` row with `state = pending`. Why: removal covers " +
+    "invites and members alike. Rejected: a separate `invitations` table.\n\n" +
+    "The link carries a random token, stored hashed. Why: a withdrawn invite has to stop " +
+    "working at once. Rejected: a signed link, which cannot be revoked.",
+  verification:
+    "On a preview, Jordan invites sam@acme.dev, Sam opens the link in a private window and " +
+    'lands in the workspace, and the same link then reads "This invite is no longer valid". ' +
+    "`pnpm test src/members` passes.",
+  leftToAgent: null,
+  openQuestions: ["Does an invite link last 7 days or 14?"],
+  dataAndMigration:
+    "Adds `pending` to `membership_state` and three nullable columns to `memberships`; " +
+    "existing rows stay `active`. Undone by dropping the columns once no row is pending.",
+  assumptions: [
+    { text: "Invites reuse memberships with a pending state." },
+    { text: "Members and admins can both invite." },
+    { text: "The invite email goes out through Postmark like every other." },
+  ],
+};
+
+export const SHOT_OPEN_PLAN: Plan = {
+  id: PLAN_ID,
+  name: "Teammate invitations",
+  createdAt: ago(2 * DAY_MS),
+  updatedAt: ago(4 * MINUTE_MS),
+  openedAt: ago(26 * MINUTE_MS),
+  document: {
+    body: planBody({ name: "Teammate invitations" }, PLAN_UPDATE),
+    assumptions: PLAN_UPDATE.assumptions,
+  },
+};
+
+/** One of acme's other plans: its name, the folder it reads, and how long ago it was opened. */
+function otherPlan(id: string, name: string, folder: string, age: number) {
+  const plan: PlanSummary = {
+    id,
+    name,
+    createdAt: ago(age + 2 * DAY_MS),
+    updatedAt: ago(age),
+    openedAt: ago(age),
+  };
+  return { plan, folder: `${HOME}/code/${folder}` };
+}
+
+/** acme's other plans, most recently opened first. */
+const OTHER_PLANS = [
+  otherPlan("5c1e7a90-2b4d-4c6e-8f10-3a5b7c9d1e21", "Webhook retries", "relay", 26 * MINUTE_MS),
+  otherPlan("6d2f8b01-3c5e-4d7f-9021-4b6c8d0e2f32", "Usage-based billing", "ledger", 3 * HOUR_MS),
+  otherPlan("7e3a9c12-4d6f-4e80-a132-5c7d9e1f3a43", "Onboarding checklist", "web", DAY_MS),
+  otherPlan("8f4bad23-5e7a-4f91-b243-6d8eaf2a4b54", "Audit log export", "relay", 2 * DAY_MS),
+  otherPlan("9a5cbe34-6f8b-4aa2-c354-7e9fb03b5c65", "Invoice PDF redesign", "ledger", 3 * DAY_MS),
+  otherPlan("ab6dcf45-7a9c-4bb3-d465-8fa0c14c6d76", "Dark mode for the dashboard", "web", 4 * DAY_MS),
+];
+
+/** The Plans tab: the list, the open plan, and the call's backend at work on it. */
+export const SHOT_PLANNING_VIEW: PlanningView = {
+  plans: [
+    {
+      id: SHOT_OPEN_PLAN.id,
+      name: SHOT_OPEN_PLAN.name,
+      createdAt: SHOT_OPEN_PLAN.createdAt,
+      updatedAt: SHOT_OPEN_PLAN.updatedAt,
+      openedAt: ago(0),
+    },
+    ...OTHER_PLANS.map((entry) => entry.plan),
+  ],
+  listStatus: PLANNING_READ.READY,
+  activePlanId: SHOT_OPEN_PLAN.id,
+  document: { status: PLANNING_READ.READY, plan: SHOT_OPEN_PLAN },
+  activity: { planner: { action: 'grep -rn "expiresAt" src/auth' }, notes: true },
+  folders: {
+    [SHOT_OPEN_PLAN.id]: `${HOME}/code/relay`,
+    ...Object.fromEntries(OTHER_PLANS.map((entry) => [entry.plan.id, entry.folder])),
+  },
+};
+
+/** The call the voice window would report: Luke speaking, about the open plan. */
+export const SHOT_CALL: Pick<VoiceView, "voiceStatus" | "callPlanId"> = {
+  voiceStatus: LIVE_STATUS.SPEAKING,
+  callPlanId: SHOT_OPEN_PLAN.id,
+};
+
+/** Luke's words on the call: what he read in the folder, then his one question. */
+export const SHOT_CAPTIONS: readonly string[] = [
+  "Password reset links in src/auth/reset.ts expire after an hour, and sessions last 14 days.",
+  "Should an invite link last 7 days, or 14 like a session?",
+];
+
+/** Whether this run stages the shot: a fixture run under its profile alone. */
+export function isShot(run: { readonly fixtureMode: boolean; readonly profile: string }): boolean {
+  return run.fixtureMode && run.profile === RUN_PROFILE.SHOT_PLAN_A_FEATURE;
+}
+
+/** The voice view the Plans tab reads: the staged call over the window's own report. */
+export function shotVoiceView(view: VoiceView): VoiceView {
+  return { ...view, ...SHOT_CALL };
+}
+
+const STAGED = new WeakMap<AppStateSnapshot, AppStateSnapshot>();
+
+/**
+ * The snapshot as the shot draws it: signed in as Dean Stratakos with the
+ * microphone allowed. Cached per snapshot, so every reader of one delivery
+ * holds the same object.
+ */
+export function stagedAppState(state: AppStateSnapshot): AppStateSnapshot {
+  if (!isShot(state.run)) return state;
+  const held = STAGED.get(state);
+  if (held !== undefined) return held;
+  const staged: AppStateSnapshot = {
+    ...state,
+    account: {
+      status: ACCOUNT_STATUS.SIGNED_IN,
+      email: "dean@example.com",
+      name: "Dean Stratakos",
+      provider: ACCOUNT_PROVIDER.GITHUB,
+    },
+    audio: { ...state.audio, microphoneStatus: MICROPHONE_STATUS.GRANTED },
+  };
+  STAGED.set(state, staged);
+  return staged;
+}
+
+/**
+ * The open plan's units as the shot freezes them: every unit whole, but the
+ * Change map's, which the notetaker is typing, its caret solid partway into
+ * its last line and the rest not yet drawn.
+ */
+export function shotWritingViews(body: string): readonly UnitView[] {
+  return planUnits(body).map((words): UnitView => {
+    const still = { words, edit: undefined, writing: false, resting: false, fresh: false };
+    if (!words.startsWith("### Change map")) return still;
+    const caret = words.indexOf(CARET_AFTER) + CARET_AFTER.length;
+    return {
+      words,
+      edit: { hidden: { from: caret, to: words.length }, caret },
+      writing: true,
+      resting: false,
+      fresh: false,
+    };
+  });
+}
+
+/** Where the writing unit stands in the document's view, as a share of its height from the top. */
+const WRITING_AT = 0.42;
+
+/** Scrolls the document so the unit being written stands a little above the middle. */
+export function scrollToWriting(scroller: HTMLElement): void {
+  const writing = scroller.querySelector(".plan-writing");
+  if (writing === null) return;
+  // Note that we work in the document's own offsets, because this runs again on every resize and must land in the same place each time.
+  const view = scroller.getBoundingClientRect();
+  const offsetOf = (element: Element): number => element.getBoundingClientRect().top - view.top + scroller.scrollTop;
+  const wanted = offsetOf(writing) - view.height * WRITING_AT;
+  // Note that we snap to the last heading above that point, because a view cut through a heading reads as a mistake.
+  const headings = Array.from(scroller.querySelectorAll("h1, h2, h3, h4, p > strong:first-child")).map(offsetOf);
+  const snapped = headings.filter((offset) => offset <= wanted).pop() ?? wanted;
+  scroller.scrollTop = Math.max(0, snapped - 24);
+}
