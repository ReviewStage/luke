@@ -0,0 +1,94 @@
+// notebook.ts -- Throwaway: the notebook the changelog shot of 0.6.0's Memory page reads, never committed.
+
+import type { NotebookFile, NotebookReadResult } from "@sidecar/gateway";
+
+/**
+ * What Luke keeps about Dean and acme's work, answered in place of the
+ * service's `notebook.read` on a fixture run under the `shot-notebook`
+ * profile: MEMORY.md (who's who, what was settled on Teammate invitations,
+ * which agent runs where), USER.md (dated directives on how Dean likes to be
+ * told things), and the two newest dated notes, with older ones counted
+ * behind them. Every date is counted back from the moment the page asks,
+ * which is a few seconds after launch, and the latest writes follow the
+ * Conversation shot's thread: Dean chose 7 days about ten minutes ago.
+ */
+
+const MINUTE = 60_000;
+const DAY = 24 * 60 * MINUTE;
+
+/** A day as the notebook spells it, `YYYY-MM-DD`, on the Mac's own calendar. */
+function dayStamp(at: number): string {
+  const date = new Date(at);
+  const month = String(date.getMonth() + 1).padStart(2, "0");
+  const day = String(date.getDate()).padStart(2, "0");
+  return `${date.getFullYear()}-${month}-${day}`;
+}
+
+function file(path: string, content: string, updatedAt: number): NotebookFile {
+  return { path, content, chars: content.length, updatedAt };
+}
+
+function memoryFile(now: number): string {
+  return [
+    "## People",
+    "",
+    "- **Dana Moreno**: acme's admin. Reviews and merges relay PRs; wants #214 before Friday.",
+    "- **Jordan Lee**: member. Owns the dashboard shell in acme/web.",
+    "",
+    "## Teammate invitations (acme/relay)",
+    "",
+    `- Invite links last **7 days**, so an unused invite can't linger. Settled ${dayStamp(now)}, over 14.`,
+    "- The sender or any admin may withdraw an invite.",
+    '- A withdrawn or accepted link reads "This invite is no longer valid".',
+    "- Invite mail goes out through Postmark, from a React Email template.",
+    "",
+    "## Agents",
+    "",
+    "- **Add teammate invitations**: Claude Code in the cloud, on #214.",
+    "- **Invite emails**: Codex in the cloud, on #216 (the Postmark template).",
+    "- **Webhook retries** (Claude Code) and **Usage-based billing** (Codex) run locally on Dean's Mac.",
+    "",
+  ].join("\n");
+}
+
+function userFile(now: number): string {
+  const on = (daysAgo: number) => dayStamp(now - daysAgo * DAY);
+  return [
+    `- ${on(21)}: Dean Stratakos, engineer at acme. Works mostly in acme/relay, some acme/ledger.`,
+    `- ${on(21)}: Keep updates short: what changed, what needs him, then the PR number.`,
+    `- ${on(18)}: Don't interrupt during meetings; hold briefings until the meeting ends.`,
+    `- ${on(12)}: Put a decision as two options, with Luke's lean first.`,
+    `- ${on(6)}: Speak up right away only for an agent that is blocked; batch the "done" news.`,
+    `- ${on(2)}: Mornings are for review; save long summaries for after lunch.`,
+    "",
+  ].join("\n");
+}
+
+function todayNote(): string {
+  return [
+    "- Add teammate invitations asked whether an invite link lasts 7 days or 14. Dean chose 7 and told it to finish #214.",
+    "- Invite emails is still writing the Postmark template for #216.",
+  ].join("\n\n");
+}
+
+function yesterdayNote(): string {
+  return [
+    "- Webhook retries finished: retries back off up to an hour, and the tests pass.",
+    "- Usage-based billing rolls metered usage into the invoice draft. Done in acme/ledger.",
+    "- Dana asked to see #214 before Friday.",
+  ].join("\n\n");
+}
+
+/** The notebook as the service would answer it now: curated files first, the newest notes after. */
+export function shotNotebook(now: number): NotebookReadResult {
+  const yesterday = now - DAY - 3 * 60 * MINUTE;
+  return {
+    files: [
+      file("MEMORY.md", memoryFile(now), now - 9 * MINUTE),
+      file("USER.md", userFile(now), now - 2 * DAY - 40 * MINUTE),
+      file(`memory/${dayStamp(now)}.md`, todayNote(), now - 10 * MINUTE),
+      file(`memory/${dayStamp(yesterday)}.md`, yesterdayNote(), yesterday),
+    ],
+    omittedNotes: 7,
+  };
+}
