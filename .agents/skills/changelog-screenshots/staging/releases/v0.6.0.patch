@@ -0,0 +1,338 @@
+// conversation.ts -- Throwaway: the changelog shot of 0.6.0's Conversation tab, never committed.
+
+import { ACTION_OUTPUT_STATUS } from "@sidecar/actions";
+import {
+  CONVERSATION_VIEW_TOOL_KIND,
+  type ConversationViewSnapshot,
+  type ConversationViewToolKinds,
+  MESSAGE_AUTHOR,
+  MESSAGE_CHANNEL,
+  MESSAGE_ROLE,
+  PROVIDER_ID,
+  SESSION_APPLICATION_ID,
+  SESSION_APPLICATION_SCOPE,
+  SESSION_LOCATION,
+  SESSION_URGENCY,
+  type StoredToolPart,
+  selectConversationView,
+  TOOL_PART_STATE,
+} from "@sidecar/session";
+import type { FixtureSnapshot } from "@sidecar/session/fixtures";
+import type { StoredUIMessage } from "@sidecar/session/ui-messages";
+import { TURN_ORIGIN, TURN_STATUS } from "@sidecar/wire";
+import { type AppStateSnapshot, RUN_PROFILE } from "#shared/messages/app-state";
+
+/**
+ * acme's thread on the Conversation tab, from WORLD.md's story: Dean asks
+ * what needs him, Luke answers in Markdown over a fold of what he looked at,
+ * checks the notebook for what was said about invite expiry, and messages
+ * "Add teammate invitations" to finish #214. Every time is counted back from
+ * the moment this module loads, which is the launch, so the date over the
+ * thread reads Today. Gated on fixture mode and the profile; any other run
+ * draws exactly what the release draws.
+ */
+
+/** The instant the shot is read against: the launch, give or take the bundle's load. */
+export const SHOT_NOW = Date.now();
+
+const MINUTE = 60_000;
+
+const ago = (minutes: number) => SHOT_NOW - minutes * MINUTE;
+
+type FixtureSession = FixtureSnapshot["sessions"][number];
+
+/** acme's cloud workspaces, by the chat each holds. */
+const SESSION = {
+  INVITATIONS: "acme-relay-teammate-invitations",
+  EMAILS: "acme-relay-invite-emails",
+} as const;
+
+const TITLE = {
+  INVITATIONS: "Add teammate invitations",
+  EMAILS: "Invite emails",
+} as const;
+
+const CLOUD_APP = [
+  {
+    id: SESSION_APPLICATION_ID.CONDUCTOR,
+    name: "Cloud",
+    scope: SESSION_APPLICATION_SCOPE.SESSION,
+  },
+] as const;
+
+function cloudChat(
+  id: string,
+  title: string,
+  agent: { id: FixtureSession["providerId"]; name: string },
+  rest: Omit<
+    FixtureSession,
+    "id" | "title" | "providerId" | "provider" | "agentId" | "agent" | "location"
+  >,
+): FixtureSession {
+  return {
+    id,
+    title,
+    providerId: PROVIDER_ID.CONDUCTOR,
+    provider: "Cloud",
+    agentId: agent.id,
+    agent: agent.name,
+    applications: CLOUD_APP,
+    location: SESSION_LOCATION.CLOUD,
+    ...rest,
+  };
+}
+
+/**
+ * The roster as it stands once the thread has settled: Add teammate
+ * invitations back at work on its answer, Invite emails still writing, and
+ * two finished chats from earlier in the week. The wings draw these marks,
+ * and the chips resolve against these titles.
+ */
+export const ACME_SESSIONS: readonly FixtureSession[] = [
+  cloudChat(
+    SESSION.INVITATIONS,
+    TITLE.INVITATIONS,
+    { id: PROVIDER_ID.CLAUDE_CODE, name: "Claude Code" },
+    {
+      detail: "Setting invite links to expire after 7 days.",
+      repository: "relay",
+      branch: "dean/teammate-invitations",
+      model: "claude-opus-5",
+      urgency: SESSION_URGENCY.WORKING,
+      lastActivityAt: ago(1),
+      hasChange: true,
+      changeNumber: 214,
+      workspace: { id: "acme-invitations", name: "teammate-invitations" },
+    },
+  ),
+  cloudChat(
+    SESSION.EMAILS,
+    TITLE.EMAILS,
+    { id: PROVIDER_ID.CODEX, name: "Codex" },
+    {
+      detail: "Writing the Postmark invite template.",
+      repository: "relay",
+      branch: "dean/invite-emails",
+      model: "gpt-5.6-luna",
+      urgency: SESSION_URGENCY.WORKING,
+      lastActivityAt: ago(2),
+      hasChange: true,
+      changeNumber: 216,
+      workspace: { id: "acme-invite-emails", name: "invite-emails" },
+    },
+  ),
+  {
+    id: "acme-relay-webhook-retries",
+    title: "Webhook retries",
+    providerId: PROVIDER_ID.CLAUDE_CODE,
+    provider: "Claude Code",
+    detail: "Retries back off up to an hour; tests pass.",
+    repository: "relay",
+    branch: "dean/webhook-retries",
+    model: "claude-opus-5",
+    urgency: SESSION_URGENCY.COMPLETE,
+    location: SESSION_LOCATION.LOCAL,
+    lastActivityAt: ago(26),
+  },
+  {
+    id: "acme-ledger-usage-billing",
+    title: "Usage-based billing",
+    providerId: PROVIDER_ID.CODEX,
+    provider: "Codex",
+    detail: "Metered usage rolls up into the invoice draft.",
+    repository: "ledger",
+    branch: "dean/usage-billing",
+    model: "gpt-5.6-luna",
+    urgency: SESSION_URGENCY.COMPLETE,
+    location: SESSION_LOCATION.LOCAL,
+    lastActivityAt: ago(52),
+  },
+];
+
+const TOOL_KINDS: ConversationViewToolKinds = new Map([
+  ["announce", CONVERSATION_VIEW_TOOL_KIND.ANNOUNCE],
+  ["send_session_message", CONVERSATION_VIEW_TOOL_KIND.ACTION],
+]);
+
+const identity = (providerSessionId: string) => ({
+  provider_id: PROVIDER_ID.CONDUCTOR,
+  provider_session_id: providerSessionId,
+});
+
+type ToolCallOutput = Extract<
+  StoredToolPart,
+  { state: typeof TOOL_PART_STATE.OUTPUT_AVAILABLE }
+>["output"];
+
+let calls = 0;
+
+function call(toolName: string, input: StoredToolPart["input"], output: ToolCallOutput) {
+  calls += 1;
+  const part: StoredToolPart = {
+    type: `tool-${toolName}`,
+    toolCallId: `call_acme_${String(calls).padStart(2, "0")}`,
+    state: TOOL_PART_STATE.OUTPUT_AVAILABLE,
+    input,
+    output,
+  };
+  return part;
+}
+
+const ask = (id: string, text: string): StoredUIMessage => ({
+  id,
+  role: MESSAGE_ROLE.USER,
+  metadata: { author: MESSAGE_AUTHOR.DEVELOPER, channel: MESSAGE_CHANNEL.TYPED },
+  parts: [{ type: "text", text }],
+});
+
+const reply = (id: string, parts: StoredUIMessage["parts"]): StoredUIMessage => ({
+  id,
+  role: MESSAGE_ROLE.ASSISTANT,
+  metadata: { author: MESSAGE_AUTHOR.BRAIN },
+  parts,
+});
+
+const TURN = {
+  NEEDS: "3c000000-0000-4000-8000-000000000101",
+  NOTEBOOK: "3c000000-0000-4000-8000-000000000102",
+  MESSAGE: "3c000000-0000-4000-8000-000000000103",
+} as const;
+
+/** When each exchange was asked; each answer lands a few seconds after it. */
+const AT = {
+  NEEDS: ago(14),
+  NOTEBOOK: ago(12),
+  MESSAGE: ago(11),
+} as const;
+
+const NEEDS_ANSWER = [
+  "Two agents are on Teammate invitations:",
+  "",
+  "- **Add teammate invitations** opened #214 and needs a decision: should an invite link last 7 days or 14?",
+  "- **Invite emails** is still writing the Postmark template.",
+].join("\n");
+
+const FINISH_MESSAGE = "Make it 7 days, then finish #214.";
+
+function shotConversation(): ConversationViewSnapshot {
+  const groups = selectConversationView({
+    main: [
+      {
+        message: ask("4d000000-0000-4000-8000-000000000201", "What needs me?"),
+        seq: 1,
+        turnId: TURN.NEEDS,
+        createdAt: AT.NEEDS,
+      },
+      {
+        message: reply("4d000000-0000-4000-8000-000000000202", [
+          { type: "step-start" },
+          call("list_sessions", {}, { roster: "(the roster as text)" }),
+          call("read_transcript", identity(SESSION.INVITATIONS), {
+            lines: ["assistant: Should an invite link last 7 days or 14?"],
+          }),
+          { type: "step-start" },
+          { type: "text", text: NEEDS_ANSWER, state: "done" },
+        ]),
+        seq: 2,
+        turnId: TURN.NEEDS,
+        createdAt: AT.NEEDS + 4000,
+      },
+      {
+        message: ask(
+          "4d000000-0000-4000-8000-000000000203",
+          "What did we say about expiry last time?",
+        ),
+        seq: 3,
+        turnId: TURN.NOTEBOOK,
+        createdAt: AT.NOTEBOOK,
+      },
+      {
+        message: reply("4d000000-0000-4000-8000-000000000204", [
+          { type: "step-start" },
+          call("memory_search", { query: "invite link expiry" }, { results: [] }),
+          { type: "step-start" },
+          {
+            type: "text",
+            text: "You leaned toward **7 days**, so an unused invite can't linger.",
+            state: "done",
+          },
+        ]),
+        seq: 4,
+        turnId: TURN.NOTEBOOK,
+        createdAt: AT.NOTEBOOK + 3000,
+      },
+      {
+        message: ask("4d000000-0000-4000-8000-000000000205", "Go with 7. Tell it to finish up."),
+        seq: 5,
+        turnId: TURN.MESSAGE,
+        createdAt: AT.MESSAGE,
+      },
+      {
+        message: reply("4d000000-0000-4000-8000-000000000206", [
+          { type: "step-start" },
+          call(
+            "send_session_message",
+            { ...identity(SESSION.INVITATIONS), text: FINISH_MESSAGE },
+            {
+              status: ACTION_OUTPUT_STATUS.ACCEPTED,
+              target: {
+                providerId: PROVIDER_ID.CONDUCTOR,
+                providerSessionId: SESSION.INVITATIONS,
+                title: TITLE.INVITATIONS,
+                agentId: PROVIDER_ID.CLAUDE_CODE,
+              },
+            },
+          ),
+          { type: "step-start" },
+          { type: "text", text: "Sent. It's back at work on #214.", state: "done" },
+        ]),
+        seq: 6,
+        turnId: TURN.MESSAGE,
+        createdAt: AT.MESSAGE + 3000,
+      },
+    ],
+    observed: [],
+    turns: [
+      { id: TURN.NEEDS, origin: TURN_ORIGIN.TYPED, status: TURN_STATUS.SETTLED, queuedAt: AT.NEEDS },
+      {
+        id: TURN.NOTEBOOK,
+        origin: TURN_ORIGIN.TYPED,
+        status: TURN_STATUS.SETTLED,
+        queuedAt: AT.NOTEBOOK,
+      },
+      {
+        id: TURN.MESSAGE,
+        origin: TURN_ORIGIN.TYPED,
+        status: TURN_STATUS.SETTLED,
+        queuedAt: AT.MESSAGE,
+      },
+    ],
+    events: [],
+    toolKinds: TOOL_KINDS,
+  });
+  return { groups, settled: true };
+}
+
+/** Whether this run is the shot: a fixture run launched with its profile. */
+export function isConversationShot(state: AppStateSnapshot | undefined): boolean {
+  return state?.run.fixtureMode === true && state.run.profile === RUN_PROFILE.SHOT_CONVERSATION;
+}
+
+const CONVERSATION = shotConversation();
+
+/**
+ * The document as the shot draws it: acme's roster in place of the smoke
+ * fixture's, the thread above, and no onboarding gate or introduction
+ * standing in front of the panel. Memoized by the caller on the state it is
+ * handed, so a re-render reads the same objects.
+ */
+export function stageConversationShot(state: AppStateSnapshot): AppStateSnapshot {
+  return {
+    ...state,
+    run: { ...state.run, fixture: { ...state.run.fixture, sessions: ACME_SESSIONS } },
+    sessions: { ...state.sessions, settled: true },
+    conversation: CONVERSATION,
+    onboarding: { calendarOwed: false, conductorKeyOwed: false },
+    introduction: { playing: false },
+  };
+}
