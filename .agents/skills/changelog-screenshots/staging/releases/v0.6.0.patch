+// notebook.ts -- Throwaway: the changelog shot of 0.6.0's Memory page, never committed.
+
+import { ACCOUNT_PROVIDER, ACCOUNT_STATUS } from "@sidecar/credentials/snapshot";
+import { type AppStateSnapshot, RUN_PROFILE } from "#shared/messages/app-state";
+import { ACME_SESSIONS } from "./conversation";
+import { DEAN_AVATAR_DATA_URL } from "./dean-avatar";
+
+/**
+ * Luke's notebook on Settings › Memory, signed in as Dean Stratakos. The page
+ * opens on its own and asks main for the notebook, which answers acme's
+ * (`main/shots/notebook.ts`); this side signs the account in, puts acme's
+ * roster in the wings, and keeps the onboarding gates and the introduction
+ * out of the way. Gated on fixture mode and the profile; any other run draws
+ * exactly what the release draws.
+ */
+
+/** Dean, built once, so a render reads the same object each time. */
+const DEAN = {
+  status: ACCOUNT_STATUS.SIGNED_IN,
+  name: "Dean Stratakos",
+  email: "dean@example.com",
+  provider: ACCOUNT_PROVIDER.GITHUB,
+  pictureUrl: DEAN_AVATAR_DATA_URL,
+} as const;
+
+/** Whether this run is the shot: a fixture run launched with its profile. */
+export function isNotebookShot(state: AppStateSnapshot | undefined): boolean {
+  return state?.run.fixtureMode === true && state.run.profile === RUN_PROFILE.SHOT_NOTEBOOK;
+}
+
+/** The document as the shot draws it: Dean signed in, acme's roster, nothing in front of the panel. */
+export function stageNotebookShot(state: AppStateSnapshot): AppStateSnapshot {
+  return {
+    ...state,
+    account: DEAN,
+    run: { ...state.run, fixture: { ...state.run.fixture, sessions: ACME_SESSIONS } },
+    sessions: { ...state.sessions, settled: true },
+    onboarding: { calendarOwed: false, conductorKeyOwed: false },
+    introduction: { playing: false },
+  };
+}
