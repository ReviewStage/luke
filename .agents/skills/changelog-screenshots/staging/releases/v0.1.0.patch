@@ -0,0 +1,227 @@
+// shots.ts -- Throwaway: the changelog screenshots staged for 0.1.0, never committed.
+//
+// Two profiles, each gated on itself and on fixture mode at its call site:
+//
+// - `shot-one-panel`, run as
+//   `--fixture smoke --expanded --profile shot-one-panel --capture-evidence <png>`.
+//   It swaps the smoke fixture's six sessions for acme's roster (WORLD.md), opens
+//   the list on the release's own Recent sort so the needs-you, working, and done
+//   rows read as one mix, and gives the capture time to settle.
+// - `shot-talk`, run as
+//   `--fixture smoke --compact --peek --profile shot-talk --capture-evidence <png>`.
+//   The release's own `speaking` evidence (meter lit, Luke's face talking, his
+//   caption under the housing) over the same roster, with the caption one of
+//   Luke's lines about acme's work.
+
+import {
+  FIXTURE_EPOCH_MS,
+  type FixtureSnapshot,
+  PROVIDER_ID,
+  SESSION_CONTROL_KIND,
+  SESSION_LIST_SORT,
+  SESSION_LOCATION,
+  SESSION_URGENCY,
+  type SessionListSort,
+} from "@sidecar/core";
+
+export const SHOT_PROFILE = {
+  ONE_PANEL: "shot-one-panel",
+  TALK: "shot-talk",
+} as const;
+
+export type ShotProfile = (typeof SHOT_PROFILE)[keyof typeof SHOT_PROFILE];
+
+/** How long a shot's capture waits after the window reports ready. */
+export const SHOT_CAPTURE_SETTLE_MS = 3_000;
+
+/** The ask key a signed-in Mac would hold; a capture run registers none. */
+export const SHOT_ASK_HOTKEY = "Alt+L";
+
+const CLAUDE_MODEL = "claude-opus-5";
+const CODEX_MODEL = "gpt-5.6-luna";
+
+function minutesAgo(minutes: number): number {
+  return FIXTURE_EPOCH_MS - minutes * 60_000;
+}
+
+/**
+ * Nine sessions on acme's work, each worded the way its provider reports it at
+ * 0.1.0: Claude Code and Codex name the tool they run or their parting words,
+ * Cursor its run's result, while Jules and Copilot title a row by its
+ * repository and say nothing (the row states its own state), and the cloud
+ * titles a lone chat by its workspace. Controls are the ones each adapter
+ * advertises in that state. Ages are minutes before the fixture's own epoch,
+ * which is the clock fixture rows are read against.
+ */
+const onePanelFixture: FixtureSnapshot = {
+  scenario: "smoke",
+  sessions: [
+    {
+      id: "shot-claude-usage-billing",
+      title: "Usage-based billing",
+      providerId: PROVIDER_ID.CLAUDE_CODE,
+      provider: "Claude Code",
+      detail: "Bash: pnpm test src/metering",
+      repository: "ledger",
+      branch: "dean/usage-billing",
+      model: CLAUDE_MODEL,
+      urgency: SESSION_URGENCY.WORKING,
+      location: SESSION_LOCATION.LOCAL,
+      observedAt: minutesAgo(0.2),
+    },
+    {
+      id: "shot-codex-webhook-retries",
+      title: "Webhook retries",
+      providerId: PROVIDER_ID.CODEX,
+      provider: "Codex",
+      detail: "Backoff runs 30s to 1h. Give up after 8 attempts, or keep retrying for 24 hours?",
+      repository: "relay",
+      branch: "dean/webhook-retries",
+      model: CODEX_MODEL,
+      urgency: SESSION_URGENCY.ATTENTION,
+      location: SESSION_LOCATION.LOCAL,
+      observedAt: minutesAgo(1),
+    },
+    {
+      id: "shot-claude-teammate-invitations",
+      title: "Add teammate invitations",
+      providerId: PROVIDER_ID.CLAUDE_CODE,
+      provider: "Claude Code",
+      detail: "Opened #214: an invite is a pending membership, accepted at /invites/:token.",
+      repository: "relay",
+      branch: "dean/teammate-invitations",
+      model: CLAUDE_MODEL,
+      urgency: SESSION_URGENCY.COMPLETE,
+      location: SESSION_LOCATION.LOCAL,
+      observedAt: minutesAgo(4),
+    },
+    {
+      id: "shot-cursor-invite-emails",
+      title: "Invite emails",
+      providerId: PROVIDER_ID.CURSOR,
+      provider: "Cursor",
+      detail: "Opened draft #216: invite emails now go out through Postmark, +96 −4.",
+      repository: "acme/relay",
+      branch: "cursor/invite-emails-4e1a",
+      urgency: SESSION_URGENCY.COMPLETE,
+      location: SESSION_LOCATION.CLOUD,
+      observedAt: minutesAgo(7),
+      // A finished Cursor run takes a follow-up and offers its archive.
+      canMessage: true,
+      actions: [{ id: "archive-agent", label: "Archive" }],
+    },
+    {
+      id: "shot-jules-onboarding",
+      title: "acme/web",
+      providerId: PROVIDER_ID.JULES,
+      provider: "Jules",
+      detail: "",
+      repository: "acme/web",
+      branch: "main",
+      urgency: SESSION_URGENCY.ATTENTION,
+      location: SESSION_LOCATION.CLOUD,
+      observedAt: minutesAgo(9),
+      // Holding for a plan approval: Jules takes a message and the approval.
+      canMessage: true,
+      actions: [{ id: "approve-plan", label: "Approve the plan" }],
+    },
+    {
+      id: "shot-cloud-audit-export",
+      title: "Stream audit rows as CSV",
+      providerId: PROVIDER_ID.CONDUCTOR,
+      provider: "Cloud",
+      detail: "",
+      repository: "acme/relay",
+      model: CLAUDE_MODEL,
+      urgency: SESSION_URGENCY.WORKING,
+      location: SESSION_LOCATION.CLOUD,
+      observedAt: minutesAgo(14),
+      workspace: { id: "shot-cloud-audit", name: "audit-log-export" },
+      // Mid-turn: a cloud chat takes a steer and offers its stop.
+      canMessage: true,
+      actions: [{ id: "cancel-turn", label: "Stop this turn", kind: SESSION_CONTROL_KIND.STOP }],
+    },
+    {
+      id: "shot-copilot-onboarding",
+      title: "acme/web",
+      providerId: PROVIDER_ID.COPILOT,
+      provider: "Copilot",
+      detail: "",
+      repository: "acme/web",
+      branch: "copilot/onboarding-checklist",
+      urgency: SESSION_URGENCY.WORKING,
+      location: SESSION_LOCATION.CLOUD,
+      observedAt: minutesAgo(22),
+    },
+    {
+      id: "shot-opencode-dark-mode",
+      title: "Dark mode for the dashboard",
+      providerId: PROVIDER_ID.OPENCODE,
+      provider: "OpenCode",
+      detail: "",
+      repository: "web",
+      urgency: SESSION_URGENCY.COMPLETE,
+      location: SESSION_LOCATION.LOCAL,
+      observedAt: minutesAgo(26),
+    },
+    {
+      id: "shot-devin-invoice-pdf",
+      title: "Invoice PDF redesign",
+      providerId: PROVIDER_ID.DEVIN,
+      provider: "Devin",
+      detail: "",
+      repository: "acme/ledger",
+      urgency: SESSION_URGENCY.COMPLETE,
+      location: SESSION_LOCATION.CLOUD,
+      observedAt: minutesAgo(140),
+      // An exited Devin session offers its archive and takes no message.
+      actions: [{ id: "archive-session", label: "Archive" }],
+    },
+  ],
+};
+
+/**
+ * What Luke is saying in `shot-talk`: the session that needs Dean, by its
+ * provider and title, the way 0.1.0's announcements name one, and long enough
+ * to wrap, as the release's own speaking caption does.
+ */
+export const SHOT_TALK_CAPTION =
+  "Claude Code opened #214 for Add teammate invitations, and it has one question for you: should invite links last 7 days, or 14?";
+
+/**
+ * `shot-talk`'s roster: the same nine, except that Add teammate invitations
+ * ended its turn on the question Luke is announcing, so the count he sits beside
+ * agrees with him.
+ */
+const talkFixture: FixtureSnapshot = {
+  ...onePanelFixture,
+  sessions: onePanelFixture.sessions.map((session) =>
+    session.id === "shot-claude-teammate-invitations"
+      ? {
+          ...session,
+          detail: "Opened #214. Should invite links last 7 days or 14?",
+          urgency: SESSION_URGENCY.ATTENTION,
+        }
+      : session,
+  ),
+};
+
+const SHOT_PROFILE_LIST: readonly string[] = Object.values(SHOT_PROFILE);
+
+/** Whether this run stages a shot: fixture mode and one of the shot profiles. */
+export function isShotRun(fixtureMode: boolean, profile: string | undefined): boolean {
+  return fixtureMode && profile !== undefined && SHOT_PROFILE_LIST.includes(profile);
+}
+
+/** Whether this run is `shot-talk`, which stages the speaking capsule. */
+export function isShotTalk(fixtureMode: boolean, profile: string | undefined): boolean {
+  return fixtureMode && profile === SHOT_PROFILE.TALK;
+}
+
+/** The roster a shot run draws in place of the smoke fixture's. */
+export function shotFixture(profile: string): FixtureSnapshot {
+  return profile === SHOT_PROFILE.TALK ? talkFixture : onePanelFixture;
+}
+
+/** The order the shot's list opens on. */
+export const SHOT_INITIAL_SORT: SessionListSort = SESSION_LIST_SORT.RECENCY;
