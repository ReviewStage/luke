@@ -0,0 +1,50 @@
+/**
+ * shots.ts -- Throwaway: the changelog screenshot staging for 0.3.10, never
+ * committed. One profile, `shot-onboarding`, staged only in fixture mode:
+ * the full-display introduction takeover pinned at its HELLO beat, with the
+ * caption strip saying the beat's first line, captured by `--capture-evidence`.
+ */
+
+export const SHOT_PROFILE = {
+  ONBOARDING: "shot-onboarding",
+} as const;
+
+export type ShotProfile = (typeof SHOT_PROFILE)[keyof typeof SHOT_PROFILE];
+
+/**
+ * How long a shot's capture waits after its window reports ready, so the
+ * scrim's arrival and every async draw have landed (the tag waits 350 ms).
+ */
+export const SHOT_CAPTURE_SETTLE_MS = 3_000;
+
+/**
+ * The caption the HELLO beat's first reply draws: INTRODUCTION_SCRIPT.HELLO's
+ * first line is 'Say exactly: "Hi! I'm Luke."', and the caption is that
+ * reply's transcript, one segment.
+ */
+export const SHOT_ONBOARDING_CAPTIONS: readonly string[] = ["Hi! I'm Luke."];
+
+/** Whether this run stages the onboarding shot: its profile, in fixture mode only. */
+export function stagesOnboardingShot(input: { fixtureMode: boolean; profile: string }): boolean {
+  return input.fixtureMode && input.profile === SHOT_PROFILE.ONBOARDING;
+}
+
+/** Whether this run stages any shot, for the capture's longer settle. */
+export function stagesShot(input: { fixtureMode: boolean; profile: string }): boolean {
+  return input.fixtureMode && input.profile.startsWith("shot-");
+}
+
+/**
+ * The state directory a shot run asked for with Chromium's `--user-data-dir`
+ * (either `--user-data-dir=<dir>` or `--user-data-dir <dir>`): 0.3.10 points
+ * `userData` at appData/<appName> by hand, which would share a running
+ * Luke's state and single-instance lock.
+ */
+export function requestedUserDataDirectory(argv: readonly string[]): string | undefined {
+  const flag = "--user-data-dir";
+  for (const [index, argument] of argv.entries()) {
+    if (argument.startsWith(`${flag}=`)) return argument.slice(flag.length + 1) || undefined;
+    if (argument === flag) return argv[index + 1];
+  }
+  return undefined;
+}
