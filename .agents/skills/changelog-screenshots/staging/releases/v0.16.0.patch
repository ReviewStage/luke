+          text: 'Either way an expired link reads "This invite is no longer valid", as a withdrawn one does, and an admin can send a fresh one from **Settings › Members**.',
+        },
+      ],
+      response: {
+        type: INBOX_RESPONSE.CHOICE,
+        options: [
+          {
+            label: "7 days",
+            detail: "Matches password reset links; a forwarded link goes stale sooner.",
+          },
+          {
+            label: "14 days",
+            detail:
+              "Fewer resends for teammates slow to join, but a forwarded link works for two weeks.",
+          },
+        ],
+        recommended: "7 days",
+      },
+      postedAt: ago(24),
+      updatedAt: ago(19),
+    },
+    {
