diff --git a/apps/desktop/src/renderer/shots/shot-profiles.ts b/apps/desktop/src/renderer/shots/shot-profiles.ts
new file mode 100644
index 000000000..acf2509a6
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/shot-profiles.ts
@@ -0,0 +1,83 @@
+/**
+ * shot-profiles.ts -- the registry: which shot each `--profile shot-*` launch stages, built once on first use.
+ *
+ * Throwaway (`README.md`). Only a fixture run stages a shot. Each shot's
+ * builder lives in a file of its own and is called lazily, the first time
+ * the shot is asked for, so no shot module reads another module's values at
+ * load and nothing here can be caught in an import cycle; the spec built is
+ * kept, so every reader is handed the same objects render after render.
+ */
+
+import { RUN_PROFILE } from "@luke/host/app-state";
+import { UPDATE_STATUS, type UpdateSnapshot } from "@luke/settings/update";
+import { appStateNow } from "../use-app-state";
+import { integrationsShot } from "./integrations";
+import { mcpShot } from "./mcp";
+import { automationsShot } from "./automations";
+import { mentionsShot } from "./mentions";
+import type { ShotSpec } from "./shot-spec";
+import { switcherShot } from "./switcher";
+import { terminalShot } from "./terminal";
+import { whoShot } from "./who";
+import { planPicturesShot } from "./plan-pictures";
+import { agentPicturesShot } from "./agent-pictures";
+import { personShot } from "./person";
+import { linearShot } from "./linear";
+import { factoryShot } from "./factory";
+import { linksShot } from "./links";
+import { agentsStartShot } from "./agents-start";
+import { widthShot } from "./width";
+import { workspacesShot } from "./workspaces";
+
+/** Each shot's builder, by its profile. */
+const BUILDERS: ReadonlyMap<string, () => ShotSpec> = new Map([
+  [RUN_PROFILE.SHOT_WORKSPACES, workspacesShot],
+  [RUN_PROFILE.SHOT_INTEGRATIONS, integrationsShot],
+  [RUN_PROFILE.SHOT_MCP, mcpShot],
+  [RUN_PROFILE.SHOT_TERMINAL, terminalShot],
+  [RUN_PROFILE.SHOT_MENTIONS, mentionsShot],
+  [RUN_PROFILE.SHOT_WHO, whoShot],
+  [RUN_PROFILE.SHOT_SWITCHER, switcherShot],
+  [RUN_PROFILE.SHOT_AUTOMATIONS, automationsShot],
+  [RUN_PROFILE.SHOT_PLAN_PICTURES, planPicturesShot],
+  [RUN_PROFILE.SHOT_AGENT_PICTURES, agentPicturesShot],
+  [RUN_PROFILE.SHOT_PERSON, personShot],
+  [RUN_PROFILE.SHOT_LINEAR, linearShot],
+  [RUN_PROFILE.SHOT_FACTORY, factoryShot],
+  [RUN_PROFILE.SHOT_LINKS, linksShot],
+  [RUN_PROFILE.SHOT_AGENTS_START, agentsStartShot],
+  [RUN_PROFILE.SHOT_WIDTH, widthShot],
+]);
+
+/** Each shot as built, by its profile. */
+const built = new Map<string, ShotSpec>();
+
+/** The shot a run stages: one of the shot profiles in a fixture run, else none. */
+export function shotSpec(
+  run: { readonly fixtureMode: boolean; readonly profile: string } | undefined,
+): ShotSpec | undefined {
+  if (run === undefined || !run.fixtureMode) return undefined;
+  const build = BUILDERS.get(run.profile);
+  if (build === undefined) return undefined;
+  const held = built.get(run.profile);
+  if (held !== undefined) return held;
+  const spec = build();
+  built.set(run.profile, spec);
+  return spec;
+}
+
+/** The shot this window stages, read from the state as it stands; none before the state has arrived. */
+export function currentShot(): ShotSpec | undefined {
+  return shotSpec(appStateNow()?.run);
+}
+
+/** The update a shot draws: none to install, so no Update pill; a run with no shot keeps the fixture's. */
+export function shotUpdate(update: UpdateSnapshot): UpdateSnapshot {
+  if (currentShot() === undefined) return update;
+  return {
+    status: UPDATE_STATUS.IDLE,
+    currentVersion: update.currentVersion,
+    installSupported: true,
+    upToDate: true,
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/shot-spec.ts b/apps/desktop/src/renderer/shots/shot-spec.ts
new file mode 100644
index 000000000..bf0e8417d
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/shot-spec.ts
@@ -0,0 +1,102 @@
+/**
+ * shot-spec.ts -- what one changelog shot stages: the plans and canned answers it draws, and the layout it opens on.
+ *
+ * Throwaway: the 0.13.0 changelog screenshots' staging, applied on a Mac to
+ * the release commit and never committed. Only types and one marker live
+ * here, so every shot module and every hook into the app can import it
+ * without an evaluation-order cycle.
+ */
+
+import type { TasksView } from "@luke/features/tasks-view";
+import type { ActKind, ActPayload, ActResultFor } from "@luke/host/acts";
+import type { AppInboxTask, AppInboxTaskHolding } from "@luke/host/app-state";
+import type { VoiceView } from "@luke/voice/voice-view";
+import type { SidebarCollapse } from "../desktop/sidebar-collapse";
+import type { MainTab } from "../planning/use-main-tabs";
+import type { HistorySpot } from "../planning/use-plan-history";
+import type { PlansControl } from "../planning/use-plans-tab";
+import type { SidePanelState, SidePanelTab } from "../planning/use-side-panel";
+import type { SettingsView } from "@luke/settings/settings-views";
+import type { Experiment } from "@luke/settings";
+
+/** An answer that never settles: what a long-poll loop is handed once it has read what it will read. */
+export const NEVER: unique symbol = Symbol("shot-never");
+
+/**
+ * One kind's canned answer, from its payload: a value its own guard admits,
+ * {@link NEVER} for a read held open forever, or nothing to let the act go
+ * to main as it would.
+ */
+export type ShotAnswer<Kind extends ActKind> = (
+  payload: ActPayload<Kind>,
+) => ActResultFor<Kind> | typeof NEVER | undefined;
+
+/** Every kind a shot answers itself, each by its own answer. */
+export type ShotAnswers = { readonly [Kind in ActKind]?: ShotAnswer<Kind> };
+
+/** What the staging effect hands each step: the Plans tab, the sidebar, and the way into Settings. */
+export interface ShotStageContext {
+  readonly plans: PlansControl;
+  readonly sidebar: SidebarCollapse;
+  readonly openSettings: (view: SettingsView) => void;
+}
+
+/** One staging step, run once, the first render it is ready on. */
+export interface ShotStep {
+  readonly key: string;
+  readonly ready: (context: ShotStageContext) => boolean;
+  readonly run: (context: ShotStageContext) => void;
+}
+
+/**
+ * The window's layout as the shot opens on it, each staged once the thing
+ * it needs is drawn. Anything left out stays as the fixture run opens it.
+ */
+export interface ShotLayout {
+  /** Folds the sidebar away. */
+  readonly sidebarCollapsed?: boolean;
+  /** Pins the plan's summary open; shots keep it folded to its rail unless they ask. */
+  readonly summaryPinned?: boolean;
+  /** The side panel fills the window over the plan's column. */
+  readonly sidePanelFullScreen?: boolean;
+  /** Tabs chosen in the side panel once the plan is drawn, in order, the last one shown: a Changes or a Page tab, which a staged state cannot hold. */
+  readonly sidePanelTabs?: readonly SidePanelTab[];
+  /** A file of the plan's repository opened in a tab of its own, as the palette opens one. */
+  readonly sidePanelFile?: string;
+  /** The plan's column's tab: its Inbox, or an agent's, chosen once the agent is listed. */
+  readonly mainTab?: MainTab;
+  /** Opens Settings on a page. */
+  readonly settingsView?: SettingsView;
+  /** Opens the plan's version history where it stood: on a revision, with its sections open. */
+  readonly history?: HistorySpot;
+  /** The sidebar plan whose hover card stands open. */
+  readonly hoverPlanId?: string;
+  /** Draws every section's "Edited by" byline, which otherwise shows only under the pointer. */
+  readonly bylines?: boolean;
+}
+
+/** One shot: everything it draws in place of the fixture's, and how it is laid out. */
+export interface ShotSpec {
+  /** The plans the Plans tab draws, its open one included. */
+  readonly planning: TasksView;
+  /** The side panel the open plan starts with; referentially stable, as the spec is built once. */
+  readonly sidePanel?: SidePanelState;
+  /** The call standing on the open plan, as the voice window would report it; none for every shot but the Call tab's. */
+  readonly call?: Pick<VoiceView, "voiceStatus" | "callTaskId" | "callTranscript">;
+  /** The account id the plan is read as, so the reader's own edits, calls, and member row say "you"; none reads nobody as the reader. */
+  readonly readerId?: string;
+  /** The acts the shot answers itself (`canned-acts.ts`). */
+  readonly answers?: ShotAnswers;
+  /** What main would say waits on the developer: the sidebar's Inbox count and the window's Inbox. */
+  readonly inbox?: {
+    readonly waiting: readonly AppInboxTask[];
+    readonly plans: readonly AppInboxTaskHolding[];
+  };
+  readonly layout?: ShotLayout;
+  /** Staging the layout cannot say, run after it (`use-shot-staging.ts`). */
+  readonly steps?: readonly ShotStep[];
+  /** The experiments the shot draws as switched on in Settings › Experimental (`use-app-state.ts`'s `useExperiment`). */
+  readonly experiments?: readonly Experiment[];
+  /** The sidebar's plans drawn unread, in the semibold a plan saved since its last look wears; a staged run otherwise draws none. */
+  readonly unreadPlanIds?: readonly string[];
+}
