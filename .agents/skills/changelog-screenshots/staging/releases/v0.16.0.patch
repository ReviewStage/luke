diff --git a/apps/desktop/src/renderer/shots/switcher.ts b/apps/desktop/src/renderer/shots/switcher.ts
new file mode 100644
index 000000000..3ccc1b894
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/switcher.ts
@@ -0,0 +1,197 @@
+/**
+ * switcher.ts -- shot "Workspaces, clearer": the sidebar's head on acme, by its photo, name, and members, with the workspace switcher held open over Home.
+ *
+ * Throwaway (`README.md`). SPEC row 4. The window rests on Home (no plan
+ * open, `plansPage`), the sidebar open on acme's plans, some unread. The
+ * workspaces are listed as the service lists them, the account's own first
+ * workspace first and the rest by name: Dean Stratakos (personal, drawn with
+ * Dean's photo, which the list carries as `pictureUrl`, "Personal
+ * workspace"), acme (its photo, the acme mark as a PNG read through
+ * `WORKSPACE_PHOTO_READ`, "5 members"), and Harbor Labs (no photo, its "H" on
+ * hue 1 read off its id, "4 members"). The switcher reads the first listed
+ * as the personal one, so the list is not reordered; a staging step lists
+ * acme instead, which with no plan open switches nothing else and raises no
+ * toast. A second step holds the switcher open: once the window has settled
+ * at its size it presses the head whenever the menu is not standing (a
+ * window blur or resize closes it), and takes focus off the first item so no
+ * row is lit as if the pointer rested on it.
+ */
+
+import type { TaskSummary } from "@luke/features/task-wire";
+import { TASKS_READ, type TasksView } from "@luke/features/tasks-view";
+import {
+  WORKSPACE_PHOTO_TYPE,
+  WORKSPACE_ROLE,
+  type Workspace,
+  type WorkspaceMember,
+} from "@luke/features/workspace-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ACME_PHOTO_PNG_BASE64 } from "./acme-photo";
+import { LAUNCHED_AT } from "./clock";
+import { codingAgentAnswers } from "./coding-agent";
+import { DEAN_AVATAR_DATA_URL } from "./dean-avatar";
+import {
+  SHOT_ID,
+  shotArchivedPlan,
+  shotOtherPlans,
+  shotTasksView,
+  shotTaskSummary,
+} from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+
+/** The third workspace, Dean a member of a team he does not own; its id reads hue 1 (indigo). */
+const RELAY_LABS_ID = "wks_relay3Vn6Jt2";
+
+/** How long after launch the switcher is first pressed, so the window has its size, which a resize would close the menu over. */
+const SETTLE_MS = 1500;
+
+/** How often the hold looks that the switcher still stands open. */
+const HOLD_EVERY_MS = 250;
+
+/** The head's button, whose `aria-expanded` says whether its menu stands. */
+const SWITCHER = ".sidebar-workspace-toggle";
+
+/** acme photo's version, as the list names the photo standing. */
+const ACME_PHOTO_VERSION = "5f3c9a1e7b2d4c80";
+
+/** Dean's three workspaces, as `GET /api/workspaces` lists them: his own first, then the rest by name. */
+function switcherWorkspaces(): Workspace[] {
+  return [
+    {
+      id: SHOT_ID.WORKSPACE_PERSONAL,
+      name: "Dean Stratakos",
+      slug: "dean-stratakos",
+      role: WORKSPACE_ROLE.OWNER,
+      github: null,
+      memberCount: 1,
+      pictureUrl: DEAN_AVATAR_DATA_URL,
+      personal: true,
+    },
+    {
+      id: SHOT_ID.WORKSPACE,
+      name: "acme",
+      slug: "acme",
+      role: WORKSPACE_ROLE.OWNER,
+      github: { login: "acme", active: true },
+      memberCount: 5,
+      photoVersion: ACME_PHOTO_VERSION,
+    },
+    {
+      id: RELAY_LABS_ID,
+      name: "Harbor Labs",
+      slug: "harbor-labs",
+      role: WORKSPACE_ROLE.MEMBER,
+      github: { login: "harbor-labs", active: true },
+      memberCount: 4,
+    },
+  ];
+}
+
+/** acme's five members, owners, then admins, then members, each by name, as 0.13.0 had them. */
+function acmeMembers(): WorkspaceMember[] {
+  return [
+    {
+      userId: "usr_dean8Kf3Qz1",
+      name: "Dean Stratakos",
+      email: "dean@example.com",
+      role: WORKSPACE_ROLE.OWNER,
+      pictureUrl: DEAN_AVATAR_DATA_URL,
+    },
+    {
+      userId: "usr_dana2Wm7Hx4",
+      name: "Dana Moreno",
+      email: "dana@acme.dev",
+      role: WORKSPACE_ROLE.ADMIN,
+    },
+    {
+      userId: "usr_jord5Np2Lc8",
+      name: "Jordan Lee",
+      email: "jordan@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+    {
+      userId: "usr_priy9Tb6Rv3",
+      name: "Priya Raman",
+      email: "priya@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+    {
+      userId: "usr_theo3Gs1Yk7",
+      name: "Theo Walsh",
+      email: "theo@acme.dev",
+      role: WORKSPACE_ROLE.MEMBER,
+    },
+  ];
+}
+
+/** acme's plans and its archived one, all in acme, so the sidebar lists them under acme. */
+function acmePlans(): TaskSummary[] {
+  return [shotTaskSummary(), ...shotOtherPlans(), shotArchivedPlan()];
+}
+
+/** The plan list read and no plan open: the Plans tab draws Home. */
+function homeTasksView(): TasksView {
+  const {
+    activeTaskId: _open,
+    transcript: _transcript,
+    work: _work,
+    shownCode: _shownCode,
+    ...list
+  } = shotTasksView({
+    plans: acmePlans(),
+    extra: { workspaces: switcherWorkspaces() },
+  });
+  return { ...list, document: { status: TASKS_READ.IDLE } };
+}
+
+/** Lists acme, once the workspaces are read and the first (Dean's own) is listed, as a fixture run lists. */
+const listAcme: ShotStep = {
+  key: "switcher-list-acme",
+  ready: ({ plans }) => plans.workspace !== undefined && plans.workspace.id !== SHOT_ID.WORKSPACE,
+  run: ({ plans }) => plans.onChooseWorkspace(SHOT_ID.WORKSPACE),
+};
+
+/** Presses the head whenever its menu is not standing, and lets go of the focus the menu puts on its first item. */
+function holdSwitcherOpen(): void {
+  const toggle = document.querySelector<HTMLButtonElement>(SWITCHER);
+  if (toggle === null) return;
+  if (toggle.getAttribute("aria-expanded") !== "true") {
+    toggle.click();
+    return;
+  }
+  const focused = document.activeElement;
+  if (focused instanceof HTMLElement && focused.closest('[role="menu"]') !== null) focused.blur();
+}
+
+/** Holds the switcher open from the moment the window has settled, once acme is listed. */
+const holdSwitcher: ShotStep = {
+  key: "switcher-hold-open",
+  ready: ({ plans, sidebar }) =>
+    plans.workspace?.id === SHOT_ID.WORKSPACE && sidebar.staged && !sidebar.collapsed,
+  run: () => {
+    const wait = Math.max(0, LAUNCHED_AT + SETTLE_MS - Date.now());
+    window.setTimeout(() => window.setInterval(holdSwitcherOpen, HOLD_EVERY_MS), wait);
+  },
+};
+
+export function switcherShot(): ShotSpec {
+  const members = acmeMembers();
+  return {
+    planning: homeTasksView(),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: {
+      ...codingAgentAnswers(),
+      // Note that each read is asked once per drawing, never in a loop, so it is answered every time.
+      [ACT_KIND.WORKSPACE_PHOTO_READ]: ({ workspaceId }) =>
+        workspaceId === SHOT_ID.WORKSPACE
+          ? { contentType: WORKSPACE_PHOTO_TYPE.PNG, base64: ACME_PHOTO_PNG_BASE64 }
+          : undefined,
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: ({ workspaceId }) =>
+        workspaceId === SHOT_ID.WORKSPACE ? members : undefined,
+    },
+    unreadPlanIds: [SHOT_ID.BILLING, SHOT_ID.WEBHOOKS, SHOT_ID.ONBOARDING],
+    layout: { sidebarCollapsed: false },
+    steps: [listAcme, holdSwitcher],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/team-world.ts b/apps/desktop/src/renderer/shots/team-world.ts
new file mode 100644
index 000000000..b0030181d
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/team-world.ts
@@ -0,0 +1,225 @@
+/**
+ * team-world.ts -- acme's tasks as its five members share them: who created each, who started each agent, and what each agent published, for the shots about people and the work in flight (a person's page, the Factory).
+ *
+ * Throwaway (`README.md`). Dean created Teammate invitations and started its
+ * finished agent; Dana started its running "Invite emails" and created
+ * Usage-based billing, Webhook retries, and Onboarding checklist, each with
+ * an agent of hers. Jordan, Priya, and Theo created the rest. Every agent id
+ * is a UUID and every model one the release's catalog lists.
+ */
+
+import type {
+  TaskAgentLine,
+  TaskAgentsSummary,
+  TaskPullRequestLine,
+  TaskSummary,
+} from "@luke/features/task-wire";
+import { ago, hoursAgo } from "./clock";
+import { MODEL } from "./coding-agent";
+import { AGENT_2_TITLE, AGENT_TITLE, SHOT_ID, shotOtherPlans, shotTaskSummary } from "./plan-document";
+import { MEMBER } from "./who";
+
+/** The other tasks' agents, one each, by id. */
+export const TEAM_AGENT = {
+  METER: "ad4c2e03-8fb0-4cd9-9ef1-b0c1d2e3f40a",
+  WEBHOOKS: "be5d3f14-9ac1-4dea-8f02-c1d2e3f4a51b",
+  ONBOARDING: "cf6e4a25-abd2-4efb-9a13-d2e3f4a5b62c",
+  AUDIT: "d07f5b36-bce3-4f0c-8b24-e3f4a5b6c73d",
+  DARK_MODE: "e18a6c47-cdf4-4a1d-9c35-f4a5b6c7d84e",
+  INVOICE: "f29b7d58-de05-4b2e-8d46-a5b6c7d8e95f",
+  WITHDRAW: "0a3c8e69-ef16-4c3f-9e57-b6c7d8e9fa60",
+  USAGE_LINE: "1b4d9f7a-f027-4d40-8f68-c7d8e9fa0b71",
+  ILLUSTRATIONS: "2c5ea08b-0138-4e51-9a79-d8e9fa0b1c82",
+} as const;
+
+/** Who created each task, by its id. */
+const CREATOR: Readonly<Record<string, (typeof MEMBER)[keyof typeof MEMBER]>> = {
+  [SHOT_ID.PLAN]: MEMBER.DEAN,
+  [SHOT_ID.BILLING]: MEMBER.DANA,
+  [SHOT_ID.WEBHOOKS]: MEMBER.DANA,
+  [SHOT_ID.ONBOARDING]: MEMBER.DANA,
+  [SHOT_ID.AUDIT]: MEMBER.JORDAN,
+  [SHOT_ID.RATE_LIMITS]: MEMBER.PRIYA,
+  [SHOT_ID.DARK_MODE]: MEMBER.THEO,
+};
+
+/** One task's agents and pull requests, counted. */
+function summary(agents: TaskAgentLine[], pullRequests: TaskPullRequestLine[]): TaskAgentsSummary {
+  return {
+    total: agents.length,
+    working: agents.filter((agent) => agent.status === "running" || agent.status === "starting")
+      .length,
+    agents,
+    pullRequestTotal: pullRequests.length,
+    pullRequests,
+  };
+}
+
+/** One agent line. */
+function line(
+  id: string,
+  title: string,
+  model: string,
+  effort: string,
+  status: TaskAgentLine["status"],
+  at: number,
+  startedBy: (typeof MEMBER)[keyof typeof MEMBER],
+): TaskAgentLine {
+  return { id, title, model, effort, status, at, startedBy };
+}
+
+/** One pull request line. */
+function pr(
+  repository: string,
+  number: number,
+  title: string,
+  state: TaskPullRequestLine["state"],
+  checks: TaskPullRequestLine["checks"],
+  additions: number,
+  deletions: number,
+): TaskPullRequestLine {
+  return {
+    number,
+    title,
+    state,
+    checks,
+    additions,
+    deletions,
+    url: `https://github.com/${repository}/pull/${String(number)}`,
+  };
+}
+
+/** Each task's agents, by its id. */
+function agentsOf(planId: string): TaskAgentsSummary | undefined {
+  switch (planId) {
+    case SHOT_ID.PLAN:
+      return summary(
+        [
+          line(SHOT_ID.AGENT_2, AGENT_2_TITLE, MODEL.SOL, "high", "running", ago(6), MEMBER.DANA),
+          line(TEAM_AGENT.WITHDRAW, "Withdraw invites from Members", MODEL.SONNET, "high", "running", ago(11), MEMBER.JORDAN),
+          line(SHOT_ID.AGENT, AGENT_TITLE, MODEL.OPUS, "high", "completed", ago(12), MEMBER.DEAN),
+        ],
+        [
+          pr("acme/relay", 214, "Add teammate invitations", "open", "passing", 412, 38),
+          pr("acme/relay", 216, "Send invite emails through Postmark", "draft", "pending", 96, 4),
+          pr("acme/relay", 217, "Expire invite links after 7 days", "open", "passing", 41, 6),
+        ],
+      );
+    case SHOT_ID.BILLING:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.METER,
+            "Meter API calls per workspace",
+            MODEL.SONNET,
+            "medium",
+            "running",
+            ago(9),
+            MEMBER.DANA,
+          ),
+          line(TEAM_AGENT.USAGE_LINE, "Show usage on the invoice", MODEL.OPUS, "medium", "running", ago(21), MEMBER.PRIYA),
+        ],
+        [pr("acme/ledger", 88, "Record usage events per workspace", "draft", "pending", 203, 12)],
+      );
+    case SHOT_ID.WEBHOOKS:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.WEBHOOKS,
+            "Retry failed webhook deliveries",
+            MODEL.OPUS,
+            "high",
+            "completed",
+            hoursAgo(2.1),
+            MEMBER.DANA,
+          ),
+        ],
+        [
+          pr("acme/relay", 209, "Retry failed webhook deliveries with backoff", "merged", "passing", 238, 17),
+          pr("acme/relay", 207, "Record each webhook delivery attempt", "merged", "passing", 121, 6),
+        ],
+      );
+    case SHOT_ID.ONBOARDING:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.ONBOARDING,
+            "Build the onboarding checklist",
+            MODEL.SOL,
+            "high",
+            "completed",
+            hoursAgo(4.3),
+            MEMBER.DANA,
+          ),
+          line(TEAM_AGENT.ILLUSTRATIONS, "Wire in the step illustrations", MODEL.SONNET, "medium", "running", ago(3), MEMBER.THEO),
+        ],
+        [
+          pr("acme/web", 131, "Add the onboarding checklist to the dashboard", "open", "passing", 187, 9),
+          pr("acme/web", 129, "Track checklist steps per workspace", "merged", "passing", 96, 3),
+        ],
+      );
+    case SHOT_ID.AUDIT:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.AUDIT,
+            "Export the audit log as CSV",
+            MODEL.OPUS,
+            "medium",
+            "running",
+            ago(2),
+            MEMBER.JORDAN,
+          ),
+        ],
+        [],
+      );
+    case SHOT_ID.DARK_MODE:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.DARK_MODE,
+            "Dark palette for charts",
+            MODEL.SONNET,
+            "high",
+            "running",
+            ago(14),
+            MEMBER.THEO,
+          ),
+        ],
+        [pr("acme/web", 135, "Theme the usage charts for dark mode", "draft", "pending", 64, 21)],
+      );
+    case SHOT_ID.RATE_LIMITS:
+      return summary(
+        [
+          line(
+            TEAM_AGENT.INVOICE,
+            "Redesign the invoice PDF header",
+            MODEL.SOL,
+            "medium",
+            "completed",
+            hoursAgo(5.2),
+            MEMBER.PRIYA,
+          ),
+        ],
+        [
+          pr("acme/ledger", 91, "Redesign the invoice PDF header", "merged", "passing", 142, 88),
+          pr("acme/ledger", 90, "Embed the invoice fonts", "merged", "passing", 38, 5),
+        ],
+      );
+    default:
+      return undefined;
+  }
+}
+
+/** acme's tasks, each with its creator and its agents. */
+export function teamPlans(): TaskSummary[] {
+  return [shotTaskSummary(), ...shotOtherPlans()].map((plan) => {
+    const agents = agentsOf(plan.id);
+    const createdBy = CREATOR[plan.id];
+    return {
+      ...plan,
+      ...(createdBy === undefined ? undefined : { createdBy, ownerId: createdBy.userId }),
+      ...(agents === undefined ? undefined : { agents }),
+    };
+  });
+}
diff --git a/apps/desktop/src/renderer/shots/terminal.ts b/apps/desktop/src/renderer/shots/terminal.ts
new file mode 100644
index 000000000..edec1d338
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/terminal.ts
@@ -0,0 +1,191 @@
+/**
+ * terminal.ts -- shot "The Terminal tab": the finished agent's Terminal tab, full screen, a shell that has just run the members tests and three shells beside it.
+ *
+ * Throwaway (`README.md`). See `.context/shots/SPEC.md` row 1. The plan
+ * "Teammate invitations" opens with the sidebar folded; a step opens the
+ * finished agent "Add teammate invitations"'s Terminal tab in the side panel
+ * as ⌘J does (`sidePanel.onChoose({ terminal })`, `terminal-commands.tsx`)
+ * once the agent is listed, and the layout's full-screen step then fills the
+ * window with it, so no plan document shows.
+ *
+ * The tab is the release's own (`planning/terminal-tab.tsx`,
+ * `use-terminal-session.ts`) and every step of its connection runs as it
+ * does against a live sandbox: `terminal.list` is answered with three shells
+ * in a running sandbox, "tests" first (the oldest, which the tab attaches
+ * to), "dev server" with `node` in the foreground (the running mark), and
+ * "psql" back at its prompt in `src/db`; `terminal.attach` is answered by
+ * doing what main and the preload do, posting a fresh `MessagePort` to the
+ * window under `TERMINAL_PORT_CHANNEL` with the shell's ticket
+ * (`terminal/terminal-port.ts` reads it as the preload's), then saying
+ * `attached` on it and handing it the screen tmux would redraw on attach.
+ * So the bar reads "sandbox · connected" and the foot "Idle", with no hook
+ * into an app file at all. The attach itself never settles, which the tab
+ * reads as an attach still out (it only acts on a refusal).
+ *
+ * The bytes are invented: a `git log` of the agent's branch, then
+ * `pnpm test src/members` with vitest's colours, every file passing, and
+ * the prompt after. They begin by clearing the screen and its scrollback,
+ * as tmux's redraw does, so a second attach (the tab shown again) draws the
+ * same screen rather than a second copy below the first. AGENTS.md keeps a
+ * shell's real bytes out of every fixture; these are no shell's.
+ */
+
+import { TERMINAL_PORT_CHANNEL, TERMINAL_PORT_MESSAGE } from "@luke/features/terminal-acts";
+import { SANDBOX_STATE, type TerminalsAnswer } from "@luke/features/terminal-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { DOCUMENT_REGION } from "@luke/ui/tasks-model";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { LAUNCHED_AT } from "./clock";
+import { codingAgentAnswers } from "./coding-agent";
+import { SHOT_ID, shotTasksView } from "./plan-document";
+import { NEVER, type ShotSpec, type ShotStep } from "./shot-spec";
+
+/** The shells' ids, as the service mints them. */
+const SHELL_ID = {
+  TESTS: "3f1d9b2e-6a4c-4e8f-9b17-2c5d8e0a4f61",
+  DEV_SERVER: "7b2e4c6a-1d3f-4a5b-8c9d-0e1f2a3b4c5d",
+  PSQL: "c4a8e2f6-9b1d-4c3e-a5f7-8d0b2c4e6a19",
+} as const;
+
+/** Where the agent's checkout stands in its sandbox (`repository-shell.ts`). */
+const CHECKOUT = "/workspace/repository";
+
+/** The agent's shells, oldest first, as tmux lists them: the tests shell at its prompt, the dev server running, psql's shell back at its prompt. */
+const SHELLS: TerminalsAnswer = {
+  sandbox: SANDBOX_STATE.RUNNING,
+  terminals: [
+    { id: SHELL_ID.TESTS, title: "tests", command: "bash", cwd: CHECKOUT, running: false },
+    { id: SHELL_ID.DEV_SERVER, title: "dev server", command: "node", cwd: CHECKOUT, running: true },
+    { id: SHELL_ID.PSQL, title: "psql", command: "bash", cwd: `${CHECKOUT}/src/db`, running: false },
+  ],
+};
+
+/** The ANSI the screen is drawn in. */
+const ESC = {
+  RESET: "\x1b[0m",
+  BOLD: "\x1b[1m",
+  DIM: "\x1b[2m",
+  INVERSE: "\x1b[7m",
+  GREEN: "\x1b[32m",
+  YELLOW: "\x1b[33m",
+  BLUE: "\x1b[34m",
+  GRAY: "\x1b[90m",
+  BOLD_CYAN: "\x1b[1;36m",
+  BOLD_GREEN: "\x1b[1;32m",
+  BOLD_RED: "\x1b[1;31m",
+  /** What tmux's redraw opens with: the cursor home, the screen and its scrollback cleared. */
+  CLEAR: "\x1b[H\x1b[2J\x1b[3J",
+} as const;
+
+/** Amazon Linux's own bash prompt, as the sandbox's shell leaves it, standing in the checkout. */
+const PROMPT = "[vercel-sandbox@sbx-relay repository]$ ";
+
+/** One test file's line as vitest's default reporter prints it, its time yellow past 300ms. */
+function passed(file: string, tests: number, ms: number): string {
+  const time = ms > 300 ? `${ESC.YELLOW}${ms}ms${ESC.RESET}` : `${ESC.GRAY}${ms}ms${ESC.RESET}`;
+  return ` ${ESC.GREEN}✓${ESC.RESET} ${file} ${ESC.GRAY}(${tests} tests)${ESC.RESET} ${time}`;
+}
+
+/** A clock time as vitest's "Start at" prints it, in the window's own zone. */
+function clockTime(at: number): string {
+  const time = new Date(at);
+  return [time.getHours(), time.getMinutes(), time.getSeconds()]
+    .map((part) => String(part).padStart(2, "0"))
+    .join(":");
+}
+
+/** The members suite, every file passing: 54 tests in 7 files. */
+const TEST_FILES: readonly (readonly [string, number, number])[] = [
+  ["src/members/list.test.ts", 5, 96],
+  ["src/members/remove.test.ts", 5, 187],
+  ["src/members/roles.test.ts", 8, 143],
+  ["src/members/accept.test.ts", 9, 298],
+  ["src/members/withdraw.test.ts", 6, 241],
+  ["src/members/invite.test.ts", 14, 412],
+  ["src/members/invite-link.test.ts", 7, 165],
+];
+
+/** The screen tmux redraws on attach: the branch's log, the members tests run and passing, and the prompt after. */
+function screen(): string {
+  const files = TEST_FILES.length;
+  const tests = TEST_FILES.reduce((sum, [, count]) => sum + count, 0);
+  const startedAt = clockTime(LAUNCHED_AT - 40_000);
+  const label = (words: string) => `${ESC.DIM}${words}${ESC.RESET}`;
+  const total = (count: number) =>
+    `${ESC.BOLD_GREEN}${count} passed${ESC.RESET}${ESC.GRAY} (${count})${ESC.RESET}`;
+  const lines = [
+    `${PROMPT}git log --oneline -4`,
+    `${ESC.YELLOW}4f2c9e1 (${ESC.BOLD_CYAN}HEAD -> ${ESC.BOLD_GREEN}luke/teammate-invitations${ESC.RESET}${ESC.YELLOW}, ${ESC.BOLD_RED}origin/luke/teammate-invitations${ESC.RESET}${ESC.YELLOW})${ESC.RESET} Filter pending invites out of member queries`,
+    `${ESC.YELLOW}b81d07a${ESC.RESET} Accept an invite at /invites/:token`,
+    `${ESC.YELLOW}93e5a2c${ESC.RESET} Create pending memberships and mail the link from POST /invites`,
+    `${ESC.YELLOW}6d0f3b8${ESC.RESET} Add state, invite_token, and invited_by to memberships`,
+    `${PROMPT}pnpm test src/members`,
+    "",
+    "> relay@0.18.0 test /workspace/repository",
+    '> vitest run "src/members"',
+    "",
+    "",
+    `${ESC.INVERSE}${ESC.BOLD}${ESC.BLUE} RUN ${ESC.RESET} ${ESC.BLUE}v3.2.4 ${ESC.RESET}${ESC.GRAY}${CHECKOUT}${ESC.RESET}`,
+    "",
+    ...TEST_FILES.map(([file, count, ms]) => passed(file, count, ms)),
+    "",
+    `${label(" Test Files ")} ${total(files)}`,
+    `${label("      Tests ")} ${total(tests)}`,
+    `${label("   Start at ")} ${startedAt}`,
+    `${label("   Duration ")} 2.91s ${ESC.GRAY}(transform 388ms, setup 0ms, collect 1.42s, tests 1.54s, environment 1ms, prepare 612ms)${ESC.RESET}`,
+    "",
+    PROMPT,
+  ];
+  return ESC.CLEAR + lines.join("\r\n");
+}
+
+/** Every port the shot has handed out, held so the sending end outlives the call that made it. */
+const SENDERS: MessagePort[] = [];
+
+/**
+ * Hands the tab a shell's port as main and the preload would: posted to the
+ * window under the terminal channel with the shell's ticket, `attached` said
+ * on it, and the screen tmux redraws sent after. Note that the messages wait
+ * in the port's queue until the tab starts it, as they would from main.
+ */
+function postShell(agentId: string, terminalId: string): void {
+  const channel = new MessageChannel();
+  SENDERS.push(channel.port2);
+  window.postMessage(
+    { channel: TERMINAL_PORT_CHANNEL, ticket: { agentId, terminalId } },
+    "*",
+    [channel.port1],
+  );
+  channel.port2.postMessage({ type: TERMINAL_PORT_MESSAGE.STATE, state: "attached" });
+  const data = new TextEncoder().encode(screen());
+  channel.port2.postMessage({ type: TERMINAL_PORT_MESSAGE.OUTPUT, data });
+}
+
+/** Opens the finished agent's Terminal tab as ⌘J does, once the plan is drawn and its agents are read. */
+const OPEN_TERMINAL: ShotStep = {
+  key: "terminal-open-tab",
+  ready: ({ plans }) =>
+    plans.region.kind === DOCUMENT_REGION.READY &&
+    (plans.agents.agentIds?.includes(SHOT_ID.AGENT) ?? false),
+  run: ({ plans }) => plans.sidePanel.onChoose({ terminal: SHOT_ID.AGENT }),
+};
+
+export function terminalShot(): ShotSpec {
+  return {
+    planning: shotTasksView({}),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    answers: {
+      ...codingAgentAnswers(),
+      // Note that the list is read every few seconds while the tab shows, never as soon as it lands, so it is answered every time.
+      [ACT_KIND.TERMINAL_LIST]: (payload) =>
+        payload.agentId === SHOT_ID.AGENT ? SHELLS : undefined,
+      [ACT_KIND.TERMINAL_ATTACH]: (payload) => {
+        if (payload.agentId !== SHOT_ID.AGENT) return undefined;
+        postShell(payload.agentId, payload.terminalId);
+        return NEVER;
+      },
+    },
+    layout: { sidebarCollapsed: true, sidePanelFullScreen: true },
+    steps: [OPEN_TERMINAL],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/use-shot-staging.ts b/apps/desktop/src/renderer/shots/use-shot-staging.ts
new file mode 100644
index 000000000..2236893d0
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/use-shot-staging.ts
@@ -0,0 +1,132 @@
+/**
+ * use-shot-staging.ts -- the one fixture-only effect that lays a shot's window out: the sidebar, the side panel, the plan's column, Settings, and the version history, each once, the first render it can be.
+ *
+ * Throwaway (`README.md`). Called from `App` with the Plans tab and the
+ * sidebar. Each step of the shot's layout (`ShotLayout`) and each step of
+ * its own (`ShotSpec.steps`) runs once, the first render on which what it
+ * needs is drawn: a plan's tab once the plan is drawn, an agent's once the
+ * agent is listed, a full-screen panel once the panel is open.
+ */
+
+import { useEffect, useRef } from "react";
+import { DOCUMENT_REGION } from "@luke/ui/tasks-model";
+import { isAgentTab } from "@luke/ui/tab-strip-model";
+import type { SidePanelTab } from "../planning/use-side-panel";
+import { currentShot } from "./shot-profiles";
+import type { ShotSpec, ShotStageContext, ShotStep } from "./shot-spec";
+
+/** The open plan, once it is drawn; none before. */
+function drawnPlan(context: ShotStageContext): string | undefined {
+  const { plans } = context;
+  return plans.region.kind === DOCUMENT_REGION.READY ? plans.activePlanId : undefined;
+}
+
+/** Whether a side panel tab can be chosen yet: a Changes tab once the agents are read, a page's once the plan names it. */
+function tabReady(context: ShotStageContext, tab: SidePanelTab): boolean {
+  const { plans } = context;
+  if (typeof tab === "object" && "changes" in tab)
+    return plans.agents.agentIds?.includes(tab.changes) ?? false;
+  if (typeof tab === "object" && "page" in tab)
+    return (plans.pages ?? []).some((page) => page.id === tab.page);
+  return true;
+}
+
+/** The steps a shot's layout asks for, in the order they run. */
+function layoutSteps(shot: ShotSpec): ShotStep[] {
+  const layout = shot.layout ?? {};
+  const steps: ShotStep[] = [];
+  const { sidebarCollapsed, settingsView, history, mainTab, sidePanelTabs, sidePanelFile } = layout;
+  if (layout.bylines === true) {
+    steps.push({
+      key: "bylines",
+      ready: () => true,
+      run: () => {
+        document.documentElement.dataset.shotBylines = "true";
+      },
+    });
+  }
+  if (sidebarCollapsed !== undefined) {
+    steps.push({
+      key: "sidebar",
+      ready: ({ sidebar }) => sidebar.staged,
+      run: ({ sidebar }) => {
+        if (sidebar.collapsed !== sidebarCollapsed) sidebar.onToggle();
+      },
+    });
+  }
+  if (settingsView !== undefined) {
+    steps.push({
+      key: "settings",
+      ready: () => true,
+      run: ({ openSettings }) => openSettings(settingsView),
+    });
+  }
+  if (history !== undefined) {
+    steps.push({
+      key: "history",
+      ready: (context) => drawnPlan(context) !== undefined,
+      run: (context) => {
+        const planId = drawnPlan(context);
+        if (planId !== undefined) context.plans.history.onReturn(planId, history);
+      },
+    });
+  }
+  if (mainTab !== undefined) {
+    steps.push({
+      key: "main-tab",
+      ready: (context) =>
+        drawnPlan(context) !== undefined &&
+        (!isAgentTab(mainTab) || (context.plans.agents.agentIds?.includes(mainTab.agent) ?? false)),
+      run: (context) => {
+        const planId = drawnPlan(context);
+        if (planId === undefined) return;
+        if (isAgentTab(mainTab)) context.plans.onShowAgent(planId, mainTab.agent);
+        else context.plans.onShowInbox(planId);
+      },
+    });
+  }
+  if (sidePanelTabs !== undefined && sidePanelTabs.length > 0) {
+    steps.push({
+      key: "side-panel-tabs",
+      ready: (context) =>
+        drawnPlan(context) !== undefined && sidePanelTabs.every((tab) => tabReady(context, tab)),
+      run: ({ plans }) => {
+        for (const tab of sidePanelTabs) plans.sidePanel.onChoose(tab);
+      },
+    });
+  }
+  if (sidePanelFile !== undefined) {
+    steps.push({
+      key: "side-panel-file",
+      ready: (context) => drawnPlan(context) !== undefined,
+      run: ({ plans }) => plans.sidePanel.onBrowseFile(sidePanelFile, sidePanelFile, true),
+    });
+  }
+  if (layout.sidePanelFullScreen === true) {
+    steps.push({
+      key: "full-screen",
+      ready: (context) => drawnPlan(context) !== undefined && context.plans.sidePanel.open,
+      run: ({ plans }) => {
+        if (!plans.sidePanel.fullScreen) plans.sidePanel.onToggleFullScreen();
+      },
+    });
+  }
+  return steps;
+}
+
+/** Stages the shot this run is for, if any; `known` once the state has arrived and the window is past its gate. */
+export function useShotStaging(context: ShotStageContext, known: boolean): void {
+  const done = useRef(new Set<string>());
+  const latest = useRef(context);
+  latest.current = context;
+  useEffect(() => {
+    if (!known) return;
+    const shot = currentShot();
+    if (shot === undefined) return;
+    for (const step of [...layoutSteps(shot), ...(shot.steps ?? [])]) {
+      if (done.current.has(step.key) || !step.ready(latest.current)) continue;
+      done.current.add(step.key);
+      step.run(latest.current);
+    }
+  });
+}
diff --git a/apps/desktop/src/renderer/shots/who.ts b/apps/desktop/src/renderer/shots/who.ts
