+  EXPIRED: "d2e3f4a5-b6c7-4d8e-9f0a-1b2c3d4e5f60",
+  /** Settled: the decision the pane shows. */
+  TTL: "e3f4a5b6-c7d8-4e9f-8a1b-2c3d4e5f6071",
