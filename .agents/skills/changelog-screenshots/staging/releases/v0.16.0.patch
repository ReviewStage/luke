+        {
+          type: INBOX_BLOCK.MARKDOWN,
+          text: "This is `/invites/:token` once a link has expired. It sends the visitor to an admin; should it let them ask for a new invite in one press instead?",
+        },
+        {
+          type: INBOX_BLOCK.IMAGE,
