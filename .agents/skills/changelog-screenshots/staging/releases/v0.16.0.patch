+/**
+ * factory.ts -- 0.15.0 shot "Experiments: the Factory": Talk, Build, and Ship over acme's work, with the task on Dean's call, the agents at work and what waits on him, and what is ready to merge or merged today.
+ *
+ * Throwaway (`README.md`). The sidebar folded, the Factory standing in the
+ * plan's place (`desktop/desktop-factory.tsx`). Talk holds Teammate
+ * invitations, the call standing on it as the voice window would report it
+ * (`call`); Build leads with the questions agents asked and lists the agents
+ * at work and the drafts; Ship leads with #214 and #131 ready to merge and
+ * lists what merged today. Everything is read from acme's task list
+ * (`team-world.ts`) and the Inbox (`inbox-world.ts`).
+ */
+
+import { LIVE_STATUS } from "@luke/live";
+import { ACT_KIND } from "@luke/host/acts";
+import { EXPERIMENT } from "@luke/settings";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { codingAgentAnswers } from "./coding-agent";
+import { holdings, inboxPage, ITEM_ID, waitingOf } from "./inbox-world";
+import { SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** Opens the Factory, as its sidebar row does, once acme is listed. */
+const OPEN_FACTORY: ShotStep = {
+  key: "factory-open",
+  ready: ({ plans }) => plans.workspace?.id === SHOT_ID.WORKSPACE && plans.plans.length > 0,
+  run: ({ plans }) => plans.factoryView.onOpen(),
+};
+
+export function factoryShot(): ShotSpec {
+  const members = acmeMembers();
+  const held = holdings().filter(
+    (holding) => holding.taskId === SHOT_ID.PLAN || holding.taskId === SHOT_ID.ONBOARDING,
+  );
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    call: { voiceStatus: LIVE_STATUS.LISTENING, callTaskId: SHOT_ID.PLAN, callTranscript: undefined },
+    experiments: [EXPERIMENT.FACTORY],
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.CODING_AGENTS_INBOX]: (payload) => inboxPage(payload.taskId, payload.after),
+    },
+    inbox: {
+      waiting: [
+        { taskId: SHOT_ID.PLAN, items: waitingOf(SHOT_ID.PLAN, [ITEM_ID.POSTMARK, ITEM_ID.EXPIRED]) },
+        { taskId: SHOT_ID.ONBOARDING, items: waitingOf(SHOT_ID.ONBOARDING, [ITEM_ID.FIRST_STEP]) },
+      ],
+      plans: held,
+    },
+    layout: { sidebarCollapsed: true },
+    steps: [OPEN_FACTORY],
+  };
+}
