index 000000000..960d7a8c6
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/agent-pictures.ts
@@ -0,0 +1,139 @@
+/**
+ * agent-pictures.ts -- 0.15.0 shot "Pictures from coding agents": the finished agent's transcript, which showed three Relay screenshots from its sandbox, with the picture viewer held open over it on the second.
+ *
+ * Throwaway (`README.md`). The plan's column on the "Add teammate
+ * invitations" agent, side panel closed. The agent's turn ends with a
+ * `show_image` call of three pictures, drawn as one row in place
+ * (`agent-pictures.tsx`), and a step presses the row's second tile so the
+ * release's own viewer opens over the window with Add to plan in its head.
+ */
+
+import type { CodingAgentMessagesAnswerView } from "@luke/features/coding-agent-view";
+import type { CodingAgentMessage } from "@luke/features/coding-agent-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { codingAgentAnswers } from "./coding-agent";
+import { SHOT_ID, shotOtherPlans, shotPlan, shotTasksView, shotTaskSummary } from "./plan-document";
+import { RELAY_ACCEPT_JPEG, RELAY_DIALOG_JPEG, RELAY_MEMBERS_JPEG } from "./relay-pictures";
+import { NEVER, type ShotSpec, type ShotStep } from "./shot-spec";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** The three pictures the agent showed, by the ids the service kept them under. */
+const PICTURES = [
+  {
+    id: "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e51",
+    path: "/tmp/shots/invite-dialog.jpg",
+    caption: "Invite dialog with two addresses as chips",
+    base64: RELAY_DIALOG_JPEG,
+  },
+  {
+    id: "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e52",
+    path: "/tmp/shots/members-pending.jpg",
+    caption: "Members with the two pending invites and Withdraw",
+    base64: RELAY_MEMBERS_JPEG,
+  },
+  {
+    id: "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e53",
+    path: "/tmp/shots/accept-invite.jpg",
+    caption: "The accept page sam@acme.dev lands on",
+    base64: RELAY_ACCEPT_JPEG,
+  },
+] as const;
+
+/** The `show_image` call and the words around it, closing the agent's turn. */
+function picturesParts() {
+  return [
+    {
+      type: "tool-bash",
+      toolCallId: "call_9p",
+      state: "output-available",
+      input: {
+        command:
+          "playwright screenshot --wait-for-timeout=2000 http://localhost:3000/members /tmp/shots/members-pending.jpg",
+        description: "Screenshot the members page",
+      },
+      output: { status: "completed", exitCode: 0, stdout: "", stderr: "", truncated: false },
+    },
+    {
+      type: "tool-show_image",
+      toolCallId: "call_9q",
+      state: "output-available",
+      input: { images: PICTURES.map(({ path, caption }) => ({ path, caption })) },
+      output: {
+        status: "accepted",
+        pictures: PICTURES.map(({ id, base64 }) => ({
+          id,
+          mediaType: "image/jpeg",
+          width: 1770,
+          height: 990,
+          byteCount: Math.round((base64.length * 3) / 4),
+        })),
+      },
+    },
+    { type: "step-start" },
+    {
+      type: "text",
+      text:
+        "Here is the flow on the preview: the dialog takes several addresses at once, Members lists each pending invite " +
+        "with Withdraw, and the link lands on an accept page that names who invited you.",
+    },
+  ];
+}
+
+/** Presses the row's second tile once its picture is drawn, so the viewer opens on it. */
+const OPEN_VIEWER: ShotStep = {
+  key: "agent-pictures-open-viewer",
+  ready: () => true,
+  run: () => {
+    let pressed = false;
+    const check = () => {
+      if (pressed) return;
+      const tiles = document.querySelectorAll<HTMLButtonElement>(".picture-set-tiles .picture-set-tile");
+      const second = tiles[1];
+      if (second === undefined || second.querySelector("img") === null) return;
+      pressed = true;
+      window.setTimeout(() => second.click(), 1_200);
+    };
+    new MutationObserver(check).observe(document.body, { childList: true, subtree: true });
+    check();
+  },
+};
+
+export function agentPicturesShot(): ShotSpec {
+  const members = acmeMembers();
+  const shared = codingAgentAnswers();
+  const plan = shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN });
+  return {
+    planning: shotTasksView({
+      plan,
+      plans: [shotTaskSummary({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }), ...shotOtherPlans()],
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...shared,
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.CODING_AGENTS_MESSAGES]: (payload) => {
+        const page = shared[ACT_KIND.CODING_AGENTS_MESSAGES]?.(payload);
+        if (page === undefined || page === NEVER || "failure" in page) return page;
+        if (payload.agentId !== SHOT_ID.AGENT || payload.callId !== undefined) return page;
+        if (page.messages.length === 0) return page;
+        const messages = page.messages.map((message): CodingAgentMessage => {
+          if (message.id !== "m-turn-1") return message;
+          // Note that the turn's closing words give way to the pictures and the words about them.
+          const parts = message.parts.slice(0, -2);
+          return { ...message, parts: [...parts, ...picturesParts()] } as CodingAgentMessage;
+        });
+        const withPictures: CodingAgentMessagesAnswerView = { ...page, messages };
+        return withPictures;
+      },
+      [ACT_KIND.CODING_AGENTS_PICTURE]: (payload) => {
+        const picture = PICTURES.find((each) => each.id === payload.pictureId);
+        return picture === undefined ? undefined : { contentType: "image/jpeg", base64: picture.base64 };
+      },
+    },
+    layout: { mainTab: { agent: SHOT_ID.AGENT } },
+    steps: [OPEN_VIEWER],
+  };
+}
