+  return { name, description, annotations: { readOnlyHint: true } };
+}
+
+/** A tool that writes, and takes nothing away. */
+function w(name: string, description: string): IntegrationTool {
+  return { name, description, annotations: { readOnlyHint: false, destructiveHint: false } };
+}
+
+/** A tool whose write destroys. */
