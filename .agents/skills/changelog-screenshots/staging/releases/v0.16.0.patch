index 000000000..34e8818f0
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/width.ts
@@ -0,0 +1,141 @@
+/**
+ * width.ts -- 0.16.0 shot "Luke at any width": the side panel narrowed to 340 points on `src/members/invite.ts`, its tab strip folded to glyphs and its file tree floating over the file.
+ *
+ * Throwaway (`README.md`). The plan open with the sidebar folded, the side
+ * panel at 340 points (under the 360 at which a file's tree stops sitting
+ * beside it), the agent's Changes tab opened beside the fixed ones so the
+ * strip has tabs to fold, then the file opened in a tab of its own, and its
+ * Show files toggle pressed so the tree floats over the code.
+ */
+
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CODE_PANEL } from "../planning/planning-fixture";
+import { codingAgentAnswers } from "./coding-agent";
+import { INVITE_FILE, INVITE_PATH } from "./inbox-world";
+import { relayTree } from "./mentions-world";
+import { SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** The narrow panel's width, in points. */
+const NARROW = 340;
+
+/** One folder of acme/relay as the tree reads it, or the whole tree where asked. */
+function treeAnswer(path: string, recursive: boolean | undefined) {
+  const all = relayTree();
+  const entries = recursive
+    ? all
+    : all
+        .filter((entry) => {
+          const prefix = path === "" ? "" : `${path}/`;
+          if (!entry.name.startsWith(prefix)) return false;
+          return !entry.name.slice(prefix.length).includes("/");
+        })
+        .map((entry) => ({ ...entry, name: entry.name.slice(path === "" ? 0 : path.length + 1) }));
+  return {
+    folder: { path, repository: "acme/relay", branch: "luke/teammate-invitations", entries, truncated: false },
+  };
+}
+
+/** The schema file's lines, uncoloured, for the second file tab. */
+const SCHEMA_PATH = "src/db/schema/memberships.ts";
+const SCHEMA_LINES = [
+  'import { pgTable, text, timestamp, uuid } from "drizzle-orm/pg-core";',
+  "",
+  'export const memberships = pgTable("memberships", {',
+  '  id: uuid("id").primaryKey().defaultRandom(),',
+  '  workspaceId: uuid("workspace_id").notNull(),',
+  '  userId: uuid("user_id"),',
+  '  role: text("role").notNull(),',
+  '  state: text("state", { enum: ["pending", "active"] }).notNull().default("active"),',
+  '  inviteToken: text("invite_token").unique(),',
+  '  createdAt: timestamp("created_at").defaultNow(),',
+  "});",
+].map((line) => (line === "" ? [] : [{ text: line }]));
+
+/** Opens the agent's Changes tab once the agent is read, then the schema and the invite route in tabs of their own, the route last so it is the one shown. */
+const OPEN_TABS: ShotStep = {
+  key: "width-tabs",
+  ready: ({ plans }) =>
+    plans.region.kind === "ready" && (plans.agents.agentIds?.includes(SHOT_ID.AGENT) ?? false),
+  run: ({ plans }) => {
+    plans.sidePanel.onChoose({ changes: SHOT_ID.AGENT });
+    window.setTimeout(() => {
+      plans.sidePanel.onBrowseFile(SCHEMA_PATH, SCHEMA_PATH, true);
+      window.setTimeout(() => {
+        plans.sidePanel.onBrowseFile(INVITE_PATH, INVITE_PATH, true);
+        tabsOpenedAt = Date.now();
+      }, 400);
+    }, 400);
+  },
+};
+
+/** When the file tabs were opened, so the tree is shown over the route's file rather than the Changes tab's. */
+let tabsOpenedAt: number | undefined;
+
+/** Presses the shown file's Show files a moment after the route's tab opened, then lets go of the focus it takes. */
+const SHOW_FILES: ShotStep = {
+  key: "width-show-files",
+  ready: () => true,
+  run: () => {
+    const timer = window.setInterval(() => {
+      if (tabsOpenedAt === undefined || Date.now() - tabsOpenedAt < 2_500) return;
+      const toggle = document.querySelector<HTMLButtonElement>('.file-view .file-tree-toggle[data-place="over"]');
+      if (toggle === null || toggle.offsetParent === null) return;
+      window.clearInterval(timer);
+      toggle.click();
+      window.setTimeout(() => {
+        const focused = document.activeElement;
+        if (focused instanceof HTMLElement && focused !== document.body) focused.blur();
+      }, 300);
+    }, 500);
+  },
+};
+
+export function widthShot(): ShotSpec {
+  const members = acmeMembers();
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: { ...FIXTURE_CODE_PANEL, width: NARROW },
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.TASKS_TREE]: (payload) => treeAnswer(payload.path, payload.recursive),
+      [ACT_KIND.TASKS_FILE]: (payload) => {
+        if (payload.path === SCHEMA_PATH) {
+          return {
+            file: {
+              path: SCHEMA_PATH,
+              repository: "acme/relay",
+              branch: "luke/teammate-invitations",
+              firstLine: 1,
+              lineCount: SCHEMA_LINES.length,
+              lines: SCHEMA_LINES,
+            },
+          };
+        }
+        if (payload.path !== INVITE_PATH) return undefined;
+        const firstLine = Math.max(1, payload.firstLine);
+        const lastLine = Math.min(INVITE_FILE.length, payload.lastLine);
+        return {
+          file: {
+            path: INVITE_PATH,
+            repository: "acme/relay",
+            branch: "luke/teammate-invitations",
+            firstLine,
+            lineCount: INVITE_FILE.length,
+            lines: INVITE_FILE.slice(firstLine - 1, lastLine),
+          },
+        };
+      },
+    },
+    layout: { sidebarCollapsed: true },
+    steps: [OPEN_TABS, SHOW_FILES],
+  };
+}
