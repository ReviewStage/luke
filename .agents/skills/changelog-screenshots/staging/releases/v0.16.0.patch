+  ),
+  line("  ", run("return", KEYWORD), " membership;"),
+  line("}"),
+];
+
+/** What every item shares, from the parts that differ. */
+type ItemParts = Pick<
+  InboxItem,
+  "id" | "agentId" | "key" | "title" | "blocks" | "response" | "postedAt" | "updatedAt"
+>;
+
+/** One item waiting on the developer, unchanged since its agent posted it. */
+export function waiting(item: Omit<ItemParts, "updatedAt">): InboxItem {
+  return {
+    ...item,
+    revision: 1,
+    version: INBOX_WIRE_VERSION,
+    needsReply: true,
+    status: INBOX_STATUS.OPEN,
+    updatedAt: item.postedAt,
+  };
+}
+
+/** One item the developer answered, sent back to its agent as a message. */
+export function answered(item: ItemParts, answer: NonNullable<InboxItem["answer"]>): InboxItem {
+  return {
+    ...item,
+    revision: 2,
+    version: INBOX_WIRE_VERSION,
+    needsReply: true,
+    status: INBOX_STATUS.ANSWERED,
+    answer,
+  };
+}
+
+/** The decision the pane shows: asked 24 minutes ago, answered 19, while the agent still ran. */
+function ttlItem(): InboxItem {
+  return answered(
+    {
+      id: ITEM_ID.TTL,
