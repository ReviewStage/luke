+      choices: ["7 days"],
+      note: "7 days, matching password resets. Admins can resend if someone misses the window.",
+    },
+  );
+}
+
+/** The plan's four items: two waiting on Dean, two he settled. */
+function invitationItems(): InboxItem[] {
+  return [
+    waiting({
+      id: ITEM_ID.POSTMARK,
+      agentId: SHOT_ID.AGENT_2,
+      key: "postmark-staging-token",
