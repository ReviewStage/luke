+  INVOICE_LINE: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d02",
+  RETRY_SCHEDULE: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d03",
+  DISABLE_ENDPOINT: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d04",
+  DELIVERIES_MIGRATION: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d05",
+  /** Waiting: the onboarding agent's question. */
+  FIRST_STEP: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d06",
+  HIDE_CHECKLIST: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d07",
+  ILLUSTRATIONS: "b1c2d3e4-f5a6-4b7c-8d9e-0f1a2b3c4d08",
+} as const;
+
+/** The other plans' coding agents, one each, finished, which posted their items. */
+export const OTHER_AGENT = {
+  BILLING: {
