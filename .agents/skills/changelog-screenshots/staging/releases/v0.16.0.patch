+/**
+ * agents-start.ts -- 0.16.0 shot "Agents that start, mention, and archive agents": the finished agent's transcript after #214, where Dean asks it to hand the invite email on, it starts "Invite emails", that agent reports back under its own mark, and it archives the spike the new agent replaces.
+ *
+ * Throwaway (`README.md`). The plan's column on "Add teammate invitations",
+ * sidebar folded, side panel closed. Each turn ends on its call, so the
+ * release's `start_agent` row (with the started agent's card) and its
+ * `archive_agent` row stand rather than fold into a summary; the agent's
+ * mention is a link to its place, labelled, which the plan's doors draw
+ * under its own mark; the report is a message `sentBy` another agent.
+ */
+
+import type { CodingAgentMessagesAnswerView } from "@luke/features/coding-agent-view";
+import type { CodingAgentMessage } from "@luke/features/coding-agent-wire";
+import type { WireRecord, WireValue } from "@luke/wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago } from "./clock";
+import { codingAgentAnswers, MODEL } from "./coding-agent";
+import { AGENT_2_TITLE, SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import { NEVER, type ShotSpec } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** The spike agent the new one replaces, archived at the end. */
+const SPIKE_ID = "3d6fb19c-1249-4f62-8b8a-e9fa0b1c2d93";
+
+/** One finished tool call. */
+function call(tool: string, toolCallId: string, input: WireRecord, output: WireValue): WireRecord {
+  return { type: `tool-${tool}`, toolCallId, state: "output-available", input, output };
+}
+
+/** What follows #214: the ask, the start, the report, and the archive. */
+function laterMessages(): CodingAgentMessage[] {
+  const agentLink = `https://tryluke.dev/acme/plan/${SHOT_ID.PLAN}/agent/${SHOT_ID.AGENT_2}`;
+  return [
+    {
+      id: "m-ask-1",
+      role: "user",
+      sentAt: ago(9),
+      sentBy: { name: MEMBER.DEAN.name, userId: MEMBER.DEAN.userId },
+      parts: [
+        {
+          type: "text",
+          text: "Hand the invite email to an agent of its own on Sol, and archive the Postmark spike once it has taken over.",
+        },
+      ],
+    },
+    {
+      id: "m-turn-2",
+      role: "assistant",
+      startedAt: ago(9),
+      finishedAt: ago(8.5),
+      model: MODEL.OPUS,
+      effort: "high",
+      parts: [
+        { type: "step-start" },
+        {
+          type: "text",
+          text: "Starting one on the invite email, with the template and the Postmark client named in its prompt.",
+        },
+        call(
+          "start_agent",
+          "call_s1",
+          {
+            prompt:
+              "Send the invite email through Postmark, with the workspace's name in the subject. The template is src/mail/templates/invite.tsx.",
+            model: MODEL.SOL,
+            effort: "high",
+          },
+          {
+            status: "accepted",
+            agent: { id: SHOT_ID.AGENT_2, title: AGENT_2_TITLE, onYourTask: true, model: MODEL.SOL, effort: "high" },
+          },
+        ),
+      ],
+    },
+    {
+      id: "m-report-1",
+      role: "user",
+      sentAt: ago(3),
+      sentBy: { name: AGENT_2_TITLE, agent: true },
+      parts: [
+        {
+          type: "text",
+          text:
+            "Opened #216 as a draft: the invite goes out through Postmark with the workspace's name in the subject. " +
+            "It waits on POSTMARK_SERVER_TOKEN for staging, which I put in Dean's Inbox.",
+        },
+      ],
+    },
+    {
+      id: "m-turn-3",
+      role: "assistant",
+      startedAt: ago(3),
+      finishedAt: ago(2.6),
+      model: MODEL.OPUS,
+      effort: "high",
+      parts: [
+        { type: "step-start" },
+        {
+          type: "text",
+          text: `[@${AGENT_2_TITLE}](${agentLink}) has the email in hand with #216, so the spike has nothing left to do. Archiving it.`,
+        },
+        call(
+          "archive_agent",
+          "call_s2",
+          { agentId: SPIKE_ID, reason: "Invite emails replaced it with #216." },
+          {
+            status: "accepted",
+            agent: { id: SPIKE_ID, title: "Postmark spike", task: SHOT_ID.PLAN, onYourTask: true },
+            archived: true,
+            already: false,
+          },
+        ),
+      ],
+    },
+  ] as CodingAgentMessage[];
+}
+
+export function agentsStartShot(): ShotSpec {
+  const members = acmeMembers();
+  const shared = codingAgentAnswers();
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...shared,
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.CODING_AGENTS_MESSAGES]: (payload) => {
+        const page = shared[ACT_KIND.CODING_AGENTS_MESSAGES]?.(payload);
+        if (page === undefined || page === NEVER || "failure" in page) return page;
+        if (payload.agentId !== SHOT_ID.AGENT || payload.callId !== undefined) return page;
+        if (page.messages.length === 0) return page;
+        const withLater: CodingAgentMessagesAnswerView = {
+          ...page,
+          messages: [...page.messages, ...laterMessages()],
+        };
+        return withLater;
+      },
+    },
+    layout: { sidebarCollapsed: true, mainTab: { agent: SHOT_ID.AGENT } },
+  };
+}
