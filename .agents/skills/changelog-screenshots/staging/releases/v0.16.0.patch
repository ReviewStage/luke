+} from "@luke/features/inbox-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import type { AppInboxTaskHolding, AppInboxWaitingItem } from "@luke/host/app-state";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago, hoursAgo } from "./clock";
+import { codingAgentAnswers, MODEL } from "./coding-agent";
+import { EXPIRED_INVITE_PNG_BASE64 } from "./expired-invite-picture";
+import {
+  PLAN_REPOSITORY,
+  SHOT_ID,
+  shotOtherPlans,
+  shotTasksView,
+  shotTaskSummary,
+} from "./plan-document";
+import { NEVER, type ShotSpec } from "./shot-spec";
+
+/** The items, by id; each plan's inbox read carries the same ids. */
+export const ITEM_ID = {
+  /** Waiting: the running agent's manual step. */
+  POSTMARK: "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f",
