+/**
+ * owner-pictures.ts -- a repository owner's picture for the shots, drawn here rather than fetched: a synthetic org mark as an SVG data URL.
+ *
+ * Throwaway (`README.md`). A fixture run asks nothing of the network, and
+ * acme is invented, so its logo is drawn here. The renderer's image policy admits `data:`.
+ */
+
+/**
+ * acme's mark: two peaks on deep teal, as a full-bleed square the way
+ * GitHub serves an organisation's picture (the UI rounds it).
+ */
+const ACME_MARK =
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">` +
+  `<rect width="64" height="64" fill="#0f766e"/>` +
+  `<path d="M14 46 L28 20 L42 46 Z" fill="#fff"/>` +
+  `<path d="M30 46 L40 28 L50 46 Z" fill="#99f6e4"/></svg>`;
+
+/** The owner's picture as a data URL: acme's mark for every owner, since every fixture repository is acme's. */
+export function shotOwnerPicture(_repository: string): string {
+  return `data:image/svg+xml;utf8,${encodeURIComponent(ACME_MARK)}`;
+}
diff --git a/apps/desktop/src/renderer/shots/person.ts b/apps/desktop/src/renderer/shots/person.ts
new file mode 100644
index 000000000..837ee10ee
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/person.ts
@@ -0,0 +1,153 @@
+/**
+ * person.ts -- 0.15.0 shot "A person's page": Dana Moreno's page in acme, what she has at work, what waits on her answer, what she created, her other agents and her automations, with its ⋯ menu held open on Copy link.
+ *
+ * Throwaway (`README.md`). The sidebar open, the page standing in the
+ * plan's place (`desktop/person-page.tsx`). Everything on it is the
+ * listed workspace's own task list (`team-world.ts`), the Inbox as each
+ * task's items read (`inbox-world.ts`), and the workspace's automations
+ * Dana made, read while Automations is on. A step opens her page, as a
+ * press on her name does, and another presses its ⋯.
+ */
+
+import type { AutomationListView } from "@luke/features/automation-view";
+import {
+  AUTOMATION_ACTION,
+  AUTOMATION_DEFAULT_GUARDS,
+  AUTOMATION_SCOPE,
+  AUTOMATION_TARGET,
+  AUTOMATION_TRIGGER,
+  GITHUB_TRIGGER_EVENT,
+  type AutomationSummary,
+} from "@luke/features/automation-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { EXPERIMENT } from "@luke/settings";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { daysAgo } from "./clock";
+import { codingAgentAnswers, MODEL } from "./coding-agent";
+import { holdings, inboxPage } from "./inbox-world";
+import { SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** Dana's two workspace automations. */
+function danaAutomations(): AutomationSummary[] {
+  const shared = {
+    planId: null,
+    planName: null,
+    workspaceId: SHOT_ID.WORKSPACE,
+    enabled: true,
+    pausedReason: null,
+    guards: AUTOMATION_DEFAULT_GUARDS,
+    lastRun: null,
+    scope: AUTOMATION_SCOPE.WORKSPACE,
+    target: { kind: AUTOMATION_TARGET.NEW_AGENT },
+    archiveSuccessful: false,
+    mine: false,
+    creatorId: MEMBER.DANA.userId,
+  } as const;
+  return [
+    {
+      ...shared,
+      id: "b2f6d8ea-4c3a-4d7f-9b2e-6a8c0d3f5e71",
+      name: "Code review",
+      trigger: { kind: AUTOMATION_TRIGGER.GITHUB, event: GITHUB_TRIGGER_EVENT.PULL_REQUEST_UPDATED },
+      action: {
+        kind: AUTOMATION_ACTION.CODING_AGENT,
+        prompt: "Review the pull request as Luke: read the diff against the plan, run the tests, and comment.",
+        choice: { model: MODEL.OPUS, effort: "high" },
+      },
+      nextRunAt: null,
+      createdAt: daysAgo(6),
+      repositories: ["acme/relay", "acme/ledger"],
+    },
+    {
+      ...shared,
+      id: "c3a7e9fb-5d4b-4e80-8c3f-7b9d1e4a6f82",
+      name: "Label new billing issues",
+      trigger: { kind: AUTOMATION_TRIGGER.GITHUB, event: GITHUB_TRIGGER_EVENT.ISSUE_OPENED },
+      action: {
+        kind: AUTOMATION_ACTION.CODING_AGENT,
+        prompt: "Read the new issue, label it, and link the code it is about.",
+        choice: { model: MODEL.SONNET, effort: "medium" },
+      },
+      nextRunAt: null,
+      createdAt: daysAgo(9),
+      repositories: ["acme/ledger"],
+    },
+  ];
+}
+
+/** Opens Dana's page, as a press on her name does, once acme is listed. */
+const OPEN_PAGE: ShotStep = {
+  key: "person-open",
+  ready: ({ plans }) => plans.workspace?.id === SHOT_ID.WORKSPACE && plans.plans.length > 0,
+  run: ({ plans }) => plans.personView.onOpen(MEMBER.DANA.userId, MEMBER.DANA.name, SHOT_ID.WORKSPACE),
+};
+
+/** Presses the page's ⋯ once its sections are drawn, and again should it close (a resize or a lost focus closes it), up to five times; the focus its first item takes is let go. */
+const OPEN_MENU: ShotStep = {
+  key: "person-menu",
+  ready: () => true,
+  run: () => {
+    let presses = 0;
+    let waiting = false;
+    const button = () =>
+      document.querySelectorAll(".person-column .home-section").length < 4
+        ? null
+        : document.querySelector<HTMLButtonElement>('.desktop-toolbar-actions button[aria-label="More"]');
+    const check = () => {
+      if (waiting || presses >= 5) return;
+      const shown = button();
+      if (shown === null || shown.getAttribute("aria-expanded") === "true") return;
+      waiting = true;
+      window.setTimeout(() => {
+        waiting = false;
+        const settled = button();
+        if (settled === null || settled.getAttribute("aria-expanded") === "true") return;
+        presses += 1;
+        settled.click();
+        window.setTimeout(() => {
+          const focused = document.activeElement;
+          if (focused instanceof HTMLElement && focused.closest('[role="menu"]') !== null) focused.blur();
+        }, 300);
+      }, 1_200);
+    };
+    new MutationObserver(check).observe(document.body, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ["aria-expanded"],
+    });
+    check();
+  },
+};
+
+export function personShot(): ShotSpec {
+  const members = acmeMembers();
+  const automations: AutomationListView = { automations: danaAutomations() };
+  const held = holdings().filter(
+    (holding) => holding.taskId === SHOT_ID.PLAN || holding.taskId === SHOT_ID.ONBOARDING,
+  );
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    experiments: [EXPERIMENT.AUTOMATIONS],
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.WORKSPACE_FORMER_MEMBERS_READ]: () => [],
+      [ACT_KIND.CODING_AGENTS_INBOX]: (payload) => inboxPage(payload.taskId, payload.after),
+      [ACT_KIND.AUTOMATIONS_LIST]: (payload) =>
+        payload.workspaceId === SHOT_ID.WORKSPACE ? automations : { automations: [] },
+    },
+    inbox: { waiting: [], plans: held },
+    layout: { sidebarCollapsed: false },
+    steps: [OPEN_PAGE, OPEN_MENU],
+  };
+}
