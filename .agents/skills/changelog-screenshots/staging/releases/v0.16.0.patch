+
+/** The automation as the list answers it, its newest run the one at work. */
+function shotAutomation(runs: readonly AutomationRunSummary[]): AutomationSummary {
+  return {
+    id: AUTOMATION_ID,
+    planId: null,
+    planName: null,
+    workspaceId: SHOT_ID.WORKSPACE,
+    name: "Morning Sentry triage",
+    enabled: true,
+    pausedReason: null,
+    trigger: { kind: AUTOMATION_TRIGGER.SCHEDULE, cron: CRON, timezone: TIMEZONE },
+    action: {
+      kind: AUTOMATION_ACTION.CODING_AGENT,
+      prompt: PROMPT,
+      choice: { model: MODEL.SONNET, effort: "high" },
+    },
+    guards: AUTOMATION_DEFAULT_GUARDS,
+    nextRunAt: nextMorning(),
+    lastRun: runs[0] ?? null,
+    createdAt: daysAgo(12),
+    scope: AUTOMATION_SCOPE.WORKSPACE,
+    repositories: [...REPOSITORIES],
+    target: { kind: AUTOMATION_TARGET.NEW_AGENT },
+    archiveSuccessful: false,
+    mine: true,
+  };
+}
+
+/** Lists acme, as its row in the switcher would, once the workspaces are read. */
+const LIST_ACME: ShotStep = {
+  key: "automations-workspace",
+  ready: ({ plans }) => plans.workspace !== undefined,
+  run: ({ plans }) => {
+    if (plans.workspace?.id !== SHOT_ID.WORKSPACE) plans.onChooseWorkspace(SHOT_ID.WORKSPACE);
+  },
+};
+
+/** Opens the automation's page, as a press on its row in the list does, once acme is listed. */
+const OPEN_AUTOMATION: ShotStep = {
+  key: "automations-page",
+  ready: ({ plans }) => plans.workspace?.id === SHOT_ID.WORKSPACE,
+  run: ({ plans }) =>
+    plans.automationsView.onOpen({ kind: AUTOMATIONS_PAGE.EDIT, automationId: AUTOMATION_ID }),
+};
+
+export function automationsShot(): ShotSpec {
+  const runs = shotRuns().map(runSummary);
+  const list: AutomationListView = { automations: [shotAutomation(runs)] };
+  const history: AutomationRunsView = { runs };
+  const [acme, personal] = shotWorkspaces();
+  return {
+    planning: shotTasksView({
+      extra: {
+        workspaces: [
+          ...(personal === undefined ? [] : [{ ...personal, memberCount: 1 }]),
+          ...(acme === undefined ? [] : [{ ...acme, memberCount: ACME_MEMBERS }]),
+        ],
+      },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    experiments: [EXPERIMENT.AUTOMATIONS, EXPERIMENT.FACTORY],
+    answers: {
+      ...codingAgentAnswers(),
+      // Note that the list and the runs are read once as the page opens and each minute after, never in a loop, so each is answered every time.
+      [ACT_KIND.AUTOMATIONS_LIST]: (payload) =>
+        payload.workspaceId === SHOT_ID.WORKSPACE ? list : { automations: [] },
+      [ACT_KIND.AUTOMATIONS_RUNS]: (payload) =>
+        payload.automationId === AUTOMATION_ID ? history : { runs: [] },
+    },
+    layout: { sidebarCollapsed: false },
+    steps: [LIST_ACME, OPEN_AUTOMATION],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/canned-acts.ts b/apps/desktop/src/renderer/shots/canned-acts.ts
