@@ -0,0 +1,239 @@
+/**
+ * automations.ts -- shot "Experiments: Automations and the Factory": the "Morning Sentry triage" automation's page, whole window, the sidebar open on its Automations row.
+ *
+ * Throwaway (`README.md`). See `.context/shots/SPEC.md` row 6. Both
+ * experiments are drawn on (`experiments`, read by `useExperiment`), so the
+ * sidebar stands Factory's row and Automations' row under the Inbox. The
+ * automation is acme's own (scope workspace), made by Dean, acme's owner: a
+ * schedule on weekdays at 9:00 in the Mac's zone, working in acme/relay and
+ * acme/web, a new agent each run on Claude Sonnet 5.5 at high effort. Its
+ * runs, newest first, are a Run now Dean pressed seconds ago whose agent is
+ * at work, then four weekday mornings' scheduled runs, each agent finished.
+ *
+ * Dean's own workspace is listed first and acme second, as the service
+ * orders an account's workspaces (its personal one first), so the page
+ * reads acme as the shared workspace it is: the crumbs and the line under
+ * the name say acme, the sidebar's head says "6 members", and the page
+ * offers its Sharing group. A step lists acme, as the switcher would, and a
+ * second opens the automation's page as a press on its row in the list does.
+ */
+
+import type { AutomationListView, AutomationRunsView } from "@luke/features/automation-view";
+import {
+  AUTOMATION_ACTION,
+  AUTOMATION_DEFAULT_GUARDS,
+  AUTOMATION_FIRING,
+  AUTOMATION_RUN_STATUS,
+  AUTOMATION_SCOPE,
+  AUTOMATION_TARGET,
+  AUTOMATION_TRIGGER,
+  type AutomationRunSummary,
+  type AutomationSummary,
+} from "@luke/features/automation-wire";
+import { CODING_AGENT_STATUS, type CodingAgentStatus } from "@luke/features/coding-agent-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { EXPERIMENT } from "@luke/settings";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { AUTOMATIONS_PAGE } from "../planning/use-plans-tab";
+import { daysAgo, LAUNCHED_AT, secondsAgo } from "./clock";
+import { codingAgentAnswers, MODEL } from "./coding-agent";
+import { SHOT_ID, shotTasksView, shotWorkspaces } from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+
+/** The automation and its runs' ids, each a UUID as the wire reads one. */
+const AUTOMATION_ID = "a1e5c7d9-3b2f-4c6e-8a1d-5f7b9c2e4d60";
+
+/** The repositories its runs work in, the first where a run starts. */
+const REPOSITORIES = ["acme/relay", "acme/web"] as const;
+
+/**
+ * Where its schedule is read: the capturing Mac's own zone (Los Angeles on
+ * Dean's), so its next runs and its runs' instants all read 9:00 AM on the
+ * Mac's clock, as the mornings below are counted on it.
+ */
+const TIMEZONE = Intl.DateTimeFormat().resolvedOptions().timeZone;
+
+/** Weekdays at 9:00, as the picker writes it (`SCHEDULE_PRESET.WEEKDAYS`). */
+const CRON = "0 9 * * 1-5";
+
+/** How many acme's members are counted, as the sidebar's head says. */
+const ACME_MEMBERS = 5;
+
+/** What the agent is told each run. */
+const PROMPT =
+  "Triage the Sentry issues opened in acme's projects in the last 24 hours. Group duplicates, " +
+  "find where each one starts in acme/relay or acme/web, and open a fix PR for anything with a " +
+  "clear cause, with a test that fails without the fix. For the rest, leave a short comment on " +
+  "the Sentry issue saying what you found and what you'd need to know next.";
+
+/** One run as the history lists it: what fired it, its agent, and when. */
+interface ShotRun {
+  readonly id: string;
+  readonly agentId: string;
+  readonly title: string;
+  readonly status: CodingAgentStatus;
+  /** When it fired; a scheduled run's due instant is the 9:00 it fired just after. */
+  readonly firedAt: number;
+  readonly dueAt?: number;
+}
+
+/** The 9:00 of each weekday before launch, newest first, on this Mac's clock. */
+function weekdayMornings(count: number): number[] {
+  const mornings: number[] = [];
+  const day = new Date(LAUNCHED_AT);
+  day.setHours(9, 0, 0, 0);
+  while (mornings.length < count) {
+    const weekday = day.getDay();
+    if (weekday !== 0 && weekday !== 6 && day.getTime() < LAUNCHED_AT) mornings.push(day.getTime());
+    day.setDate(day.getDate() - 1);
+  }
+  return mornings;
+}
+
+/** The next weekday 9:00 after launch, as the service says it is next due. */
+function nextMorning(): number {
+  const day = new Date(LAUNCHED_AT);
+  day.setHours(9, 0, 0, 0);
+  while (day.getTime() <= LAUNCHED_AT || day.getDay() === 0 || day.getDay() === 6) {
+    day.setDate(day.getDate() + 1);
+  }
+  return day.getTime();
+}
+
+/** The runs, newest first: Dean's Run now at work, then four mornings' runs, each finished. */
+function shotRuns(): ShotRun[] {
+  const [first, second, third, fourth] = weekdayMornings(4);
+  // Note that a scheduled run fires on the sweep's first minute past its due instant.
+  const fired = (dueAt: number | undefined) => (dueAt ?? daysAgo(1)) + 23_000;
+  return [
+    {
+      id: "b2f6d8ea-4c3a-4d7f-9b2e-6a8c0d3f5e71",
+      agentId: "c3a7e9fb-5d4b-4e80-8c3f-7b9d1e4a6f82",
+      title: "Fix invite accept crash on an expired token",
+      status: CODING_AGENT_STATUS.RUNNING,
+      firedAt: secondsAgo(25),
+    },
+    {
+      id: "d4b8fa0c-6e5c-4f91-9d4a-8cae2f5b7a93",
+      agentId: "e5c90b1d-7f6d-4a02-8e5b-9dbf3a6c8ba4",
+      title: "Retry Postmark sends on a 429",
+      status: CODING_AGENT_STATUS.COMPLETED,
+      firedAt: fired(first),
+      ...(first === undefined ? undefined : { dueAt: first }),
+    },
+    {
+      id: "f6da1c2e-8a7e-4b13-9f6c-aec04b7d9cb5",
+      agentId: "07eb2d3f-9b8f-4c24-8a7d-bfd15c8eadc6",
+      title: "Guard an empty workspace in the members query",
+      status: CODING_AGENT_STATUS.COMPLETED,
+      firedAt: fired(second),
+      ...(second === undefined ? undefined : { dueAt: second }),
+    },
+    {
+      id: "18fc3e4a-ac90-4d35-9b8e-c0e26d9fbed7",
+      agentId: "290d4f5b-bda1-4e46-8c9f-d1f37eaacfe8",
+      title: "Fix the usage chart crash on a new workspace",
+      status: CODING_AGENT_STATUS.COMPLETED,
+      firedAt: fired(third),
+      ...(third === undefined ? undefined : { dueAt: third }),
+    },
+    {
+      id: "3a1e5a6c-ceb2-4f57-9da0-e2a48fbbd0f9",
+      agentId: "4b2f6b7d-dfc3-4a68-8eb1-f3b59accde0a",
+      title: "Stop double-sending webhook test events",
+      status: CODING_AGENT_STATUS.COMPLETED,
+      firedAt: fired(fourth),
+      ...(fourth === undefined ? undefined : { dueAt: fourth }),
+    },
+  ];
+}
+
+/** One run as the wire answers it: started, its agent named, a Run now's firing manual. */
+function runSummary(run: ShotRun): AutomationRunSummary {
+  return {
+    id: run.id,
+    firing:
+      run.dueAt === undefined
+        ? { kind: AUTOMATION_FIRING.MANUAL }
+        : { kind: AUTOMATION_FIRING.SCHEDULE, dueAt: run.dueAt },
+    status: AUTOMATION_RUN_STATUS.STARTED,
+    reason: null,
+    agent: { id: run.agentId, title: run.title, status: run.status },
+    firedAt: run.firedAt,
+    settledAt: run.firedAt + 4_000,
+  };
