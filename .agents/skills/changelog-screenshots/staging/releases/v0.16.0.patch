+/**
+ * plan-pictures.ts -- 0.15.0 shot "Pictures in plans": the Teammate invitations plan over the whole window, its Goal holding the invite dialog's design as a picture with its caption.
+ *
+ * Throwaway (`README.md`). Sidebar folded, side panel closed. The picture is
+ * written in the plan's Markdown as a plan picture's address
+ * (`plan-attachment-link.ts`) and its bytes are answered by
+ * `PLANNING_PICTURE_READ`, so the release's own `PlanPictures` draws it.
+ */
+
+import { PLAN_ACTOR } from "@luke/features/task-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago, daysAgo } from "./clock";
+import { codingAgentAnswers } from "./coding-agent";
+import {
+  AGENT_TITLE,
+  documentText,
+  SHOT_ID,
+  SHOT_SECTIONS,
+  shotOtherPlans,
+  shotPlan,
+  shotTasksView,
+  shotTaskSummary,
+  shotSectionEdits,
+} from "./plan-document";
+import { RELAY_DESIGN_JPEG } from "./relay-pictures";
+import type { ShotSpec } from "./shot-spec";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** The design picture's id, as the service mints one. */
+export const DESIGN_PICTURE_ID = "5d1e9a3c-7b2f-4c8e-a0d6-3f9b8e1c2a47";
+
+/** The plan's picture, as the plan's Markdown writes it. */
+export function designPictureMarkdown(planId: string = SHOT_ID.PLAN): string {
+  return (
+    `![The invite dialog over Members: an email typed as a chip, the Member role, and Send invite](` +
+    `https://tryluke.dev/acme/plan/${planId}/files/${DESIGN_PICTURE_ID} ` +
+    `"Invite dialog, as Dana designed it: one field, chips per address, links last 7 days")`
+  );
+}
+
+export function planPicturesShot(): ShotSpec {
+  const members = acmeMembers();
+  const body = documentText({
+    ...SHOT_SECTIONS,
+    Goal: `${SHOT_SECTIONS.Goal}\n\n${designPictureMarkdown()}`,
+  });
+  const plan = shotPlan({
+    ownerId: MEMBER.DEAN.userId,
+    createdBy: MEMBER.DEAN,
+    createdAt: daysAgo(2),
+    document: { body: `${body}\n`, assumptions: [] },
+    lastEdit: { actor: PLAN_ACTOR.DEVELOPER, by: MEMBER.DANA, at: ago(3), duringCall: false },
+    sectionEdits: shotSectionEdits().map((edit) =>
+      edit.section === "Goal"
+        ? { section: "Goal", actor: PLAN_ACTOR.DEVELOPER, by: MEMBER.DANA, at: ago(3), duringCall: false }
+        : edit,
+    ),
+    agentEdits: [{ agentId: SHOT_ID.AGENT, label: AGENT_TITLE, at: ago(12) }],
+  });
+  return {
+    planning: shotTasksView({
+      plan,
+      plans: [shotTaskSummary({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }), ...shotOtherPlans()],
+      extra: { workspaces: whoWorkspaces(members.length) },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.TASKS_PICTURE_READ]: (payload) =>
+        payload.attachmentId === DESIGN_PICTURE_ID
+          ? { contentType: "image/jpeg", base64: RELAY_DESIGN_JPEG }
+          : undefined,
+    },
+    layout: { sidebarCollapsed: true },
+  };
+}
