+/**
+ * linear.ts -- 0.15.0 shot "Start a task from Linear": the sidebar with New task's picker of acme's Linear issues hanging open beside it.
+ *
+ * Throwaway (`README.md`). acme has Linear connected for the whole
+ * workspace (`linear: { active: true }`), so New task opens the release's
+ * own picker (`planning/linear-issue-picker.tsx`) rather than the dialog;
+ * the issues are answered by `WORKSPACE_LINEAR_ISSUES`. A step presses New
+ * task once the sidebar is drawn, since the picker's open state is the
+ * button's own.
+ */
+
+import type { LinearIssueSummary } from "@luke/features/linear-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { codingAgentAnswers } from "./coding-agent";
+import { SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import type { ShotSpec, ShotStep } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** acme's open Linear issues, newest first, as the picker lists them. */
+function acmeIssues(): LinearIssueSummary[] {
+  const issue = (n: number, title: string, state: string): LinearIssueSummary => ({
+    id: `5b1c7e2a-0d4f-4a6b-9c8e-${String(n).padStart(12, "0")}`,
+    identifier: `REL-${String(n)}`,
+    title,
+    url: `https://linear.app/acme/issue/REL-${String(n)}`,
+    state,
+  });
+  return [
+    issue(148, "Resend an invite", "Todo"),
+    issue(146, "Export the audit log as CSV", "Todo"),
+    issue(142, "Invite links last 7 days", "In Progress"),
+    issue(139, "Show retries on deliveries", "In Review"),
+    issue(137, "Seats skip pending invites", "Todo"),
+    issue(131, "Map Okta groups to roles", "Backlog"),
+    issue(128, "Rate-limit POST /invites", "Backlog"),
+  ];
+}
+
+/** Presses New task once the sidebar draws it. */
+const OPEN_PICKER: ShotStep = {
+  key: "linear-open",
+  ready: ({ plans }) => plans.workspace?.id === SHOT_ID.WORKSPACE && plans.newPlan.linear !== undefined,
+  run: () => {
+    let pressed = false;
+    const check = () => {
+      if (pressed) return;
+      const button = document.querySelector<HTMLButtonElement>(".sidebar-new-plan");
+      if (button === null || button.disabled) return;
+      pressed = true;
+      window.setTimeout(() => button.click(), 1_200);
+    };
+    new MutationObserver(check).observe(document.body, { childList: true, subtree: true, attributes: true });
+    check();
+  },
+};
+
+export function linearShot(): ShotSpec {
+  const members = acmeMembers();
+  const issues = acmeIssues();
+  const workspaces = whoWorkspaces(members.length).map((workspace) =>
+    workspace.id === SHOT_ID.WORKSPACE ? { ...workspace, linear: { active: true } } : workspace,
+  );
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.WORKSPACE_LINEAR_ISSUES]: (payload) =>
+        payload.workspaceId === SHOT_ID.WORKSPACE ? issues : undefined,
+    },
+    layout: { sidebarCollapsed: false },
+    steps: [OPEN_PICKER],
+  };
+}
diff --git a/apps/desktop/src/renderer/shots/links.ts b/apps/desktop/src/renderer/shots/links.ts
new file mode 100644
index 000000000..bd343a1de
--- /dev/null
+++ b/apps/desktop/src/renderer/shots/links.ts
@@ -0,0 +1,174 @@
+/**
+ * links.ts -- 0.16.0 shot "Links that say what they point at": one Inbox item whose words carry a pull request's, a Linear issue's, a person's, a task's, and an automation's link, each drawn as the chip it names.
+ *
+ * Throwaway (`README.md`). The window's Inbox, sidebar folded, the item
+ * chosen. A pull request's and a Linear issue's chip say their title and
+ * state through `TASKS_PULL_REQUEST` and `WORKSPACE_LINEAR_ISSUES`, which
+ * `use-link-standing.ts` asks only for a connected workspace it finds in
+ * the shot's view (its `Throwaway:` hook); acme has GitHub and Linear
+ * connected. The person's chip is named by acme's members, the task's and
+ * the automation's by their links' labels.
+ */
+
+import {
+  INBOX_BLOCK,
+  INBOX_CURSOR_START,
+  INBOX_RESPONSE,
+  type InboxAnswer,
+  type InboxItem,
+} from "@luke/features/inbox-wire";
+import type { LinearIssueSummary } from "@luke/features/linear-wire";
+import { ACT_KIND } from "@luke/host/acts";
+import { FIXTURE_CLOSED_PANEL } from "../planning/planning-fixture";
+import { ago } from "./clock";
+import { codingAgentAnswers } from "./coding-agent";
+import { holdings, INVITE_FILE, INVITE_PATH, INVITE_SHA, planItems, waiting } from "./inbox-world";
+import { SHOT_ID, shotPlan, shotTasksView } from "./plan-document";
+import { NEVER, type ShotSpec } from "./shot-spec";
+import { teamPlans } from "./team-world";
+import { acmeMembers, MEMBER, whoWorkspaces } from "./who";
+
+/** The item the pane shows. */
+const LINKS_ITEM_ID = "e7f8a9b0-c1d2-4e3f-8a4b-5c6d7e8f9a01";
+
+/** The automation the item names, by the id `automations.ts` gives Morning Sentry triage. */
+const AUTOMATION_ID = "a1e5c7d9-3b2f-4c6e-8a1d-5f7b9c2e4d60";
+
+/** The item: #217 ready for review, with every kind of link a sentence of it needs. */
+function linksItem(): InboxItem {
+  const plan = `https://tryluke.dev/acme/plan/${SHOT_ID.PLAN}`;
+  return waiting({
+    id: LINKS_ITEM_ID,
+    agentId: SHOT_ID.AGENT,
+    key: "invite-ttl-review",
+    title: "Ready for review: invite links expire after 7 days",
+    blocks: [
+      {
+        type: INBOX_BLOCK.MARKDOWN,
+        text:
+          "Opened https://github.com/acme/relay/pull/217 for https://linear.app/acme/issue/REL-142/invite-links-last-7-days, " +
+          `the 7 days you chose on [Teammate invitations](${plan}). It resends an expired invite the way ` +
+          "https://github.com/acme/relay/pull/209 retries a webhook.",
+      },
+      {
+        type: INBOX_BLOCK.CODE,
+        repo: "acme/relay",
+        path: INVITE_PATH,
+        startLine: 5,
+        endLine: 6,
+        sha: INVITE_SHA,
+      },
+      {
+        type: INBOX_BLOCK.MARKDOWN,
+        text:
+          "- https://github.com/acme/relay/pull/214 adds the invite itself\n" +
+          "- https://github.com/acme/relay/pull/216 sends its email, still a draft",
+      },
+      {
+        type: INBOX_BLOCK.MARKDOWN,
+        text:
+          `[Dana Moreno](https://tryluke.dev/acme/person/${MEMBER.DANA.userId}) asked to review it, and once it merges ` +
+          `[Morning Sentry triage](https://tryluke.dev/acme/automation/${AUTOMATION_ID}) will watch for expired-token errors.`,
+      },
+    ],
+    response: { type: INBOX_RESPONSE.APPROVAL },
+    postedAt: ago(2),
+  });
+}
+
+/** The pull requests the item names, as GitHub answers them. */
+const PULL_REQUESTS: Readonly<Record<number, { title: string; state: "open" | "merged" | "draft" }>> = {
+  217: { title: "Expire invite links after 7 days", state: "open" },
+  209: { title: "Retry failed webhook deliveries", state: "merged" },
+  214: { title: "Add teammate invitations", state: "open" },
+  216: { title: "Send invite emails through Postmark", state: "draft" },
+};
+
+/** The Linear issue the item names. */
+const ISSUE: LinearIssueSummary = {
+  id: "5b1c7e2a-0d4f-4a6b-9c8e-000000000142",
+  identifier: "REL-142",
+  title: "Invite links last 7 days",
+  url: "https://linear.app/acme/issue/REL-142/invite-links-last-7-days",
+  state: "In Progress",
+};
+
+/** The plan's inbox: the review item first, then the items it held before; held after its first page. */
+function inboxPage(taskId: string, after: string): InboxAnswer | typeof NEVER {
+  if (after !== INBOX_CURSOR_START) return NEVER;
+  const items = taskId === SHOT_ID.PLAN ? [linksItem(), ...planItems(SHOT_ID.PLAN)] : planItems(taskId);
+  return { items, cursor: "1" };
+}
+
+export function linksShot(): ShotSpec {
+  const members = acmeMembers();
+  const workspaces = whoWorkspaces(members.length).map((workspace) =>
+    workspace.id === SHOT_ID.WORKSPACE ? { ...workspace, linear: { active: true } } : workspace,
+  );
+  const item = linksItem();
+  return {
+    planning: shotTasksView({
+      plan: shotPlan({ ownerId: MEMBER.DEAN.userId, createdBy: MEMBER.DEAN }),
+      plans: teamPlans(),
+      extra: { workspaces },
+    }),
+    sidePanel: FIXTURE_CLOSED_PANEL,
+    readerId: MEMBER.DEAN.userId,
+    answers: {
+      ...codingAgentAnswers(),
+      [ACT_KIND.WORKSPACE_MEMBERS_READ]: () => members,
+      [ACT_KIND.CODING_AGENTS_INBOX]: (payload) => inboxPage(payload.taskId, payload.after),
+      [ACT_KIND.TASKS_PULL_REQUEST]: (payload) => {
+        const known = PULL_REQUESTS[payload.number];
+        if (payload.repository !== "acme/relay" || known === undefined) return null;
+        return {
+          number: payload.number,
+          title: known.title,
+          url: `https://github.com/acme/relay/pull/${String(payload.number)}`,
+          state: known.state,
+        };
+      },
+      [ACT_KIND.TASKS_FILE]: (payload) => {
+        if (payload.path !== INVITE_PATH) return undefined;
+        const firstLine = Math.max(1, payload.firstLine);
+        const lastLine = Math.min(INVITE_FILE.length, payload.lastLine);
+        return {
+          file: {
+            path: INVITE_PATH,
+            repository: "acme/relay",
+            branch: "luke/invite-ttl",
+            firstLine,
+            lineCount: INVITE_FILE.length,
+            lines: INVITE_FILE.slice(firstLine - 1, lastLine),
+          },
+        };
+      },
+      [ACT_KIND.WORKSPACE_LINEAR_ISSUES]: (payload) =>
+        payload.workspaceId === SHOT_ID.WORKSPACE ? [ISSUE] : undefined,
+    },
+    inbox: {
+      waiting: [
+        {
+          taskId: SHOT_ID.PLAN,
+          items: [{ id: item.id, agentId: item.agentId, title: item.title, postedAt: item.postedAt }],
+        },
+      ],
+      plans: holdings().map((holding) =>
+        holding.taskId === SHOT_ID.PLAN
+          ? { ...holding, items: holding.items + 1, updatedAt: item.updatedAt }
+          : holding,
+      ),
+    },
+    layout: { sidebarCollapsed: true },
+    steps: [
+      {
+        key: "links-item",
+        ready: ({ plans }) => plans.plans.some((plan) => plan.id === SHOT_ID.PLAN),
+        run: ({ plans }) => {
+          plans.inboxView.onOpen();
+          plans.inboxView.onChoose({ planId: SHOT_ID.PLAN, itemId: LINKS_ITEM_ID });
+        },
+      },
+    ],
+  };
+}
