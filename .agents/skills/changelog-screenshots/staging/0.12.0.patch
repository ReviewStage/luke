+
+const SCRIPT = `
+var role = "member";
+function show(view) {
+  document.querySelectorAll(".seg button").forEach(function (b) { b.classList.toggle("on", b.dataset.view === view); });
+  var stage = document.getElementById("stage");
+  stage.classList.toggle("one", view !== "both");
