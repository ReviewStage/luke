{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  // Strict mode hands a task only the variables named here and turbo's own
  // short list (PATH, HOME, CI and the like). None named is a secret: a task
  // that never sees one can neither print it into a cached log nor bake it
  // into a cached hash. The desktop build's Sentry token and DSN stay with
  // `pnpm package`, which turbo never runs.
  "envMode": "strict",
  // Turborepo assumes a task is deterministic under the inputs it knows, and
  // its global hash knows the lockfile, `globalDependencies`, `globalEnv` and
  // its flags, never the OS, CPU architecture, or Node version. A test whose
  // result depends on those would replay a Linux pass on a Mac, so
  // `scripts/lib/turbo.mjs` names the platform here, in every task's hash.
  "globalEnv": ["LUKE_TURBO_PLATFORM"],
  // Files outside every workspace that every workspace reads. The changelog
  // and the privacy notice only the web app reads, so they are inputs of its
  // own tasks (apps/web/turbo.json). The brand artwork the web app and the
  // desktop build read is @luke/brand's, which `transit` tracks.
  "globalDependencies": [".nvmrc", "tsconfig.base.json"],
  "tasks": {
    // A task with no script anywhere, whose hash is its workspace's files and
    // the transit hashes of the workspaces it depends on. A task that depends
    // on `^transit` is therefore invalidated by a change to the source of any
    // workspace it imports, at any depth, without waiting for that
    // workspace's own run of the same task. Workspaces import one another's
    // source rather than a build, so this is the whole of their dependency.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // No task declares outputs: each is a check, and what it leaves behind
    // (the build's dist/ included) is read by nothing that runs after it. A
    // hit replays the log and restores no files, so no bundle or stamped
    // commit ever travels through the cache.
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    // One workspace's tests. apps/web reads beyond its own graph in one test,
    // tests/api-callers.test.ts, which walks every client in the repository;
    // its check is the one scripts/repository-checks.sh runs on every
    // check.sh and in CI outside the cache, so web's tests do not hash the
    // whole repository for its sake.
    "test:vitest": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    // @luke/service's and @luke/panel's suites in three vitest shards, one per
    // CI runner.
    "test:vitest:1": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test:vitest:2": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test:vitest:3": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    // The whole-repository checks each read every file in one program, so
    // each is one root task whose inputs are every file the repository tracks.
    "//#lint": {
      "outputs": []
    },
    "//#knip": {
      "outputs": []
    },
    "//#discarded-effect": {
      "outputs": []
    }
  }
}
