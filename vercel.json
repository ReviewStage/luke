  "crons": [
    {
      "path": "/api/maintenance/sweep",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/eve/coder/v1/(.*)",
      "destination": {
        "service": "dev"
      }
    },
    {
      "source": "/eve/v1/(.*)",
      "destination": {
        "service": "luke"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
