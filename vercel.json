{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "gh-readonly-queue/**": false
    }
  },
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --filter @luke/web...",
      "buildCommand": "(pnpm db:migrate && pnpm auth:seed) & db=$!; pnpm build && wait $db",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/web :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json :/CHANGELOG.md :/PRIVACY.md :/vercel.json",
      "routes": [
        {
          "src": "/api/auth/(.*)",
          "dest": "/api/default.js?route=auth/[...all]&route-path=auth/$1"
        },
        {
          "src": "/api/plans/([^/]+)/attachments/([^/]+)",
          "dest": "/api/default.js?route=plans/attachment&id=$1&attachment=$2"
        },
        {
          "src": "/api/agents/([^/]+)/subagents/([^/]+)/pictures/([^/]+)",
          "dest": "/api/default.js?route=agents/picture&id=$1&call=$2&picture=$3"
        },
        {
          "src": "/api/agents/([^/]+)/pictures/([^/]+)",
          "dest": "/api/default.js?route=agents/picture&id=$1&picture=$2"
        },
        {
          "src": "/api/agents/([^/]+)/github-image",
          "dest": "/api/default.js?route=agents/github-image&id=$1"
        },
        {
          "src": "/api/agents/([^/]+)/chapters",
          "dest": "/api/pull-request-chapters.js?route=agents/chapters&route-path=agents/$1/chapters"
        },
        {
          "src": "/api/inbox/([^/]+)/attachments/([^/]+)",
          "dest": "/api/default.js?route=inbox/attachment&id=$1&attachment=$2"
        },
        {
          "src": "/api/workspaces/([^/]+)/photo",
          "dest": "/api/default.js?route=workspaces/photo&id=$1"
        },
        {
          "src": "/api/automations/([^/]+)/webhook",
          "dest": "/api/default.js?route=automations/webhook&id=$1"
        },
        {
          "src": "/api/account/integrations/connected",
          "dest": "/api/default.js?route=account/integrations/connected"
        },
        {
          "src": "/api/github/install",
          "dest": "/api/default.js?route=github/install"
        },
        {
          "src": "/api/github/installed",
          "dest": "/api/default.js?route=github/installed"
        },
        {
          "src": "/api/github/installed/authorized",
          "dest": "/api/default.js?route=github/installed/authorized"
        },
        {
          "src": "/api/github/webhook",
          "dest": "/api/default.js?route=github/webhook"
        },
        {
          "src": "/api/maintenance/provider-keys-rewrap",
          "dest": "/api/default.js?route=maintenance/provider-keys-rewrap"
        },
        {
          "src": "/api/workspaces/chat/attachment",
          "dest": "/api/default.js?route=workspaces/chat/attachment"
        },
        {
          "src": "/api/workspaces/linear/connected",
          "dest": "/api/default.js?route=workspaces/linear/connected"
        },
        {
          "src": "/api/maintenance/sweep",
          "dest": "/api/maintenance-sweep.js?route=maintenance/sweep"
        },
        {
          "src": "/api/feedback",
          "dest": "/api/feedback"
        },
        {
          "src": "/api/feedback\\.mjs",
          "dest": "/api/feedback.mjs"
        },
        {
          "src": "/api/terminal/sessions",
          "dest": "/api/terminal/sessions"
        },
        {
          "src": "/api/terminal/sessions\\.js",
          "dest": "/api/terminal/sessions.js"
        },
        {
          "src": "/api/voice/sessions",
          "dest": "/api/voice/sessions"
        },
        {
          "src": "/api/voice/sessions\\.js",
          "dest": "/api/voice/sessions.js"
        },
        {
          "src": "/api/(.*)",
          "dest": "/api/default.js?route=orpc&route-path=$1"
        },
        {
          "src": "/app\\.html",
          "status": 308,
          "headers": {
            "Location": "/app"
          }
        },
        {
          "src": "/app/?",
          "dest": "/app.html",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.googleusercontent.com https://github.com https://avatars.githubusercontent.com https://storage-public.keyframelabs.com; font-src 'self' data:; media-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.us.sentry.io wss://*.compute.c-10.us-east-1.aws.neon.tech; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          }
        },
        {
          "src": "/(?!api/)[^/]+/(?:plan|task|agent|inbox|automations?|factory|settings|person|chat)(?:/[^/]+)*/?",
          "dest": "/app.html",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.googleusercontent.com https://github.com https://avatars.githubusercontent.com https://storage-public.keyframelabs.com; font-src 'self' data:; media-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.us.sentry.io wss://*.compute.c-10.us-east-1.aws.neon.tech; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          }
        },
        {
          "src": "/page-in-mac-app\\.html",
          "dest": "/page-in-mac-app.html",
          "headers": {
            "Content-Security-Policy": "default-src 'none'; style-src 'sha256-T8LCl/OB0jEsLle1y3r4VpAUju2q/bJyH99iBqhrZi8='; base-uri 'none'; form-action 'none'; frame-ancestors 'self'",
            "X-Frame-Options": "SAMEORIGIN",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          }
        },
        {
          "src": "/(connect-github|github-installed|integration-connected)\\.html",
          "dest": "/$1.html",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self' https://us-assets.i.posthog.com; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          }
        },
        {
          "src": "/admin(?:\\.html)?",
          "dest": "/admin.html",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Cross-Origin-Opener-Policy": "same-origin",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          }
        },
        {
          "src": "/(?!api/|assets/).*",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self' https://us-assets.i.posthog.com; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Frame-Options": "DENY",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Cross-Origin-Opener-Policy": "same-origin",
            "Permissions-Policy": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
          },
          "continue": true
        },
        {
          "src": "/about",
          "dest": "/about.html"
        },
        {
          "src": "/privacy",
          "dest": "/privacy.html"
        },
        {
          "src": "/changelog",
          "dest": "/changelog.html"
        },
        {
          "src": "/changelog/page/(\\d+)",
          "dest": "/changelog/page/$1.html"
        },
        {
          "src": "/changelog/(\\d+\\.\\d+\\.\\d+)",
          "dest": "/changelog/$1.html"
        }
      ]
    },
    "luke": {
      "root": "apps/luke",
      "framework": "eve",
      "installCommand": "pnpm install --frozen-lockfile --filter @luke/luke...",
      "buildCommand": "pnpm exec eve build && pnpm exec bash ../../scripts/eve-source-maps.sh",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/luke :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json :/vercel.json :/scripts/eve-source-maps.sh"
    },
    "dev": {
      "root": "apps/dev",
      "framework": "eve",
      "installCommand": "pnpm install --frozen-lockfile --filter @luke/coder...",
      "buildCommand": "export EVE_PUBLIC_ROUTE_PREFIX=/eve/coder && pnpm exec eve build && pnpm exec bash ../../scripts/eve-source-maps.sh",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/dev :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json :/vercel.json :/scripts/eve-source-maps.sh",
      "routes": [
        {
          "src": "^/eve/coder/v1/(.*)$",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/eve/v1/$1"
            }
          ]
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/sweep",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/eve/coder/v1/(.*)",
      "destination": {
        "service": "dev"
      }
    },
    {
      "source": "/eve/v1/(.*)",
      "destination": {
        "service": "luke"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
