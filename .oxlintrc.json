{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".opencode/**",
    "packages/agent-runner/src/codex-protocol/**",
    "tools/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/anti-slop/index.ts"
    }
  ],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@luke/ui/icons", "lucide-react", "lucide-react/**"],
            "importNamePattern": "Sparkle",
            "message": "Never draw a sparkle, in any of its glyphs: draw the act's own glyph from `GLYPH`, such as `GLYPH.RETRY` for an act that runs again."
          }
        ]
      }
    ],
    "anti-slop/async-press-needs-busy": "error",
    "anti-slop/enforce-delete-with-where": "error",
    "anti-slop/enforce-update-with-where": "error",
    "anti-slop/no-await-drizzle-statement": "error",
    "anti-slop/no-browser-form-validation": "error",
    "anti-slop/no-direct-view-storage": "error",
    "anti-slop/no-document-press-listener": "error",
    "anti-slop/no-focused-or-skipped-test": "error",
    "anti-slop/no-follow-outside-host-read": "error",
    "anti-slop/no-hand-written-arrow-keys": "error",
    "anti-slop/no-hand-written-live-region": "error",
    "anti-slop/no-internal-vi-mock": "error",
    "anti-slop/no-lucide-outside-door": "error",
    "anti-slop/no-node-test": "error",
    "anti-slop/no-open-page-from-button": "error",
    "anti-slop/no-product-name": "error",
    "anti-slop/no-raw-async-primitives": "error",
    "anti-slop/no-raw-heading-outside-ui": "error",
    "anti-slop/no-raw-press-outside-ui": "error",
    "anti-slop/no-run-promise-outside-edges": "error",
    "anti-slop/no-shadcn-focus-ring": "error",
    "anti-slop/no-source-read-in-test": "error",
    "anti-slop/retired": "error",
    "anti-slop/skeleton-through-components": "error"
  },
  "overrides": [
    {
      "files": ["packages/ui/src/icons/icons.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.mjs", "**/*.test.tsx"],
      "rules": {
        "anti-slop/enforce-delete-with-where": "off"
      }
    }
  ]
}
