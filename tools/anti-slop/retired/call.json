    { "class": "call-mutes", "allow": ["packages/ui/src/components/call/"] },
    { "class": "call-status*", "allow": ["packages/ui/src/components/call/"] },
    { "class": "call-backend*", "allow": ["packages/ui/src/components/call/"] },
    { "class": "call-video-*", "allow": ["packages/ui/src/components/call/"] },
    { "class": "voice-notice", "allow": [] },
