{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint", "turbo"],
  "ignoreBinaries": [
    "iconutil",
    "ditto",
    "shasum",
    "tiffutil",
    "codesign",
    "xcrun",
    "swiftc",
    "electron"
  ],
  "ignore": [".opencode/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/fixtures/discarded-effect/*.ts",
        "design/generate-brand-assets.mjs",
        "design/generate-surface-shared.mjs"
      ],
      "project": ["scripts/**", "design/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.tsx",
        "src/renderer/styles/index.css",
        "src/renderer/whiteboard/index.tsx",
        "src/renderer/whiteboard/index.css",
        "src/renderer/plan-editor/index.ts",
        "src/renderer/session-recorder/index.ts",
        "src/renderer/terminal/index.ts",
        "src/renderer/terminal/index.css",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "src/*.tsx",
        "src/entry-server.tsx",
        "server/db/migrate.ts",
        "scripts/*.ts",
        "server/feedback.mjs"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"]
    },
    "packages/*": {
      "entry": [
        "src/ui-messages/index.ts",
        "src/testing/index.ts",
        "src/effect/index.ts",
        "src/analytics/index.ts"
      ],
      "project": ["src/**"]
    },
    "apps/web/coder": {
      "entry": ["instructions/*.ts", "evals/evals.config.ts", "evals/*.eval.ts"],
      "project": ["**/*.ts"]
    },
    "apps/web/eve": {
      "entry": ["instructions/*.ts", "evals/evals.config.ts", "evals/*.eval.ts"],
      "project": ["**/*.ts"]
    },
    "tools/anti-slop": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
