{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint", "turbo"],
  "ignoreBinaries": ["afconvert", "iconutil", "ditto", "shasum", "tiffutil"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/fixtures/discarded-effect/*.ts",
        "scripts/vercel-deployed-paths.mjs",
        "scripts/test-durations.mjs"
      ],
      "project": ["scripts/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/utility/task-code.ts",
        "src/renderer/index.tsx",
        "src/renderer/styles/index.css",
        "src/renderer/session-recorder/index.ts",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/host": {
      "entry": ["src/main.ts", "scripts/*.ts"],
      "project": ["src/**", "scripts/**"]
    },
    "apps/cli": {
      "entry": ["src/main.ts"],
      "project": ["src/**"]
    },
    "apps/catalog": {
      "project": ["src/**"],
      "ignoreDependencies": ["playwright"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "server/orpc-route.ts",
        "src/*.tsx",
        "src/app/main.tsx",
        "src/entry-server.tsx",
        "scripts/*.ts",
        "server/feedback.mjs",
        "server/feedback.d.mts"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"],
      "ignoreDependencies": ["@repo/brand"]
    },
    "packages/*": {
      "entry": [
        "src/ui-messages/index.ts",
        "src/testing/index.ts",
        "src/effect/index.ts",
        "src/analytics/index.ts"
      ],
      "project": ["src/**"]
    },
    "packages/agent-runner": {
      "project": ["src/**", "scripts/**"],
      "ignore": ["src/codex-protocol/**"]
    },
    "tools/claude-code-probe": {
      "entry": ["src/sandbox/driver.mjs"],
      "project": ["src/**", "tests/**"],
      "ignoreDependencies": ["@anthropic-ai/claude-agent-sdk"]
    },
    "tools/demo-postgres": {
      "entry": ["demo-postgres.ts"],
      "project": ["*.ts"]
    },
    "tools/anti-slop": {
      "entry": ["index.ts", "repository-guard.ts"],
      "project": ["**/*.ts"]
    },
    "tools/polish": {
      "entry": ["polish-shots.ts"],
      "ignoreDependencies": ["playwright", "vite"]
    },
    "packages/brand": {
      "project": ["src/**", "scripts/**"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
