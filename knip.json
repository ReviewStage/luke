{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint", "turbo"],
  "ignoreBinaries": [
    "iconutil",
    "ditto",
    "shasum",
    "tiffutil",
    "codesign",
    "xcrun",
    "swiftc",
    "electron"
  ],
  "ignore": [".opencode/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/fixtures/discarded-effect/*.ts", "scripts/fixtures/task-names/*.ts"],
      "project": ["scripts/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.tsx",
        "src/renderer/voice/index.tsx",
        "src/renderer/call/index.tsx",
        "src/renderer/styles/index.css",
        "src/renderer/factory-world/scene/index.ts",
        "src/renderer/factory-world/worlds/*/index.ts",
        "src/renderer/session-recorder/index.ts",
        "src/renderer/avatar-feed/pcm-tee-worklet.ts",
        "src/renderer/avatar-session/index.ts",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/catalog": {
      "entry": ["src/main.tsx"],
      "project": ["src/**"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "src/*.tsx",
        "src/entry-server.tsx",
        "server/db/migrate.ts",
        "scripts/*.ts",
        "server/feedback.mjs",
        "server/feedback.d.mts"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"]
    },
    "packages/*": {
      "entry": [
        "src/ui-messages/index.ts",
        "src/testing/index.ts",
        "src/effect/index.ts",
        "src/analytics/index.ts"
      ],
      "project": ["src/**"]
    },
    "apps/dev": {
      "ignoreDependencies": [
        "@ai-sdk/anthropic",
        "@ai-sdk/openai",
        "@better-auth/drizzle-adapter",
        "@better-auth/electron",
        "@better-auth/oauth-provider",
        "@sentry/cli",
        "@sentry/effect",
        "@vercel/connect",
        "@vercel/oidc",
        "better-auth",
        "diff",
        "ws"
      ],
      "entry": [
        "{,subagents/*/}agent.ts",
        "{,subagents/*/}sandbox.ts",
        "{,subagents/*/}instructions.ts",
        "{,subagents/*/}instructions/*.ts",
        "{,subagents/*/}{channels,connections,hooks,skills,tools}/**/*.ts",
        "instrumentation/*.ts",
        "nitro.config.ts",
        "evals/evals.config.ts",
        "evals/*.eval.ts"
      ],
      "project": ["**/*.ts"]
    },
    "apps/luke": {
      "ignoreDependencies": [
        "@ai-sdk/anthropic",
        "@ai-sdk/openai",
        "@better-auth/drizzle-adapter",
        "@better-auth/electron",
        "@better-auth/oauth-provider",
        "@sentry/cli",
        "@sentry/effect",
        "@vercel/connect",
        "@vercel/oidc",
        "better-auth",
        "diff",
        "ws"
      ],
      "entry": [
        "{,subagents/*/}agent.ts",
        "{,subagents/*/}sandbox.ts",
        "{,subagents/*/}instructions.ts",
        "{,subagents/*/}instructions/*.ts",
        "{,subagents/*/}{channels,connections,hooks,skills,tools}/**/*.ts",
        "instrumentation/*.ts",
        "nitro.config.ts",
        "evals/evals.config.ts",
        "evals/*.eval.ts"
      ],
      "project": ["**/*.ts"]
    },
    "tools/anti-slop": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "packages/brand": {
      "entry": ["scripts/generate-brand-assets.mjs", "scripts/generate-surface-shared.mjs"],
      "project": ["src/**", "scripts/**"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
