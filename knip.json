{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint", "turbo"],
  "ignoreBinaries": ["afconvert", "iconutil", "ditto", "shasum", "tiffutil"],
  "workspaces": {
    ".": {
      "entry": ["scripts/fixtures/discarded-effect/*.ts", "scripts/vercel-deployed-paths.mjs"],
      "project": ["scripts/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/utility/task-code.ts",
        "src/renderer/index.tsx",
        "src/renderer/voice/index.tsx",
        "src/renderer/call/index.tsx",
        "src/renderer/styles/index.css",
        "src/renderer/session-recorder/index.ts",
        "src/renderer/avatar-feed/pcm-tee-worklet.ts",
        "src/renderer/avatar-session/index.ts",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/catalog": {
      "project": ["src/**"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "server/orpc-route.ts",
        "src/*.tsx",
        "src/app/main.tsx",
        "src/entry-server.tsx",
        "scripts/*.ts",
        "server/feedback.mjs",
        "server/feedback.d.mts"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"]
    },
    "packages/*": {
      "entry": [
        "src/ui-messages/index.ts",
        "src/testing/index.ts",
        "src/effect/index.ts",
        "src/analytics/index.ts"
      ],
      "project": ["src/**"]
    },
    "apps/dev": {
      "ignoreDependencies": [
        "@ai-sdk/anthropic",
        "@ai-sdk/openai",
        "@better-auth/drizzle-adapter",
        "@better-auth/electron",
        "@better-auth/oauth-provider",
        "@sentry/cli",
        "@sentry/effect",
        "@vercel/connect",
        "@vercel/oidc",
        "better-auth",
        "diff",
        "ws"
      ],
      "entry": [
        "{,subagents/*/}agent.ts",
        "{,subagents/*/}sandbox.ts",
        "{,subagents/*/}instructions.ts",
        "{,subagents/*/}instructions/*.ts",
        "{,subagents/*/}{channels,connections,hooks,skills,tools}/**/*.ts",
        "instrumentation/*.ts",
        "nitro.config.ts",
        "evals/evals.config.ts",
        "evals/*.eval.ts"
      ],
      "project": ["**/*.ts"]
    },
    "packages/agent-runner": {
      "project": ["src/**", "scripts/**"],
      "ignore": ["src/codex-protocol/**"]
    },
    "tools/claude-code-probe": {
      "entry": ["src/sandbox/driver.mjs"],
      "project": ["src/**", "tests/**"],
      "ignoreDependencies": ["@anthropic-ai/claude-agent-sdk"]
    },
    "tools/anti-slop": {
      "entry": ["index.ts"],
      "project": ["**/*.ts"]
    },
    "packages/brand": {
      "project": ["src/**", "scripts/**"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
