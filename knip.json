{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint"],
  "ignoreBinaries": [
    "iconutil",
    "ditto",
    "shasum",
    "tiffutil",
    "codesign",
    "xcrun",
    "swiftc",
    "electron"
  ],
  "ignore": [".opencode/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/generate-provider-readme.ts",
        "scripts/fixtures/discarded-effect/*.ts",
        "design/check-design-contract.mjs",
        "design/generate-brand-assets.mjs",
        "design/generate-surface-shared.mjs",
        "tools/oxlint/anti-slop/fixtures/*.ts"
      ],
      "project": ["scripts/**", "design/**", "tools/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/index.tsx",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "src/*.tsx",
        "src/entry-server.tsx",
        "server/db/migrate.ts",
        "scripts/*.ts",
        "server/feedback.mjs"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"],
      "ignoreDependencies": ["@sidecar/providers"]
    },
    "packages/*": {
      "entry": ["src/ui-messages/index.ts", "src/testing/index.ts", "src/effect/index.ts"],
      "project": ["src/**"]
    },
    "apps/web/eve": {
      "entry": ["instructions/*.ts", "memory/*.ts", "evals/evals.config.ts", "evals/*.eval.ts"],
      "project": ["**/*.ts"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
