{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["oxlint", "husky", "lint-staged"],
  "ignoreBinaries": [
    "iconutil",
    "ditto",
    "shasum",
    "tiffutil",
    "codesign",
    "xcrun",
    "hdiutil",
    "swiftc",
    "electron"
  ],
  "ignore": [".opencode/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/*.test.mjs",
        "design/*.mjs",
        "tools/**/*.ts",
        "tools/**/*.mjs",
        "apps/ios/*.test.mjs",
        "scripts/*.ts"
      ],
      "project": ["scripts/**", "design/**", "tools/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/main/store-worker.ts",
        "src/preload/index.ts",
        "src/renderer/index.tsx",
        "src/renderer/voice/index.tsx",
        "src/**/*.test.ts",
        "scripts/*.mjs",
        "electron-builder.ts"
      ],
      "project": ["src/**", "scripts/**"]
    },
    "apps/web": {
      "entry": [
        "server/routes/**/*.ts",
        "src/*.tsx",
        "src/entry-server.tsx",
        "server/db/migrate.ts",
        "scripts/*.ts",
        "tests/**/*.test.ts",
        "server/feedback.mjs"
      ],
      "project": ["src/**", "server/**", "scripts/**", "tests/**"],
      "ignoreDependencies": ["@sidecar/providers"]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/worker-entry.ts",
        "src/ui-messages/index.ts",
        "src/testing/index.ts",
        "src/effect/index.ts"
      ],
      "project": ["src/**"]
    },
    "packages/gateway": {
      "entry": ["src/**/*.test.ts", "src/rpc.ts"],
      "project": ["src/**"]
    },
    "packages/brain": {
      "entry": [
        "src/**/*.test.ts",
        "src/**/worker-entry.ts",
        "src/ui-messages/index.ts",
        "src/store/index.ts"
      ],
      "project": ["src/**"],
      "ignoreDependencies": ["tsx"]
    },
    "tools/*": {
      "entry": ["src/*.ts", "*.ts", "*.mjs", "**/*.test.*"],
      "project": ["**/*.ts", "**/*.mjs"]
    },
    "apps/web/eve": {
      "entry": ["**/*.ts"],
      "project": ["**/*.ts"]
    }
  },
  "rules": {
    "duplicates": "off"
  }
}
