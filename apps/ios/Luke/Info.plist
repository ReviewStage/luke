<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. The value is the
	     POSTHOG_PROJECT_API_KEY build setting, empty unless a build injects
	     one — and empty is the kill switch: SessionReplay.start() refuses to
	     configure the SDK at all, the same posture the desktop's packaged
	     define keeps. -->
	<key>LukePostHogProjectAPIKey</key>
	<string>$(POSTHOG_PROJECT_API_KEY)</string>
</dict>
</plist>
