{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --filter @luke/web...",
      "buildCommand": "pnpm db:migrate && pnpm auth:seed && pnpm build",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/web :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json",
      "routes": [
        {
          "src": "/api/auth/(.*)",
          "dest": "/api/default.js?route=auth/[...all]&route-path=auth/$1"
        },
        {
          "src": "/api/plans/([^/]+)/board",
          "dest": "/api/default.js?route=plans/board&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/transcript",
          "dest": "/api/default.js?route=plans/transcript&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/work",
          "dest": "/api/default.js?route=plans/work&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/file",
          "dest": "/api/default.js?route=plans/file&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/tree",
          "dest": "/api/default.js?route=plans/tree&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/skills",
          "dest": "/api/default.js?route=plans/skills&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/edit",
          "dest": "/api/default.js?route=plans/edit&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/agents",
          "dest": "/api/default.js?route=plans/agents&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/inbox",
          "dest": "/api/default.js?route=plans/inbox&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)/revisions/([^/]+)/restore",
          "dest": "/api/default.js?route=plans/restore&id=$1&seq=$2"
        },
        {
          "src": "/api/plans/([^/]+)/revisions/([^/]+)",
          "dest": "/api/default.js?route=plans/revision&id=$1&seq=$2"
        },
        {
          "src": "/api/plans/([^/]+)/revisions",
          "dest": "/api/default.js?route=plans/revisions&id=$1"
        },
        {
          "src": "/api/plans/([^/]+)",
          "dest": "/api/default.js?route=plans/plan&id=$1"
        },
        {
          "src": "/api/account/plan-template/revisions/([^/]+)/restore",
          "dest": "/api/default.js?route=account/plan-template/restore&seq=$1"
        },
        {
          "src": "/api/account/plan-template/revisions/([^/]+)",
          "dest": "/api/default.js?route=account/plan-template/revision&seq=$1"
        },
        {
          "src": "/api/agents/([^/]+)/subagents/([^/]+)/messages",
          "dest": "/api/default.js?route=agents/subagent-messages&id=$1&call=$2"
        },
        {
          "src": "/api/agents/([^/]+)/messages",
          "dest": "/api/default.js?route=agents/messages&id=$1"
        },
        {
          "src": "/api/agents/([^/]+)/stop",
          "dest": "/api/default.js?route=agents/stop&id=$1"
        },
        {
          "src": "/api/agents/([^/]+)/pull-request",
          "dest": "/api/default.js?route=agents/pull-request&id=$1"
        },
        {
          "src": "/api/agents/([^/]+)",
          "dest": "/api/default.js?route=agents/agent&id=$1"
        },
        {
          "src": "/api/inbox/([^/]+)/attachments/([^/]+)",
          "dest": "/api/default.js?route=inbox/attachment&id=$1&attachment=$2"
        },
        {
          "src": "/api/inbox/([^/]+)",
          "dest": "/api/default.js?route=inbox/item&id=$1"
        },
        {
          "src": "/api/account/delete",
          "dest": "/api/default.js?route=account/delete"
        },
        {
          "src": "/api/account/linear",
          "dest": "/api/default.js?route=account/linear"
        },
        {
          "src": "/api/account/linear/connect",
          "dest": "/api/default.js?route=account/linear/connect"
        },
        {
          "src": "/api/account/linear/connected",
          "dest": "/api/default.js?route=account/linear/connected"
        },
        {
          "src": "/api/account/linear/disconnect",
          "dest": "/api/default.js?route=account/linear/disconnect"
        },
        {
          "src": "/api/account/plan-template",
          "dest": "/api/default.js?route=account/plan-template"
        },
        {
          "src": "/api/account/plan-template/revisions",
          "dest": "/api/default.js?route=account/plan-template/revisions"
        },
        {
          "src": "/api/account/preferences",
          "dest": "/api/default.js?route=account/preferences"
        },
        {
          "src": "/api/account/provider-keys",
          "dest": "/api/default.js?route=account/provider-keys"
        },
        {
          "src": "/api/admin/day",
          "dest": "/api/default.js?route=admin/day"
        },
        {
          "src": "/api/admin/favorite",
          "dest": "/api/default.js?route=admin/favorite"
        },
        {
          "src": "/api/admin/metrics",
          "dest": "/api/default.js?route=admin/metrics"
        },
        {
          "src": "/api/admin/user",
          "dest": "/api/default.js?route=admin/user"
        },
        {
          "src": "/api/admin/users",
          "dest": "/api/default.js?route=admin/users"
        },
        {
          "src": "/api/dictation",
          "dest": "/api/default.js?route=dictation"
        },
        {
          "src": "/api/events",
          "dest": "/api/default.js?route=events"
        },
        {
          "src": "/api/github/install",
          "dest": "/api/default.js?route=github/install"
        },
        {
          "src": "/api/github/installed",
          "dest": "/api/default.js?route=github/installed"
        },
        {
          "src": "/api/github/repositories",
          "dest": "/api/default.js?route=github/repositories"
        },
        {
          "src": "/api/github/webhook",
          "dest": "/api/default.js?route=github/webhook"
        },
        {
          "src": "/api/inbox",
          "dest": "/api/default.js?route=inbox"
        },
        {
          "src": "/api/maintenance/provider-keys-rewrap",
          "dest": "/api/default.js?route=maintenance/provider-keys-rewrap"
        },
        {
          "src": "/api/models",
          "dest": "/api/default.js?route=models"
        },
        {
          "src": "/api/plans",
          "dest": "/api/default.js?route=plans"
        },
        {
          "src": "/api/repository-pins",
          "dest": "/api/default.js?route=repository-pins"
        },
        {
          "src": "/api/maintenance/sweep",
          "dest": "/api/maintenance-sweep.js?route=maintenance/sweep"
        },
        {
          "src": "/about",
          "dest": "/about.html"
        },
        {
          "src": "/privacy",
          "dest": "/privacy.html"
        },
        {
          "src": "/changelog",
          "dest": "/changelog.html"
        },
        {
          "src": "/admin",
          "dest": "/admin.html"
        }
      ]
    },
    "eve": {
      "root": "eve",
      "framework": "eve",
      "installCommand": "cd .. && pnpm install --frozen-lockfile --filter @luke/web... --filter @luke/eve",
      "buildCommand": "pnpm exec eve build",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/web :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json"
    },
    "coder": {
      "root": "coder",
      "framework": "eve",
      "installCommand": "cd .. && pnpm install --frozen-lockfile --filter @luke/web... --filter @luke/coder",
      "buildCommand": "export EVE_PUBLIC_ROUTE_PREFIX=/eve/coder && pnpm exec eve build",
      "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/apps/web :/packages :/pnpm-lock.yaml :/pnpm-workspace.yaml :/package.json",
      "routes": [
        {
          "src": "^/eve/coder/v1/(.*)$",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/eve/v1/$1"
            }
          ]
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/sweep",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/eve/coder/v1/(.*)",
      "destination": {
        "service": "coder"
      }
    },
    {
      "source": "/eve/v1/(.*)",
      "destination": {
        "service": "eve"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
