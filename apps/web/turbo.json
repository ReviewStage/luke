{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The web app imports the changelog and the privacy notice from the
    // repository's root, so its build and its tests read them as inputs; no
    // other workspace does, which is why they are not global dependencies.
    // An explicit inputs list replaces turbo's defaults, so each starts with
    // $TURBO_DEFAULT$.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CHANGELOG.md", "$TURBO_ROOT$/PRIVACY.md"]
    },
    // Some of web's tests also run a script from the repository's own
    // scripts/ (the Vercel ignore step among them), so that directory is an
    // input as well, or a change to a script alone would replay the old pass.
    "test:vitest": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/PRIVACY.md",
        "$TURBO_ROOT$/scripts/**"
      ]
    }
  }
}
