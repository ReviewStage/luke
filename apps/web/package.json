{
  "name": "@luke/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Luke landing page",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "auth:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://schema:generate@127.0.0.1:5432/luke} pnpm dlx @better-auth/cli@1.4.21 generate --config server/auth.ts --output server/db/auth-schema.ts --yes && pnpm exec biome check --write server/db/auth-schema.ts",
    "auth:seed": "tsx server/seed-clients.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts && tsx scripts/bundle-functions.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev": "vite",
    "functions:stubs": "tsx scripts/function-stubs.ts --write",
    "preview": "vite preview",
    "test": "vitest run && pnpm test:agent",
    "test:agent": "LUKE_BRAIN_MODEL_FIXTURE=scripted eve eval",
    "test:store": "vitest run tests/hosted-store.test.ts tests/hosted-payload-envelope.test.ts tests/storage-schema.test.ts tests/voice-schema.test.ts tests/hosted-store-writer.test.ts tests/storage-reads.test.ts tests/voice-writer.test.ts tests/storage-ratings.test.ts tests/storage-speech.test.ts tests/hosted-resource-reads.test.ts tests/hosted-change-signal.test.ts tests/devices-instants.test.ts tests/hosted-turn-event-stream.test.ts tests/hosted-standing-main.test.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.65",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@better-auth/oauth-provider": "1.6.29",
    "@effect/platform": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@paper-design/shaders": "0.0.80",
    "@sidecar/actions": "workspace:*",
    "@sidecar/analytics": "workspace:*",
    "@sidecar/brain": "workspace:*",
    "@sidecar/hosted": "workspace:*",
    "@sidecar/panel": "workspace:*",
    "@sidecar/runtime": "workspace:*",
    "@sidecar/session": "workspace:*",
    "@sidecar/settings": "workspace:*",
    "@sidecar/surface": "workspace:*",
    "@sidecar/wire": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "ai": "catalog:",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "eve": "0.53.1",
    "marked": "18.0.9",
    "pg": "8.23.0",
    "posthog-js": "1.418.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "catalog:web",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.27.7",
    "tsx": "catalog:",
    "typescript": "catalog:web",
    "vite": "7.3.1",
    "vitest": "catalog:",
    "zod": "4.5.4"
  }
}
