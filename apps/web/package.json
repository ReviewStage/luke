{
  "name": "@luke/web",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "description": "Luke landing page",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "auth:seed": "tsx server/seed-clients.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts && tsx scripts/bundle-functions.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev": "vite",
    "functions:rewrites": "tsx scripts/function-rewrites.ts --write",
    "functions:externals": "tsx scripts/function-externals.ts --write",
    "preview": "vite preview",
    "test": "vitest run && pnpm test:agent",
    "test:agent": "pnpm --filter @luke/luke run test:agent && pnpm --filter @luke/coder run test:agent",
    "test:store": "tsx scripts/store-tests.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@effect/atom-react": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@luke/credentials": "workspace:*",
    "@luke/database": "workspace:*",
    "@luke/features": "workspace:*",
    "@luke/host": "workspace:*",
    "@luke/live": "workspace:*",
    "@luke/panel": "workspace:*",
    "@luke/runtime": "workspace:*",
    "@luke/service": "workspace:*",
    "@luke/settings": "workspace:*",
    "@luke/brand": "workspace:*",
    "@luke/ui": "workspace:*",
    "@luke/voice": "workspace:*",
    "@luke/wire": "workspace:*",
    "@sentry/browser": "11.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/functions": "3.10.1",
    "ai": "catalog:",
    "better-auth": "1.7.7",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "marked": "18.0.9",
    "pg": "8.23.0",
    "posthog-js": "1.418.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.5.8",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@sentry/esbuild-plugin": "5.4.0",
    "@sentry/vite-plugin": "5.4.0",
    "@types/node": "catalog:",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.2",
    "esbuild": "0.27.7",
    "jsdom": "^30.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:web",
    "vite": "7.3.1",
    "vitest": "catalog:",
    "zod": "4.5.4"
  }
}
