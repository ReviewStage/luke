{
  "name": "@luke/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Luke landing page",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "auth:seed": "tsx server/seed-clients.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts && tsx scripts/bundle-functions.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev": "vite",
    "functions:rewrites": "tsx scripts/function-rewrites.ts --write",
    "functions:externals": "tsx scripts/function-externals.ts --write",
    "preview": "vite preview",
    "test": "vitest run && pnpm test:agent",
    "test:agent": "pnpm --filter @luke/eve run test:agent",
    "test:store": "tsx scripts/store-tests.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.65",
    "@better-auth/drizzle-adapter": "1.6.29",
    "@better-auth/oauth-provider": "1.6.29",
    "@effect/sql-pg": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@paper-design/shaders": "0.0.80",
    "@sidecar/actions": "workspace:*",
    "@sidecar/analytics": "workspace:*",
    "@sidecar/brain": "workspace:*",
    "@sidecar/hosted": "workspace:*",
    "@sidecar/live": "workspace:*",
    "@sidecar/panel": "workspace:*",
    "@sidecar/providers": "workspace:*",
    "@sidecar/runtime": "workspace:*",
    "@sidecar/session": "workspace:*",
    "@sidecar/settings": "workspace:*",
    "@sidecar/surface": "workspace:*",
    "@sidecar/voice": "workspace:*",
    "@sidecar/wire": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "ai": "catalog:",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "effect": "catalog:",
    "eve": "0.53.1",
    "marked": "18.0.9",
    "pg": "8.23.0",
    "posthog-js": "1.418.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "catalog:",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.2",
    "esbuild": "0.27.7",
    "tsx": "catalog:",
    "typescript": "catalog:web",
    "vite": "7.3.1",
    "vitest": "catalog:",
    "zod": "4.5.4"
  }
}
