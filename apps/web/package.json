{
  "name": "@luke/web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Luke landing page",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "auth:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://schema:generate@127.0.0.1:5432/luke} pnpm dlx @better-auth/cli@1.4.21 generate --config server/auth.ts --output server/db/auth-schema.ts --yes && pnpm exec biome check --write server/db/auth-schema.ts",
    "auth:seed": "tsx server/seed-clients.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:store": "tsx --test tests/hosted-store.test.ts tests/hosted-payload-envelope.test.ts tests/storage-schema.test.ts tests/voice-schema.test.ts tests/hosted-store-writer.test.ts tests/storage-reads.test.ts tests/voice-writer.test.ts",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.29",
    "@better-auth/oauth-provider": "1.6.29",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@paper-design/shaders": "0.0.80",
    "@sidecar/brain": "workspace:*",
    "@sidecar/hosted": "workspace:*",
    "@sidecar/panel": "workspace:*",
    "@sidecar/realtime": "workspace:*",
    "@sidecar/session": "workspace:*",
    "@sidecar/settings": "workspace:*",
    "@sidecar/surface": "workspace:*",
    "@sidecar/wire": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "ai": "7.0.97",
    "better-auth": "1.6.29",
    "drizzle-orm": "0.45.2",
    "marked": "18.0.9",
    "pg": "8.23.0",
    "posthog-js": "1.418.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "7.3.1",
    "zod": "4.5.4"
  }
}
