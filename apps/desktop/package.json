{
  "name": "@repo/desktop",
  "productName": "Vespin",
  "version": "0.25.1",
  "private": true,
  "description": "Vespin desktop application",
  "main": "dist/main.js",
  "imports": {
    "#main/*": [
      "./src/main/*.ts",
      "./src/main/*"
    ],
    "#preload/*": [
      "./src/preload/*.ts",
      "./src/preload/*"
    ],
    "#renderer/*": [
      "./src/renderer/*.ts",
      "./src/renderer/*"
    ],
    "#shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "package": "pnpm build:native && pnpm build && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --publish never",
    "package:dir": "pnpm build:native && pnpm build && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --dir --publish never",
    "release": "APP_ELECTRON_BUILDER_NOTARIZE=1 pnpm package",
    "start": "pnpm build:native && pnpm build && electron .",
    "test:vitest": "vitest run",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@repo/brand": "workspace:*",
    "@repo/credentials": "workspace:*",
    "@repo/features": "workspace:*",
    "@repo/gateway": "workspace:*",
    "@repo/host": "workspace:*",
    "@repo/panel": "workspace:*",
    "@repo/settings": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/wire": "workspace:*",
    "@sentry/esbuild-plugin": "5.4.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "effect": "catalog:",
    "electron": "43.3.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "posthog-js": "1.418.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.9"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
