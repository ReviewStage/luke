{
  "name": "@luke/desktop",
  "productName": "Luke",
  "version": "0.16.0",
  "private": true,
  "description": "Luke desktop application",
  "main": "dist/main.js",
  "imports": {
    "#main/*": [
      "./src/main/*.ts",
      "./src/main/*"
    ],
    "#preload/*": [
      "./src/preload/*.ts",
      "./src/preload/*"
    ],
    "#renderer/*": [
      "./src/renderer/*.ts",
      "./src/renderer/*"
    ],
    "#shared/*": [
      "./src/shared/*.ts",
      "./src/shared/*"
    ],
    "#testing/*": [
      "./src/testing/*.ts",
      "./src/testing/*"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "package": "pnpm build:native && pnpm build && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --publish never",
    "package:dir": "pnpm build:native && pnpm build && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --dir --publish never",
    "release": "LUKE_ELECTRON_BUILDER_NOTARIZE=1 pnpm package",
    "start": "pnpm build:native && pnpm build && electron .",
    "test:vitest": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@excalidraw/excalidraw": "0.18.1",
    "@keyframelabs/sdk": "0.3.0",
    "@luke/brand": "workspace:*",
    "@luke/credentials": "workspace:*",
    "@luke/features": "workspace:*",
    "@luke/gateway": "workspace:*",
    "@luke/host": "workspace:*",
    "@luke/live": "workspace:*",
    "@luke/settings": "workspace:*",
    "@luke/ui": "workspace:*",
    "@luke/voice": "workspace:*",
    "@luke/wire": "workspace:*",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@sentry/esbuild-plugin": "5.4.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/hast": "3.0.5",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ai": "catalog:",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "effect": "catalog:",
    "electron": "43.3.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.2",
    "hast-util-to-html": "9.0.5",
    "jsdom": "^30.0.1",
    "livekit-client": "2.22.4",
    "lucide-react": "1.53.0",
    "mermaid": "11.17.2",
    "posthog-js": "1.418.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@sentry/electron": "8.2.0",
    "electron-updater": "6.8.9"
  }
}
