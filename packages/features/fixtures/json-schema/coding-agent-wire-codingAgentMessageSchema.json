{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "asked": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 20
    },
    "askedAt": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "voiceSessionId": {
            "type": "string",
            "maxLength": 128
          },
          "fromMs": {
            "type": "number"
          }
        },
        "required": [
          "voiceSessionId",
          "fromMs"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "origin": {
      "type": "string",
      "enum": [
        "typed",
        "spoken",
        "transcript_change",
        "child",
        "child_completion"
      ]
    },
    "earlierOmitted": {
      "type": "boolean"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "sentBy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "member",
            "former",
            "luke",
            "automation",
            "github"
          ]
        },
        "agent": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "sentAt": {
      "type": "number",
      "minimum": 0
    },
    "arrivedIn": {
      "type": "object",
      "properties": {
        "journalId": {
          "type": "string"
        },
        "afterStep": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "journalId",
        "afterStep"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "number",
      "minimum": 0
    },
    "finishedAt": {
      "type": "number",
      "minimum": 0
    },
    "model": {
      "type": "string",
      "maxLength": 200
    },
    "effort": {
      "type": "string",
      "maxLength": 200
    },
    "tokens": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "number",
          "minimum": 0
        },
        "outputTokens": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "number",
          "minimum": 0
        },
        "cacheWriteTokens": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "cachedInputTokens"
      ],
      "additionalProperties": false
    },
    "ending": {
      "type": "string",
      "enum": [
        "stopped",
        "failed",
        "abandoned"
      ]
    },
    "fastRefused": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "role",
    "parts"
  ],
  "additionalProperties": false
}
