  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "pinPosition": {
      "type": "string"
    },
    "archived": {
      "type": "boolean"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "todo",
        "in-progress",
        "done",
        "canceled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "none",
        "urgent",
        "high",
        "medium",
        "low"
      ]
