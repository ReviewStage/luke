{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "template": {
          "type": "string",
          "maxLength": 20000
        },
        "custom": {
          "type": "boolean"
        }
      },
      "required": [
        "template",
        "custom"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "unanswered",
            "not-found",
            "no-repository",
            "repository-not-reachable",
            "github-unanswered",
            "invalid-choice",
            "message-too-long",
            "agent-not-ready",
            "agent-retired",
            "plan-archived",
            "not-permitted"
          ]
        }
      },
      "required": [
        "failure"
      ],
      "additionalProperties": false
    }
  ]
}
