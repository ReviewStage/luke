{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "number",
                  "minimum": 0
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "draft",
                    "merged",
                    "closed"
                  ]
                },
                "html": {
                  "type": "string"
                },
                "base": {
                  "type": "string",
                  "maxLength": 255
                },
                "head": {
                  "type": "string",
                  "maxLength": 255
                },
                "createdAt": {
                  "type": "number",
                  "minimum": 0
                },
                "mergedAt": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "merge": {
                  "type": "string",
                  "enum": [
                    "clean",
                    "unstable",
                    "blocked",
                    "behind",
                    "conflicts",
                    "draft",
                    "unknown"
                  ]
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": "string"
                    },
                    "bot": {
                      "type": "boolean"
                    },
                    "userId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "login",
                    "bot"
                  ],
                  "additionalProperties": false
                },
                "writtenAs": {
                  "type": "string",
                  "enum": [
                    "developer",
                    "app-unlinked",
                    "app-no-push",
                    "app-automation",
                    "app-unread"
                  ]
                },
                "requested": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "login": {
                        "type": "string"
                      },
                      "avatarUrl": {
                        "type": "string"
                      },
                      "bot": {
                        "type": "boolean"
                      },
                      "userId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "login",
                      "bot"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                },
                "merging": {
                  "type": "object",
                  "properties": {
                    "methods": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "merge",
                          "squash",
                          "rebase"
                        ]
                      }
                    },
                    "autoMergeAllowed": {
                      "type": "boolean"
                    },
                    "queue": {
                      "type": "boolean"
                    },
                    "queued": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "position": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "position"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "autoMerge": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "method": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "merge",
                                    "squash",
                                    "rebase"
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "method"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "headSha": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "review": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "approved",
                            "changes-requested",
                            "review-required"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "checks": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "passing",
                        "failing",
                        "none"
                      ]
                    }
                  },
                  "required": [
                    "methods",
                    "autoMergeAllowed",
                    "queue",
                    "queued",
                    "autoMerge",
                    "headSha",
                    "review",
                    "checks"
                  ],
                  "additionalProperties": false
                },
                "requestedTeams": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string",
                        "maxLength": 255
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 255
                      },
                      "color": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "color"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "stack": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "number",
                        "minimum": 0
                      },
                      "title": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "draft": {
                        "type": "boolean"
                      },
                      "agent": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 36
                          },
                          "taskId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 36
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "taskId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "number",
                      "title",
                      "url",
                      "draft"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 30
                }
              },
              "required": [
                "number",
                "title",
                "url",
                "state",
                "html",
                "base",
                "head",
                "createdAt",
                "mergedAt",
                "merge",
                "requested"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pullRequest"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "unanswered",
            "not-found",
            "no-repository",
            "repository-not-reachable",
            "github-unanswered",
            "invalid-choice",
            "message-too-long",
            "agent-not-ready",
            "agent-retired",
            "plan-archived",
            "not-permitted"
          ]
        }
      },
      "required": [
        "failure"
      ],
      "additionalProperties": false
    }
  ]
}
