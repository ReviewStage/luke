{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "previousPath": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "added",
                          "modified",
                          "deleted",
                          "renamed"
                        ]
                      },
                      "additions": {
                        "type": "number",
                        "minimum": 0
                      },
                      "deletions": {
                        "type": "number",
                        "minimum": 0
                      },
                      "patch": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "omitted": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "binary",
                              "too-large"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "previousPath",
                      "status",
                      "additions",
                      "deletions",
                      "patch",
                      "omitted"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 300
                },
                "truncated": {
                  "type": "boolean"
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": "string"
                    },
                    "bot": {
                      "type": "boolean"
                    },
                    "userId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "login",
                    "bot"
                  ],
                  "additionalProperties": false
                },
                "writtenAs": {
                  "type": "string",
                  "enum": [
                    "developer",
                    "app-unlinked",
                    "app-no-push",
                    "app-automation",
                    "app-unread"
                  ]
                },
                "reviewers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "by": {
                        "type": "object",
                        "properties": {
                          "login": {
                            "type": "string"
                          },
                          "avatarUrl": {
                            "type": "string"
                          },
                          "bot": {
                            "type": "boolean"
                          },
                          "userId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "login",
                          "bot"
                        ],
                        "additionalProperties": false
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "approved",
                          "changes-requested",
                          "dismissed",
                          "commented",
                          "requested"
                        ]
                      }
                    },
                    "required": [
                      "by",
                      "state"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                },
                "commitAuthors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "login": {
                        "type": "string"
                      },
                      "avatarUrl": {
                        "type": "string"
                      },
                      "bot": {
                        "type": "boolean"
                      },
                      "userId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "login",
                      "bot"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                },
                "comments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "by": {
                        "type": "object",
                        "properties": {
                          "login": {
                            "type": "string"
                          },
                          "avatarUrl": {
                            "type": "string"
                          },
                          "bot": {
                            "type": "boolean"
                          },
                          "userId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "login",
                          "bot"
                        ],
                        "additionalProperties": false
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "approved",
                          "changes-requested",
                          "dismissed",
                          "commented",
                          "requested"
                        ]
                      },
                      "excerpt": {
                        "type": "string",
                        "maxLength": 280
                      },
                      "at": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "by",
                      "state",
                      "excerpt",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 50
                }
              },
              "required": [
                "url",
                "files",
                "truncated"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pullRequest"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "unanswered",
            "not-found",
            "no-repository",
            "repository-not-reachable",
            "github-unanswered",
            "invalid-choice",
            "message-too-long",
            "agent-not-ready",
            "agent-retired",
            "plan-archived"
          ]
        }
      },
      "required": [
        "failure"
      ],
      "additionalProperties": false
    }
  ]
}
