{
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "view": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 36
                  },
                  "workspaceId": {
                    "type": "string"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "backlog",
                      "todo",
                      "in-progress",
                      "done",
                      "canceled"
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "none",
                      "urgent",
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "creator": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "userId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "userId",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "archivedAt": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "createdAt": {
                    "type": "number",
                    "minimum": 0
                  },
                  "updatedAt": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "workspaceId",
                  "number",
                  "title",
                  "description",
                  "status",
                  "priority",
                  "creator",
                  "archivedAt",
                  "createdAt",
                  "updatedAt"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "issues"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "failure": {
              "type": "string",
              "enum": [
                "unanswered",
                "not-found",
                "invalid"
              ]
            }
          },
          "required": [
            "failure"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "workspaceId",
    "view"
  ],
  "additionalProperties": false
}
