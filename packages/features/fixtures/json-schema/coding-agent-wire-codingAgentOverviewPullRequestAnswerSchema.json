{
  "type": "object",
  "properties": {
    "pullRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "number",
              "minimum": 0
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "draft",
                "merged",
                "closed"
              ]
            },
            "html": {
              "type": "string"
            },
            "base": {
              "type": "string",
              "maxLength": 255
            },
            "head": {
              "type": "string",
              "maxLength": 255
            },
            "createdAt": {
              "type": "number",
              "minimum": 0
            },
            "mergedAt": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "merge": {
              "type": "string",
              "enum": [
                "clean",
                "unstable",
                "blocked",
                "behind",
                "conflicts",
                "draft",
                "unknown"
              ]
            },
            "author": {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string"
                },
                "avatarUrl": {
                  "type": "string"
                },
                "bot": {
                  "type": "boolean"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "login",
                "bot"
              ],
              "additionalProperties": false
            },
            "writtenAs": {
              "type": "string",
              "enum": [
                "developer",
                "app-unlinked",
                "app-no-push",
                "app-automation",
                "app-unread"
              ]
            },
            "requested": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "login": {
                    "type": "string"
                  },
                  "avatarUrl": {
                    "type": "string"
                  },
                  "bot": {
                    "type": "boolean"
                  },
                  "userId": {
                    "type": "string"
                  }
                },
                "required": [
                  "login",
                  "bot"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "color": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "color"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "stack": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "number",
                    "minimum": 0
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "agent": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 36
                      },
                      "taskId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 36
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "taskId"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "number",
                  "title",
                  "url",
                  "draft"
                ],
                "additionalProperties": false
              },
              "maxItems": 30
            }
          },
          "required": [
            "number",
            "title",
            "url",
            "state",
            "html",
            "base",
            "head",
            "createdAt",
            "mergedAt",
            "merge",
            "requested"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "pullRequest"
  ],
  "additionalProperties": false
}
