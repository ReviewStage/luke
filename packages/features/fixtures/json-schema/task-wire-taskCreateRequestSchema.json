{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "linearIssueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "planning": {
      "type": "boolean"
    },
    "agent": {
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contextWindow": {
          "type": "string",
          "enum": [
            "standard",
            "long"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 16000
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "mediaType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp",
                  "application/pdf",
                  "text/plain"
                ]
              },
              "data": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "mediaType",
              "data"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "disabledServers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "required": [
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "brief": {
      "type": "string",
      "maxLength": 16000
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "todo",
        "in-progress",
        "done",
        "canceled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "none",
        "urgent",
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
