{
  "type": "object",
  "properties": {
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "member"
          ]
        },
        "github": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string"
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [
                "login",
                "active"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "memberCount": {
          "type": "number",
          "minimum": 0
        },
        "photoVersion": {
          "type": "string"
        },
        "pictureUrl": {
          "type": "string"
        },
        "personal": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "github"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "workspace"
  ],
  "additionalProperties": false
}
