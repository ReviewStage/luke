{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "number",
      "minimum": 0
    },
    "updatedAt": {
      "type": "number",
      "minimum": 0
    },
    "repository": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "openedAt": {
      "type": "number",
      "minimum": 0
    },
    "pinnedAt": {
      "type": "number",
      "minimum": 0
    },
    "archivedAt": {
      "type": "number",
      "minimum": 0
    },
    "ownerId": {
      "type": "string"
    },
    "createdBy": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name"
      ],
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0
        },
        "working": {
          "type": "number",
          "minimum": 0
        },
        "activityAt": {
          "type": "number",
          "minimum": 0
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 36
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "starting",
                  "running",
                  "completed",
                  "failed",
                  "cancelled"
                ]
              },
              "at": {
                "type": "number",
                "minimum": 0
              },
              "startedBy": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "userId",
                  "name"
                ],
                "additionalProperties": false
              },
              "automationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 36
              }
            },
            "required": [
              "id",
              "title",
              "model",
              "effort",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "pullRequestTotal": {
          "type": "number",
          "minimum": 0
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "number",
                "minimum": 0
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "draft",
                  "merged",
                  "closed"
                ]
              },
              "checks": {
                "type": "string",
                "enum": [
                  "pending",
                  "passing",
                  "failing",
                  "none"
                ]
              },
              "additions": {
                "type": "number",
                "minimum": 0
              },
              "deletions": {
                "type": "number",
                "minimum": 0
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "title",
              "state",
              "checks",
              "additions",
              "deletions"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        }
      },
      "required": [
        "total",
        "working",
        "agents",
        "pullRequestTotal",
        "pullRequests"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "workspaceId",
    "name",
    "createdAt",
    "updatedAt",
    "repository"
  ],
  "additionalProperties": false
}
