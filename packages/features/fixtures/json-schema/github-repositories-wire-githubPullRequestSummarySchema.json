      "minimum": 0
    },
    "deletions": {
      "type": "number",
      "minimum": 0
    },
    "changedFiles": {
      "type": "number",
      "minimum": 0
    },
    "openedAt": {
      "type": "number",
      "minimum": 0
    },
    "mergedAt": {
      "type": "number",
      "minimum": 0
    },
    "closedAt": {
      "type": "number",
      "minimum": 0
    },
    "baseRef": {
      "type": "string"
    },
    "headRef": {
      "type": "string"
    },
