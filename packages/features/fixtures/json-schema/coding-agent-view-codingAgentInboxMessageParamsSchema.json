{
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf",
              "text/plain"
            ]
          },
          "data": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "mediaType",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "clientKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "itemId",
    "text",
    "clientKey"
  ],
  "additionalProperties": false
}
