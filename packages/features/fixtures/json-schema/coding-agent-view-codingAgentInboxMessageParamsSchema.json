{
  "type": "object",
  "properties": {
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf",
              "text/plain"
            ]
          },
          "data": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "mediaType",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "clientKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "answers": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "reply": {
          "type": "string",
          "enum": [
            "chose",
            "approved",
            "declined",
            "answered",
            "done",
            "not-done",
            "submitted",
            "acknowledged"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1000
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "maxItems": 8
        }
      },
      "required": [
        "ask",
        "reply"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "itemId",
    "text",
    "clientKey"
  ],
  "additionalProperties": false
}
