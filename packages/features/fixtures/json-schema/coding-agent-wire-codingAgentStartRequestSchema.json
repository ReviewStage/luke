{
  "type": "object",
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contextWindow": {
      "type": "string",
      "enum": [
        "standard",
        "long"
      ]
    },
    "task": {
      "type": "string",
      "maxLength": 16000
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "application/pdf",
              "text/plain"
            ]
          },
          "data": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "mediaType",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "disabledServers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 32
    },
    "from": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        "messageSteps": {
          "type": "integer",
          "minimum": 1
        },
        "messageStepParts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "agentId"
      ],
      "additionalProperties": false
    },
    "note": {
      "type": "string",
      "maxLength": 16000
    }
  },
  "required": [
    "idempotencyKey"
  ],
  "additionalProperties": false
}
