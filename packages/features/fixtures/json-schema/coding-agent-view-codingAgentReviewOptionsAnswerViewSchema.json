              },
              "userId": {
                "type": "string"
              }
            },
            "required": [
              "login",
              "bot"
            ],
            "additionalProperties": false
          },
          "maxItems": 300
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "maxLength": 255
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 300
