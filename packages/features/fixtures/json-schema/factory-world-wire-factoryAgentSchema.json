{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "startedBy": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "name"
      ],
      "additionalProperties": false
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ]
    },
    "activityAt": {
      "type": "number",
      "minimum": 0
    },
    "pullRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "number",
              "minimum": 0
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "draft",
                "merged",
                "closed"
              ]
            },
            "checks": {
              "type": "string",
              "enum": [
                "pending",
                "passing",
                "failing",
                "none"
              ]
            },
            "additions": {
              "type": "number",
              "minimum": 0
            },
            "deletions": {
              "type": "number",
              "minimum": 0
            },
            "changedFiles": {
              "type": "number",
              "minimum": 0
            },
            "openedAt": {
              "type": "number",
              "minimum": 0
            },
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "additions": {
                    "type": "number",
                    "minimum": 0
                  },
                  "deletions": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "path",
                  "additions",
                  "deletions"
                ],
                "additionalProperties": false
              },
              "maxItems": 16
            }
          },
          "required": [
            "number",
            "title",
            "url",
            "state",
            "checks",
            "additions",
            "deletions",
            "changedFiles",
            "areas"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "taskId",
    "activityAt",
    "pullRequest"
  ],
  "additionalProperties": false
}
