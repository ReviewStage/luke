      "maxLength": 36
    },
    "document": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "maxLength": 200000
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
