            ],
            "additionalProperties": false
          },
          "maxItems": 200
        }
      },
      "required": [
        "body",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "savedAt": {
      "type": "number"
    },
    "readAt": {
      "type": "number"
    },
    "sectionEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "maxLength": 1000
          },
          "actor": {
            "type": "string",
