              "developer",
              "notetaker",
              "agent",
              "earlier"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "at": {
            "type": "number",
            "minimum": 0
          },
          "duringCall": {
            "type": "boolean"
          }
        },
        "required": [
          "section",
          "actor",
          "at",
          "duringCall"
