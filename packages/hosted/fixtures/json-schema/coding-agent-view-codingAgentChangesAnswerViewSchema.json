{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pullRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "previousPath": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "added",
                          "modified",
                          "deleted",
                          "renamed"
                        ]
                      },
                      "additions": {
                        "type": "number",
                        "minimum": 0
                      },
                      "deletions": {
                        "type": "number",
                        "minimum": 0
                      },
                      "patch": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "omitted": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "binary",
                              "too-large"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "previousPath",
                      "status",
                      "additions",
                      "deletions",
                      "patch",
                      "omitted"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 300
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "url",
                "files",
                "truncated"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pullRequest"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "unanswered",
            "not-found",
            "no-repository",
            "repository-not-reachable",
            "github-sign-in-required",
            "invalid-choice",
            "message-too-long",
            "agent-not-ready",
            "agent-retired",
            "plan-archived"
          ]
        }
      },
      "required": [
        "failure"
      ],
      "additionalProperties": false
    }
  ]
}
