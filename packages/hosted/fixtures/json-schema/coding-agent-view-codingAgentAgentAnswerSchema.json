{
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36
            },
            "planId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36
            },
            "model": {
              "type": "string"
            },
            "effort": {
              "type": "string"
            },
            "contextWindow": {
              "type": "string",
              "enum": [
                "standard",
                "long"
              ]
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "number",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "starting",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "turnId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36
                },
                {
                  "type": "null"
                }
              ]
            },
            "runStartedAt": {
              "type": "number",
              "minimum": 0
            },
            "brief": {
              "type": "string",
              "enum": [
                "plan",
                "task",
                "pull_request",
                "stack_keeper"
              ]
            },
            "archivedAt": {
              "type": "number",
              "minimum": 0
            },
            "disabledServers": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              },
              "maxItems": 32
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "role": {
              "type": "string",
              "enum": [
                "builder",
                "keeper"
              ]
            },
            "lastReport": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "pr_opened",
                    "ci_green",
                    "blocked",
                    "question",
                    "restacked",
                    "conflict",
                    "merged"
                  ]
                },
                "pullRequest": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "minItems": 1,
                  "maxItems": 6
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "text",
                "at"
              ],
              "additionalProperties": false
            },
            "published": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "number",
                  "minimum": 0
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "open",
                    "draft",
                    "merged",
                    "closed"
                  ]
                },
                "checks": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "passing",
                    "failing",
                    "none"
                  ]
                },
                "additions": {
                  "type": "number",
                  "minimum": 0
                },
                "deletions": {
                  "type": "number",
                  "minimum": 0
                },
                "changedFiles": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "number",
                "title",
                "url",
                "state",
                "checks",
                "additions",
                "deletions",
                "changedFiles"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "planId",
            "model",
            "effort",
            "title",
            "createdAt",
            "status",
            "turnId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "agent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "failure": {
          "type": "string",
          "enum": [
            "unanswered",
            "not-found",
            "no-repository",
            "repository-not-reachable",
            "invalid-choice",
            "message-too-long",
            "agent-not-ready",
            "agent-retired",
            "plan-archived"
          ]
        }
      },
      "required": [
        "failure"
      ],
      "additionalProperties": false
    }
  ]
}
